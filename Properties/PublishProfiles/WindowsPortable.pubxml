<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio「发布 → 文件夹 → Windows（便携版）」使用的发布配置文件。

  固化时间：2026-10-21（1.0.10.1）
  固化目标：把「只能运行一次 / 双击没反应」这一类故障从根上消掉。

  ★ 和 Windows.pubxml（单文件版）的唯一区别
  ==================================================================
  这里 **不打包成单文件**，产出 exe + 一堆 dll 的普通文件夹。

  为什么这一条能治病：
    单文件版每次启动都要把 3 个原生库释放到
        %TEMP%\.net\VibrantbitLauncher.Avalonia\<hash>\
          libSkiaSharp.dll     12.9 MB
          av_libglesv2.dll      5.4 MB   (ANGLE / D3D 后端)
          libHarfBuzzSharp.dll  1.8 MB
    再从那里加载。这些 dll 一旦被安全软件隔离、或被「清理 Temp」的工具删掉，
    运行时就在**任何托管代码之前**退出 —— 双击毫无反应、日志里一个字都没有。
    便携形态不解压、不写 %TEMP%，原生库就躺在 exe 旁边，这条路直接不存在。

  代价：目录约 115 MB / 256 个文件；zip 压完约 50 MB，和加密单文件差不多。
  分发建议：打包成 zip 发给对方，解压后双击 exe。别再直接发裸 exe。

  对应命令行：
      dotnet publish -c Release -r win-x64 -p:PublishSingleFile=false
  或一键脚本：
      .\publish-all.ps1 -Rids win-x64 -Portable
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>

    <!-- 单独一个输出目录：和单文件版的产物同名却完全不同布局，混在一起必出事 -->
    <PublishDir>bin\Release\net10.0\win-x64\publish-portable\</PublishDir>

    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- ★ 本文件的核心：不单文件 -->
    <PublishSingleFile>false</PublishSingleFile>

    <!--
      原生库**不**塞进 exe。单文件关掉之后这一项本来就无效，
      但显式写 false 是为了让「为什么不解压」这件事在配置里看得见。
    -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>

    <!--
      压缩只服务于「解开要花时间」的单文件。这里没有单文件，
      开着压缩只会让 SDK 报 NETSDK1169。
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!--
      仍然自包含：目标机器免装 .NET 10 运行时。
      框架依赖版在没装运行时的机器上同样表现为「双击毫无反应」，
      只是这次连解压都不用 —— 因为宿主压根找不到运行时。
    -->
    <SelfContained>true</SelfContained>

    <!-- R2R 关闭：体积优先（开 73.6MB / 关 42.6MB，同一份代码实测） -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- 不能剪裁：绑定走反射，剪裁会摘掉运行期才用的元数据（页面白板但不报错） -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Release 不带符号 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- 只保留英文卫星资源 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 关掉 apphost 的 CET 兼容标记（Win10 上 0x80131506 的直接原因），理由见 Windows.pubxml -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>
</Project>
