<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 剪裁档：单文件 29.04 MB（标准档 52.29 MB），体积砍掉 44%。

  建立时间：2026-10-21（1.0.10.2）
  实测结论（win-x64，每次都用启动到主界面 SHOWN 验证过）：

    单文件 + 压缩 + 不剪裁   52.29 MB   ✅  ← Windows.pubxml
    单文件 + 压缩 + 剪裁     29.04 MB   ✅  ← 本文件
    单文件 + 不压缩 + 剪裁   55.10 MB   ✅  （比标准档还大，无意义）
    目录形态 + 剪裁          55.80 MB   ✅
    单文件 + 压缩 + 剪裁     28.03 MB   ❌ XamlLoadException  ← 见下方踩坑记录

  ⚠️⚠️ 踩坑记录：这个文件**只能设 EnableAppTrimming 一个开关**
  ==================================================================
  第一版我把 PublishTrimmed / TrimMode / TrimmerRootAssembly 也重复写在这里，
  同时 csproj 里也有同名配置，结果产出 28.03MB 的 exe 一启动就崩：

      Avalonia.Markup.Xaml.XamlLoadException:
      No precompiled XAML found for VibrantbitLauncher.App,
      make sure to specify x:Class and include your XAML file as AvaloniaResource

  排查路径（留档，别再走一遍）：
    · 目录形态 + 剪裁                          → 正常，剪裁本身没问题；
    · 单文件 + 剪裁 + 不压缩                   → 正常，单文件打包也没问题；
    · 单文件 + 剪裁 + 压缩（只留一个开关）      → 正常，29.04MB。
  也就是说：崩溃与「压缩」无关，纯粹是**同一份剪裁配置被两处各写一遍**
  导致 TrimMode / root 列表叠加异常。

  ★ 结论：剪裁属性和 TrimmerRootAssembly 只在 csproj 里维护
    （见 VibrantbitLauncher.Avalonia.csproj 的「程序集剪裁」段），
    本文件与 publish-all.ps1 都只传 -p:EnableAppTrimming=true。
    要调剪裁参数请去 csproj，别在这里加第二条。

  验收清单（AI 无法替你跑 GUI，发布前请逐项确认）
  ==================================================================
  □ 冷启动到主界面（窗口不能是透明/空白）
  □ 启动页快捷设置：Minecraft 文件夹、Java 下拉、亮/暗主题切换
  □ 实例列表逐项飞入动画
  □ 设置页读写后重启，配置仍在（验证 JSON 反射序列化）
  □ 账号页登录 / 皮肤页换肤
  □ 下载页实际下一份资源
  □ 新建 Forge 实例并「补全资源」
  □ 拖放文件 / 文件选择对话框（走 COM，剪裁对 BuiltInComInteropSupport 有
    IL2026 警告，是本档最可能出问题的一处）

  任何一项异常，就回退到 Windows.pubxml（标准档，52.29MB，零剪裁风险）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0\win-x64\publish-trimmed\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>

    <!-- 必须带 RID，否则输出目录少一层 win-x64（见 Windows.pubxml 的说明） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- R2R 关闭：剪裁档已经很小，没必要为冷启动再翻一倍 -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!--
      ★ 剪裁开关（两个都要写，原因见下方「踩坑记录」）：
        EnableAppTrimming  —— 给 csproj 的条件块用；但 pubxml 是 csproj 求值
                              之后才 Import 的，条件块看不到它，所以单独写它没用。
        PublishTrimmed / TrimMode —— 属性后写覆盖先写，这两个才是真正生效的。
      TrimmerRootAssembly 的列表在 csproj 里（无 Condition），本文件不要重复声明，
      重复声明正是 28.03MB 那版崩溃的直接原因。
    -->
    <EnableAppTrimming>true</EnableAppTrimming>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <CetCompat>false</CetCompat>
  </PropertyGroup>
</Project>
