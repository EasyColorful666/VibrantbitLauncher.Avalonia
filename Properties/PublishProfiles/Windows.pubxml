<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      PublishReadyToRun 关闭（2026-10-06，1.0.5.13）。
      它会把 IL 预编译成本地代码塞进单文件，冷启动快一点，但体积暴涨：
        开 73.6MB · 关 42.6MB（同一份代码实测，差额约 31MB）
      本项目更在意分发体积，所以关掉；若哪天更在意冷启动速度，把它改回 true 即可。
    -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- 单文件压缩只在独立部署下可用（框架依赖会报 NETSDK1176），
         实测独立部署+压缩反而更大（53MB vs 42.6MB），因此保持框架依赖、不压缩。 -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
