<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio「发布 → 文件夹 → Windows」使用的发布配置文件。

  这里的取值 = 唯一一份经实测可用的 Windows 分发参数，改动前先读完下面每段注释。

  固化时间：2026-10-21（1.0.10.1）
  固化目标：VS 里点一次「发布」，得到的产物就等于手工发布的那份自包含单文件 exe。

  ⚠️ 单文件形态的已知代价（2026-10-21 用户实测反馈）
  ==================================================================
  单文件 + 压缩 = 每次启动都要把 3 个原生库释放到
      %TEMP%\.net\VibrantbitLauncher.Avalonia\<hash>\
        libSkiaSharp.dll     12.9 MB
        av_libglesv2.dll      5.4 MB   (ANGLE / D3D 后端)
        libHarfBuzzSharp.dll  1.8 MB
  再从那里加载。这些 dll 一旦被安全软件隔离、或被「清理 Temp」的工具删掉，
  运行时就在**任何托管代码之前**退出 —— 用户看到的是「双击毫无反应」，
  磁盘上连一行日志都没有（StartupFailureReporter 根本没机会运行）。

  已经在软件层做了三重兜底（详见 Program.cs / StartupTrace.cs / WindowMotion.cs）：
    · 启动轨迹 startup-trace.log（%LOCALAPPDATA%），区分「宿主没起来」和「界面没出来」；
    · 连续启动失败自动改用软件渲染（规避 ANGLE 在老显卡上崩）；
    · 关窗动画带 700ms 硬超时，防止僵尸进程锁住解压目录。

  但**根治只能靠不解析压**。怀疑目标机器「只能运行一次」时，改用配套的
      WindowsPortable.pubxml（便携目录形态，完全不写 %TEMP%）
  或命令行：  dotnet publish -p:PublishSingleFile=false
  分发时建议优先给便携版，单文件版留给「必须一个文件」的场景。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>

    <!--
      ⚠️ 必须带 RID。不带的时候输出目录会悄悄变成
      bin/Release/net10.0/publish/（少一层 win-x64），
      于是「发布成功但跑起来还是旧 exe」这种假象会反复出现。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      ★ 自包含：产物内含 .NET 10 运行时，目标机器什么都不用装，双击即开。

      为什么固化在这里而不是保持框架依赖（2026-10-19 的教训）：
        框架依赖版在没装 .NET 10 Desktop Runtime 的机器上双击**毫无反应**，
        既不报错也不写日志（宿主在托管代码之前就退出了），排查成本极高。
        分发给普通玩家的包不能让对方先去装 60MB 运行时，所以默认自包含。
    -->
    <SelfContained>true</SelfContained>

    <!-- 单文件：整个应用（含运行时）打进一个 exe -->
    <PublishSingleFile>true</PublishSingleFile>

    <!--
      原生库也塞进单文件（SkiaSharp / HarfBuzz / ANGLE 等）。
      ⚠️ 这一项就是「解压到 %TEMP%」的直接原因：不开它，原生库会散落在
      exe 旁边（那其实就是便携形态）；开了它，每次启动都得先释放一遍。
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      单文件压缩：自包含 + 压缩实测 113MB → 55MB（约 51%）。
      代价是每次启动都要走解压路径（压缩项无法直接映射进内存），
      而在被安全软件盯上的机器上，这条路径本身就是故障源。
      只有自包含才允许开（框架依赖会报 NETSDK1176）；
      csproj 里这一项的条件还额外要求 PublishSingleFile=true，否则报 NETSDK1169。
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!--
      R2R 关闭。它把 IL 预编译成本地代码，冷启动快一点，但体积暴涨：
        开 73.6MB · 关 42.6MB（同一份代码实测，差额约 31MB）
      本项目更在意分发体积；若哪天更在意冷启动速度，改回 true 即可。
    -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!--
      不能剪裁。本项目绑定走反射（AvaloniaUseCompiledBindingsByDefault=false），
      剪裁会摘掉运行期才用到的属性元数据，症状是「页面白板但编译不报错」。
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Release 不带符号：embedded 会把 PDB 塞回 exe，单文件里白多几 MB -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- 只保留英文卫星资源：其余 12 套 *.resources.dll 不再落地（界面文案硬编码在 XAML 里） -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      ⚠️ 关掉 apphost 的 CET（Intel 影子栈）兼容标记，否则部分机器直接起不来。

      症状（2026-10-19，Win10 22H2 虚拟机实测）：
        双击无反应、零日志，事件查看器里是 KERNELBASE.dll + 0x80131506；
        终端里手动跑才看得到真正原因：
          Fatal error. Your Windows doesn't fully support CET.
          Please install all available Windows updates.
      崩溃发生在任何托管代码之前，所以进程内的日志兜底也拦不到。

      代价是放弃影子栈这一项硬件缓解措施；对本项目（离线启动器、无不受信输入）
      来说，能启动远比这项缓解重要。系统装齐更新后可删掉本行恢复。
    -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>
</Project>
