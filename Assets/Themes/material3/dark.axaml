<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Material Design 3 · 暗色：surface 是近黑的紫灰，卡片比它亮一档  -->

    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FF141218" />
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#FF211F26" />
    <SolidColorBrush x:Key="SurfaceGlassStrongBrush" Color="#FF2B2930" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FF211F26" />
    <SolidColorBrush x:Key="SurfaceCardSoftBrush" Color="#FF1D1B20" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FF2B2930" />

    <SolidColorBrush x:Key="HairlineBrush" Color="#3349454F" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#FF49454F" />
    <SolidColorBrush x:Key="CardTopSheenBrush" Color="#00FFFFFF" />

    <SolidColorBrush x:Key="AuroraOneBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraTwoBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraThreeBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraColdBlobBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraWarmBlobBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraCoolBlobBrush" Color="#00000000" />

    <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000" />

    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FF141218" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF141218" />
    <SolidColorBrush x:Key="AppDropPanelBrush" Color="#FF211F26" />

    <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#FF4F378B" />
    <SolidColorBrush x:Key="AppAccentSurfaceStrongBrush" Color="#FF6750A4" />

    <!--  ==================== 语义色板（Fluent 键）  ====================  -->

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE6E0E9" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFCAC4D0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF938F99" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF49454F" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF211F26" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF2B2930" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF211F26" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF2B2930" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF2B2930" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF36343B" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF2B2930" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FF1D1B20" />

    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF36343B" />

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF938F99" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF49454F" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF49454F" />

</ResourceDictionary>
