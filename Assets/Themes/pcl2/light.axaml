<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PCL2 风格 · 亮色

        ★ 这个文件就是「主题」本身：底色、层次、文字、描边、控件填充全在这里。★
        布局（导航并进顶栏、居中排列）只是 theme.json 里一行 navigation 的附带效果，
        把这个文件删掉、只留布局，就不该叫主题包了。

        PCL2 的视觉是「工具」而不是「产品」：
          · 浅灰画布（#F2F2F2）上铺白色区块，区块之间靠 1px 灰线分开；
          · 没有阴影、没有背景光斑、没有半透明玻璃 —— 一层就是一层；
          · 正文是深灰而不是纯黑，次要信息明显更浅（层级靠灰阶，不靠字号）。
    -->

    <!--  ==================== 画布与层次（自有键）  ====================  -->

    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="SurfaceGlassStrongBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceCardSoftBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FFEDEDED" />

    <!--  PCL2 的线是看得见的：它是「框」，不是「分」  -->
    <SolidColorBrush x:Key="HairlineBrush" Color="#FFD0D0D0" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="CardTopSheenBrush" Color="#00FFFFFF" />

    <!--  没有极光：六个键全部透明，底层只剩纯色画布  -->
    <SolidColorBrush x:Key="AuroraOneBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraTwoBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraThreeBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraColdBlobBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraWarmBlobBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraCoolBlobBrush" Color="#00000000" />

    <SolidColorBrush x:Key="ScrimBrush" Color="#66101010" />

    <!--  ==================== 窗口底  ====================  -->

    <!--  这两个键由 SettingsService.ApplyTheme 手写，主题必须后写一次才生效  -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="AppDropPanelBrush" Color="#FFFFFFFF" />

    <!--  强调色浅底是实心浅蓝块，不是半透明色  -->
    <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#FFE3F1FF" />
    <SolidColorBrush x:Key="AppAccentSurfaceStrongBrush" Color="#FFC9E3FF" />

    <!--  ==================== 语义色板（Fluent 键）  ====================
         界面里大量位置直接用 FluentAvalonia 的语义键（卡片、文字、填充、描边）。
         只改自有键的话，那些位置会留在默认 Fluent 观感上 —— 这正是上一版
         「只有顶栏变了」的原因。这里一并压平。
    -->

    <!--  文字：深灰正文 + 明显更浅的次要信息  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF5C5C5C" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FFB0B0B0" />

    <!--  卡片底：纯白，次一档是浅灰（列表 / 分组内层）  -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFF7F7F7" />

    <!--  浮层 / 下拉 / 弹窗：还是白，靠描边定形而不是阴影  -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFF8F8F8" />

    <!--  控件填充：按钮与输入框统一白底，悬停才浅灰  -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF6F6F6" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FFF3F3F3" />

    <!--  轻微底纹（列表悬停 / 图标按钮）  -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#14000000" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FFF0F0F0" />

    <!--  描边：所有控件都有 1px 可见边框，颜色比底色深一档  -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FFE2E2E2" />

    <!--  ==================== 顶栏  ====================  -->

    <!--
        顶栏：整条蓝色，中间比两端略亮（一抹横向渐变），
        导航项居中，选中项是一块白色胶囊 + 蓝字。
        颜色取自 PCL2 的蓝（两端 #106CC8、正中 #1378DD）。
    -->
    <LinearGradientBrush x:Key="AppHeaderBarBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#FF106CC8" />
        <GradientStop Offset="0.5" Color="#FF1378DD" />
        <GradientStop Offset="1" Color="#FF106CC8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppHeaderBarForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppHeaderBarHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderBarPressedBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="AppHeaderNavSelectedBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppHeaderNavSelectedForegroundBrush" Color="#FF116DC9" />

</ResourceDictionary>
