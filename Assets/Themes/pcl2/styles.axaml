<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

    <!--
        PCL2 风格 · 控件外观

        颜色已经由 light/dark 里的语义键（ControlFillColor* / CardBackground* /
        TextFillColor* / ControlStrokeColor*）带动了，这里只做语义键管不到的部分：
        几何（直角、高度、内边距）、状态色（选中、悬停）、以及 Fluent 在自己的
        模板里写死的东西。
    -->

    <!--  ==================== 卡片 / 面板  ====================  -->

    <!--  卡片：方块 + 1px 可见描边，不再浮起来  -->
    <Style Selector="Border.card">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.hoverCard">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.glass">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.sunken">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.accentBanner">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>

    <!--  页标题下那根短横：PCL2 是 3px 的粗线，不是 2px 的细条  -->
    <Style Selector="Border.accentRule">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="3" />
    </Style>

    <!--  ==================== 按钮  ====================  -->

    <!--  几何：矮、方、内边距收紧就是 PCL2 的按钮手感  -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!--
        强调按钮：蓝底白字。
        只指定底色和字色，悬停/按下的加深交给 Fluent 自己按强调色派生 ——
        硬写一个「深一点的蓝」在用户换掉强调色之后就会变成脏色。
    -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  Fluent 的悬停态画在模板里的 ContentPresenter 上，这里要再压一次圆角，
         否则一堆方按钮里只有鼠标划过的那一个是圆的  -->
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <!--  次要按钮（无 accent 类）：白底 + 1px 灰框，颜色由 ControlFillColor*/ControlStroke* 带动  -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  ==================== 输入控件  ====================  -->

    <!--  1px 凹框是 PCL2 的输入区语言：白底、灰框、方角  -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="AutoCompleteBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  ==================== 列表 / 导航  ====================  -->

    <Style Selector="ListBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--
        选中态：整行浅蓝 + 蓝字。PCL2 的选中是「区块变色」，
        不是 Fluent 那种「左侧竖条 + 圆角胶囊」。
    -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceStrongBrush}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  左侧导航（非顶栏那套）跟着一起方  -->
    <Style Selector="ui|FANavigationViewItem">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  ==================== 标签页  ====================  -->

    <Style Selector="TabControl">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <Style Selector="ui|FATabViewItem">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  ==================== 其它 Fluent 控件  ====================  -->

    <!--  设置页的「一栏一事」：方角，和卡片对齐  -->
    <Style Selector="ui|FASettingsExpander">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ui|FAInfoBar">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  进度条：方头，没有圆角胶囊  -->
    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  ==================== 顶栏导航项  ====================
         这一排是启动器按主题画出来的（不是 FANavigationView 的目录项），
         class 名为 headerNav，选中加 selected。几何在 Styles/TitleBar.axaml，
         这里只补 PCL2 特有的字重与内边距。
    -->

    <Style Selector="Button.headerNav">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="Button.headerNav.selected">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</Styles>
