<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PCL2 风格 · 暗色

        和亮色是同一套结构，只把灰阶反过来：画布最深、卡片比画布亮一档、
        描边再亮一档。PCL2 的暗色是「深灰工具箱」，不是纯黑，
        所以最底一层落在 #202020 而不是 #000000。
    -->

    <!--  ==================== 画布与层次（自有键）  ====================  -->

    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#FF272727" />
    <SolidColorBrush x:Key="SurfaceGlassStrongBrush" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="SurfaceCardSoftBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FF191919" />

    <SolidColorBrush x:Key="HairlineBrush" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#FF525252" />
    <SolidColorBrush x:Key="CardTopSheenBrush" Color="#00FFFFFF" />

    <SolidColorBrush x:Key="AuroraOneBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraTwoBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraThreeBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraColdBlobBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraWarmBlobBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AuroraCoolBlobBrush" Color="#00000000" />

    <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000" />

    <!--  ==================== 窗口底  ====================  -->

    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="AppDropPanelBrush" Color="#FF2B2B2B" />

    <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#FF1B3A5B" />
    <SolidColorBrush x:Key="AppAccentSurfaceStrongBrush" Color="#FF24507A" />

    <!--  ==================== 语义色板（Fluent 键）  ====================  -->

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA8A8A8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7C7C7C" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF5E5E5E" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF262626" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF292929" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FF272727" />

    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF2A2A2A" />

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF474747" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF333333" />

    <!--  ==================== 顶栏  ====================  -->

    <!--  同一套结构压暗一档，亮蓝在暗底上会刺眼  -->
    <LinearGradientBrush x:Key="AppHeaderBarBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#FF0B4F94" />
        <GradientStop Offset="0.5" Color="#FF0D5CA8" />
        <GradientStop Offset="1" Color="#FF0B4F94" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppHeaderBarForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppHeaderBarHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderBarPressedBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="AppHeaderNavSelectedBrush" Color="#FFF2F7FC" />
    <SolidColorBrush x:Key="AppHeaderNavSelectedForegroundBrush" Color="#FF0E62B4" />

</ResourceDictionary>
