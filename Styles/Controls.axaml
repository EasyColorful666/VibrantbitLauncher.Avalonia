<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

    <!--
        ============================================================================
        控件层 · 明亮清爽
        ============================================================================

        本文件只负责「长什么样」；动效全部在 Animations.axaml
        （一个属性只有一处 Transitions 设置，避免两个文件抢同一个属性）。

        设计约束（改之前先读）：
          · 圆角只有 6 / 10 / 16 / 胶囊 四档，不得新增；
          · 字号只取 AppTheme 里那 5 档，不得写裸数字；
          · 细线恒为 1px，只用来圈住可交互实体，不做装饰；
          · 卡片**没有投影**。层次靠描边和留白，这是本语言最硬的一条规则；
          · 强调色只出现在主操作、当前选中项、极少数图标，面积 < 8%。

        控件外观一律走 FluentAvalonia 的语义键，明暗由 SettingsService 统一支配，
        这里不出现任何硬编码品牌色。
    -->

    <!--  ==================== 1. 文本  ====================  -->

    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!--  大字必须收字距：字号越大，默认字距在眼里越"散"  -->
        <Setter Property="LetterSpacing" Value="-0.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  分区标题：16px SemiBold。再大就会和页标题争视觉重心  -->
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <!--  小字必须放字距，否则一坨黑  -->
        <Setter Property="LetterSpacing" Value="0.1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        眉标（eyebrow）：页标题上方的一行极小字，交代"这是哪一区"。
        新语言里它**不再是强调色**——主色留给真正的操作，
        眉标退成三级灰 + 宽字距，只做一个安静的注脚。
    -->
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.6" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  数字：等宽，避免进度百分比跳动时左右抖  -->
    <Style Selector="TextBlock.number">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!--  ==================== 2. 按钮  ====================

        明亮清爽的按钮只有两种形态：
          次级 —— 白底 + 1px 浅描边（不是 Fluent 默认的灰底，灰底会显脏）
          主操 —— 实心强调色 + 白字
        没有渐变、没有投影。按下的反馈靠底色加深，不靠位移或缩放。
    -->

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  模板内的底色会被 ControlTheme 覆盖，这里显式写回三条状态  -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceCanvasSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    </Style>

    <!--  主操作：实心强调色 + 白字  -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!--  悬停 / 按下：只让底色深一档，白字不动  -->
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
    </Style>

    <!--  危险按钮：只染前景和描边，不染底色 —— 别引导用户去点  -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    </Style>

    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCriticalBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppCriticalSurfaceBrush}" />
    </Style>

    <!--  低权重按钮：无底无边，只靠悬停底色表达可点  -->
    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Button.subtle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceCanvasSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!--  胶囊按钮：只给"一次性的强调操作"，不要满页面撒  -->
    <Style Selector="Button.pill">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="20,7" />
    </Style>

    <!--  ==================== 3. 容器  ====================

        卡片 = 白底 + 1px 浅描边 + 10px 圆角。**没有投影**。
        投影在深色界面里负责"浮起"，在纯白界面里只会变成一圈脏边。
        唯一带投影的是浮层（glass / 弹卡），因为它真的叠在别的内容之上。
    -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    </Style>

    <!--  可点卡片：默认与普通卡片一致，悬停时才浮起一层极淡的描边加深  -->
    <Style Selector="Border.hoverCard">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--  浮层：真正叠在内容之上，这里才允许有投影  -->
    <Style Selector="Border.glass">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="BoxShadow" Value="0 12 32 0 #14000000" />
    </Style>

    <!--  下沉面：输入区 / 列表底 / 代码块  -->
    <Style Selector="Border.sunken">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    </Style>

    <!--  强调色短横：新语言里不再用于页头，保留给卡片内的分组标记  -->
    <Style Selector="Border.accentRule">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!--  强调横幅：只有下载完成 / 首次引导这类"值得庆祝"的时刻才用  -->
    <Style Selector="Border.accentBanner">
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!--  ==================== 4. 输入控件  ====================

        输入框是"可写的面"，所以它比卡片**低**一档：
        下沉底色 + 无描边（聚焦时才出现强调色描边）。
        这跟按钮正好相反 —— 按钮是"可以按的"，需要描边定义边界。
    -->

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <!--  ==================== 5. 列表 / 导航  ====================  -->

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <!--
        导航项：常驻文字侧栏，行高比默认更松（40px），
        选中态用浅灰底而不是强调色块 —— 侧栏是"位置指示"，不是"操作"。
    -->
    <Style Selector="ui|FANavigationViewItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="Margin" Value="8,1" />
    </Style>

    <!--  ==================== 6. FluentAvalonia 专属控件  ====================  -->

    <Style Selector="ui|FASettingsExpander">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    </Style>

    <Style Selector="ui|FASettingsExpanderItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="ui|FAInfoBar">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="ui|FATabViewItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="Expander">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!--  ==================== 7. 滚动条  ====================  -->

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8" />
    </Style>

    <!--  ==================== 8. 页面骨架  ====================  -->

    <Style Selector="Grid.page">
        <Setter Property="Margin" Value="{StaticResource PagePadding}" />
        <Setter Property="RowSpacing" Value="0" />
    </Style>

</Styles>
