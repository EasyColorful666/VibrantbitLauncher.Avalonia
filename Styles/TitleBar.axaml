<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:VibrantbitLauncher.Controls">

    <!--
        ============================================================
        自定义标题栏 · 明亮清爽
        ============================================================

        这一版把它做成「一条极安静的横带」：

          · 背景与画布同色，**没有下边框、没有分隔线** ——
            标题栏和内容连成一整块白，而不是被切成两段；
          · 标题 13px 常规字重、压到次级灰：
            窗口标题是"身份标识"，不是"页面标题"，不该跟页头抢注意力；
          · 系统按钮压到 40px 宽，比 Windows 原生的 46 窄一点，
            悬停高亮是浅灰圆角块而不是通栏色条 —— 原生那条大红/深灰块
            在纯白界面上太突兀。

        这里用「应用级 Style + Template」而不是 ControlTheme：
        应用级样式里可以用普通的后代选择器直接命中模板里的命名部件，
        省掉 ControlTheme 作用域下 `^ /template/` 的层级坑（踩过）。

        配色全部走本工程的标题栏资源键，明暗自动适配；
        只有「关闭按钮悬停红」是国内 Windows 约定的固定色，直接写死。
    -->

    <Style Selector="ctrl|TitleBar">
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource AppHeaderBarBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppHeaderBarForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <ControlTemplate>
                <!--
                    PART_Root 标了 ElementRole="TitleBar"：平台把它当非客户区，
                    拖窗 / 双击最大化 / 右键系统菜单 / Aero Snap 全由系统接管。
                    里面的按钮与内容区反过来标成 "User"，
                    否则会被非客户区命中测试吞掉（按钮点不动）。
                -->
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        WindowDecorationProperties.ElementRole="TitleBar">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!--  应用图标 + 标题：图标没设时整块隐藏（不占位）  -->
                        <StackPanel Grid.Column="0"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="9">
                            <Image Name="PART_Icon"
                                   Width="16"
                                   Height="16"
                                   VerticalAlignment="Center"
                                   IsVisible="False"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Name="PART_Title" Text="{TemplateBinding Title}" />
                                <TextBlock Name="PART_Subtitle" Text="{TemplateBinding Subtitle}" IsVisible="False" />
                            </StackPanel>
                        </StackPanel>

                        <!--  自定义内容区（搜索框 / 面包屑），默认空  -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          WindowDecorationProperties.ElementRole="User" />

                        <!--  系统按钮：紧凑、圆角、不占满高度  -->
                        <StackPanel Grid.Column="2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                            <Button Name="PART_MinimizeButton"
                                    Classes="captionButton"
                                    ToolTip.Tip="最小化"
                                    WindowDecorationProperties.ElementRole="User">
                                <Path Classes="captionGlyph" Data="M 0.5,4.5 H 9.5" />
                            </Button>

                            <Button Name="PART_MaximizeButton"
                                    Classes="captionButton"
                                    ToolTip.Tip="最大化"
                                    WindowDecorationProperties.ElementRole="User">
                                <Panel>
                                    <Path Name="PART_MaximizeGlyph"
                                          Classes="captionGlyph"
                                          Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                                    <Path Name="PART_RestoreGlyph"
                                          Classes="captionGlyph"
                                          Data="M 2.5,0.5 H 9.5 V 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z"
                                          IsVisible="False" />
                                </Panel>
                            </Button>

                            <Button Name="PART_CloseButton"
                                    Classes="captionButton captionClose"
                                    ToolTip.Tip="关闭"
                                    WindowDecorationProperties.ElementRole="User">
                                <Path Classes="captionGlyph" Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ctrl|TitleBar TextBlock">
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--  标题：次级灰 + 常规字重。它是身份标识，不是页面标题  -->
    <Style Selector="ctrl|TitleBar TextBlock#PART_Title">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  副标题：小一号 + 压暗，默认隐藏（没设 Subtitle 时不占位）  -->
    <Style Selector="ctrl|TitleBar TextBlock#PART_Subtitle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="ctrl|TitleBar Image#PART_Icon">
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--  ==================== 系统按钮  ====================  -->

    <Style Selector="ctrl|TitleBar Button.captionButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ctrl|TitleBar Button.captionButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
    </Style>

    <Style Selector="ctrl|TitleBar Button.captionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppHeaderBarHoverBrush}" />
    </Style>

    <Style Selector="ctrl|TitleBar Button.captionButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppHeaderBarPressedBrush}" />
    </Style>

    <!--  关闭按钮：悬停 / 按下用 Windows 约定的红底白字  -->
    <Style Selector="ctrl|TitleBar Button.captionClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" />
    </Style>

    <Style Selector="ctrl|TitleBar Button.captionClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#B0241A" />
    </Style>

    <Style Selector="ctrl|TitleBar Button.captionClose:pointerover Path.captionGlyph">
        <Setter Property="Stroke" Value="#FFFFFFFF" />
    </Style>

    <Style Selector="ctrl|TitleBar Button.captionClose:pressed Path.captionGlyph">
        <Setter Property="Stroke" Value="#B0FFFFFF" />
    </Style>

    <!--  按钮字形：1px 描边几何，不依赖任何系统图标字体（跨平台一致）  -->
    <Style Selector="ctrl|TitleBar Path.captionGlyph">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeLineCap" Value="Square" />
        <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  不可用的最大化按钮：跟着文字色淡出，而不是换成一套灰  -->
    <Style Selector="ctrl|TitleBar Button.captionButton:disabled Path.captionGlyph">
        <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Opacity" Value="0.35" />
    </Style>

</Styles>
