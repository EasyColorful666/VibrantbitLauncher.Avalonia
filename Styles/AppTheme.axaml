<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!--
        VibrantbitLauncher 全局视觉规范（Avalonia 版）

        颜色使用 FluentAvalonia 的语义化画刷键（TextFillColor* / CardBackground* 等），
        以便 Light / Dark 主题自动适配，不要再硬编码 #RRGGBB。
        间距走 4 的倍数，页面内容统一用 PagePadding。
    -->

    <!--  ==================== 语义色  ====================  -->

    <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF10893E" />
    <SolidColorBrush x:Key="AppCriticalBrush" Color="#FFD13438" />
    <SolidColorBrush x:Key="AppCautionBrush" Color="#FFCC8800" />

    <!--
        愚人节版本的类型标识色（下载页筛选圆点用）。

        只有 6px 的面积，所以取一个**亮而低饱和**的紫：浅色主题下能看清，
        深色主题下也不刺眼。这是全工程唯一用到紫色系的地方 ——
        它标记的是「梗版本」这个一次性的语义，不参与常规配色。
    -->
    <SolidColorBrush x:Key="AppAprilFoolsBrush" Color="#FFB146C2" />
    <SolidColorBrush x:Key="AppCriticalSurfaceBrush" Color="#FFD13438" Opacity="0.12" />
    <SolidColorBrush x:Key="AppCautionSurfaceBrush" Color="#FFCC8800" Opacity="0.14" />
    <SolidColorBrush x:Key="AppSuccessSurfaceBrush" Color="#FF10893E" Opacity="0.12" />
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AppOnImageTextBrush" Color="#FFFFFFFF" />

    <!--
        ApplicationBackgroundBrush：所有窗口（含二级窗口）的整窗底色。

        ⚠️ 它是**一次性定义 + 运行时手写**的键，不随主题变体自动换色 ——
        正因如此，主题变体和这个手写值必须始终同步：唯一写入口是
        <see cref="VibrantbitLauncher.Services.SettingsService.ApplyTheme"/>，
        而它现在保证「先关掉 FluentAvalonia 的跟随系统，最后才切变体」，
        两边不会再各走各的（1.0.7.14 之前会出现「浅色底 + 浅色字」的整窗发白）。

        ⚠️ 别改成 FluentAvalonia 的 SolidBackgroundFillColorBase：那是 **Color** 资源，
        赋给 IBrush 类型的 Background 会因类型不匹配静默失效 → 窗口无背景 → 白屏。
    -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFF3F3F3" />

    <!--  主题色渐变，运行时由 SettingsService.ApplyAccent() 覆盖  -->
    <LinearGradientBrush x:Key="AppAccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FF0078D4" />
        <GradientStop Offset="1" Color="#FF00B7C3" />
    </LinearGradientBrush>

    <!--  背景图遮罩  -->
    <SolidColorBrush x:Key="AppBackgroundScrimBrush" Color="#80FFFFFF" />

    <!--
        强调色浅底（图标块 / 计数徽标 / 选中卡片底板）。

        这里只是启动早期的兜底值，真实值由 SettingsService.ApplyAccentCore 在运行时
        按当前主题色覆写成「主色 + 12% / 20% 透明度」。页面里请用这两个键，
        不要硬编码 #1F0078D4 之类的值 —— 换主题色时硬编码不会跟着变。
    -->
    <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#1F0078D4" />
    <SolidColorBrush x:Key="AppAccentSurfaceStrongBrush" Color="#330078D4" />

    <!--
        强调色光晕：主色向外衰减到全透明。
        只给"全应用唯一的主角"用（启动页的主按钮），页面里别处不要引用 ——
        一旦光晕出现两次，主角就不成立了。
    -->
    <RadialGradientBrush x:Key="AppAccentHaloBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
        <GradientStop Offset="0" Color="#8C0078D4" />
        <GradientStop Offset="1" Color="#000078D4" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="AppAccentHairlineBrush" Color="#730078D4" />

    <!--  拖入整合包时的整窗提示层：半透明压暗 + 内嵌面板跟随主题  -->
    <SolidColorBrush x:Key="AppDropOverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="AppDropPanelBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF0078D4" />

    <!--  ==================== 字体  ====================  -->

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="AppDisplayFont">avares://VibrantbitLauncher.Avalonia/Assets#HarmonyOS Sans Black</FontFamily>

    <!--  ==================== 字号阶梯（严格 5 档）  ====================

        32 / 22 / 17 / 14 / 12 —— 相邻级差 1.45x ~ 1.45x，是"看得见的台阶"。
        再多一档就会变成"随便调了几次大小"，层级立刻塌掉。

        FontSizeHero / FontSizeBodyLarge 是历史别名，值并入相邻档位，
        老页面引用这两个键不会挂，但视觉上不再多出第 6、第 7 档。
    -->

    <x:Double x:Key="FontSizeDisplay">32</x:Double>
    <x:Double x:Key="FontSizeHero">22</x:Double>
    <x:Double x:Key="FontSizeTitle">22</x:Double>
    <x:Double x:Key="FontSizeSubtitle">17</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">14</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>

    <!--  行高：跟字号成对出现，正文 1.55 倍行距是中文长文本的舒适区  -->
    <x:Double x:Key="LineHeightDisplay">42</x:Double>
    <x:Double x:Key="LineHeightSubtitle">26</x:Double>
    <x:Double x:Key="LineHeightBody">22</x:Double>

    <!--
        图标尺寸单独一套，不参与文字阶梯。
        图标是"形状"，它的视觉重量取决于笔画占比，和文字的字号没有可比性。
    -->
    <x:Double x:Key="IconSizeCaption">12</x:Double>
    <x:Double x:Key="IconSizeBody">16</x:Double>
    <x:Double x:Key="IconSizeLarge">24</x:Double>
    <x:Double x:Key="IconSizeDisplay">32</x:Double>
    <x:Double x:Key="IconSizeHero">44</x:Double>
    <x:Double x:Key="IconSizeJumbo">64</x:Double>

    <!--  ==================== 间距  ====================  -->

    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="SpaceXXL">32</x:Double>

    <Thickness x:Key="PagePadding">32,28,32,32</Thickness>
    <Thickness x:Key="PageHeaderMargin">0,0,0,24</Thickness>
    <Thickness x:Key="CardGap">0,0,16,16</Thickness>

    <!--  ==================== 圆角（严格 4 档）  ====================

        4  控件（按钮 / 输入框 / 标签）
        8  卡片
        12 面板（浮层 / 大块容器）
        ∞  胶囊（只在"一次性的强调控件"上用：启动按钮 / 分段选择 / 计数徽标）

        圆角越大越"圆润"，但大面积 12 会显得软塌；所以 12 只给浮层这类
        "临时浮起来的东西"，日常卡片恒为 8。
    -->

    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>

</ResourceDictionary>
