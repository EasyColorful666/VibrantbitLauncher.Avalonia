<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!--
        ============================================================================
        VibrantbitLauncher 视觉规范 · 明亮清爽（Light & Airy）
        ============================================================================

        设计取向只有三个词：**白、留白、克制**。

        整个界面靠三样东西建立层级，不靠颜色、不靠阴影、不靠渐变：
          1. 留白   —— 区块之间用 24~32px 的空，而不是分割线或色块；
          2. 细线   —— 1px 极浅描边，只用来「圈住」可交互的实体，不用来装饰；
          3. 字重   —— 同一档字号靠 SemiBold / Normal / 三级灰拉开远近。

        因此本文件里**没有**渐变、没有强色块。风格化留给用户在设置里开的强调色，
        强调色只出现在三处：主按钮实心底、当前选中项、极少数图标。

        ⚠️ 颜色一律走 FluentAvalonia 的语义键（TextFillColor* / CardBackground*），
        随明暗自动适配，不要在这里硬编码 #RRGGBB 去做正文色。
        只有品牌语义色（成功 / 危险 / 警告 / 强调）才自己定义。
    -->

    <!--  ==================== 语义色  ====================  -->

    <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF14804A" />
    <SolidColorBrush x:Key="AppCriticalBrush" Color="#FFD92D20" />
    <SolidColorBrush x:Key="AppCautionBrush" Color="#FFB54708" />

    <!--  愚人节版本的类型标识色（下载页筛选圆点用，6px 面积）  -->
    <SolidColorBrush x:Key="AppAprilFoolsBrush" Color="#FF9B51E0" />

    <SolidColorBrush x:Key="AppCriticalSurfaceBrush" Color="#FFD92D20" Opacity="0.08" />
    <SolidColorBrush x:Key="AppCautionSurfaceBrush" Color="#FFB54708" Opacity="0.10" />
    <SolidColorBrush x:Key="AppSuccessSurfaceBrush" Color="#FF14804A" Opacity="0.08" />

    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppOnImageTextBrush" Color="#FFFFFFFF" />

    <!--
        ApplicationBackgroundBrush：所有窗口（含二级窗口）的整窗底色。
        纯白 —— 明亮清爽的底就是白，靠内容自己形成层次。

        ⚠️ 这是「一次性定义 + 运行时手写」的键，不随主题变体自动换色，
        唯一写入口是 SettingsService.ApplyTheme()，必须与变体始终同步。
    -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFFFFFFF" />

    <!--
        主操作底色。曾经是蓝→青的 135° 渐变，现在收成纯色：
        渐变按钮在工作型界面里属于"装饰"，会把注意力从内容抢到按钮上。
        键名保留 AppAccentGradientBrush 是为了不让历史页面集体失配。
    -->
    <SolidColorBrush x:Key="AppAccentGradientBrush" Color="#FF2F6BF0" />

    <!--  主操作的悬停 / 按下色：主色加深一档，运行时由 ApplyAccentCore 覆写  -->
    <SolidColorBrush x:Key="AppAccentDeepBrush" Color="#FF2559CE" />

    <!--  壁纸遮罩：让任何一张图上的文字都读得清（亮色偏白、暗色偏黑，见 Surfaces）  -->
    <SolidColorBrush x:Key="AppBackgroundScrimBrush" Color="#B8FFFFFF" />

    <!--
        强调色浅底：图标块 / 计数徽标 / 选中卡片底板。
        真实值由 SettingsService.ApplyAccentCore 按当前强调色覆写成 8% / 14% 透明度，
        页面里不要硬编码。
    -->
    <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#142F6BF0" />
    <SolidColorBrush x:Key="AppAccentSurfaceStrongBrush" Color="#242F6BF0" />

    <!--
        强调色光晕：主色向外衰减到全透明。
        新语言里光晕基本退场（启动按钮改为实心 + 微阴影），
        这里保留键名但把透明度压到很淡，只在启动页做一层极弱的存在感。
    -->
    <RadialGradientBrush x:Key="AppAccentHaloBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
        <GradientStop Offset="0" Color="#1F2F6BF0" />
        <GradientStop Offset="1" Color="#002F6BF0" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="AppAccentHairlineBrush" Color="#4D2F6BF0" />

    <!--  拖入整合包时的整窗提示层  -->
    <SolidColorBrush x:Key="AppDropOverlayBrush" Color="#4D0B0E14" />
    <SolidColorBrush x:Key="AppDropPanelBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF2F6BF0" />

    <!--  ==================== 字体  ====================

        正文与标题同族，层级靠字号 + 字重，不换字体。
        以前标题用 HarmonyOS Sans Black，太重，在 28px 上像海报不像工具。
    -->

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI, PingFang SC</FontFamily>
    <FontFamily x:Key="AppDisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI, PingFang SC</FontFamily>

    <!--  ==================== 字号阶梯（严格 5 档）  ====================

        28 / 20 / 16 / 14 / 12 —— 相邻级差 1.4x / 1.25x / 1.14x / 1.17x。
        页标题 28 保持分量，其余三档收紧间距，让一屏能装下更多内容
        ——「清爽」不等于「空旷」，信息密度同样是它的一部分。
    -->

    <x:Double x:Key="FontSizeDisplay">28</x:Double>
    <x:Double x:Key="FontSizeHero">20</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">14</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>

    <x:Double x:Key="LineHeightDisplay">38</x:Double>
    <x:Double x:Key="LineHeightSubtitle">24</x:Double>
    <x:Double x:Key="LineHeightBody">22</x:Double>

    <!--  图标尺寸单独一套，不参与文字阶梯  -->
    <x:Double x:Key="IconSizeCaption">12</x:Double>
    <x:Double x:Key="IconSizeBody">16</x:Double>
    <x:Double x:Key="IconSizeLarge">20</x:Double>
    <x:Double x:Key="IconSizeDisplay">28</x:Double>
    <x:Double x:Key="IconSizeHero">36</x:Double>
    <x:Double x:Key="IconSizeJumbo">56</x:Double>

    <!--  ==================== 间距  ====================  -->

    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="SpaceXXL">32</x:Double>

    <!--
        页内边距。明亮清爽的呼吸感主要来自这里：
        左右 40 让内容不贴边，上 32 给标题留白，下 36 让滚动到底时不局促。
    -->
    <Thickness x:Key="PagePadding">40,32,40,36</Thickness>
    <Thickness x:Key="PageHeaderMargin">0,0,0,28</Thickness>
    <Thickness x:Key="CardGap">0,0,16,16</Thickness>

    <!--  ==================== 圆角（严格 4 档）  ====================

        6   控件（按钮 / 输入框 / 标签）
        10  卡片 / 列表行
        16  浮层 / 大块容器
        ∞   胶囊（分段选择 / 计数徽标）

        比上一版（4/8/12）整体放大一档：直角偏"工程"，圆角偏"生活"，
        明亮清爽要的是后者。但 16 只给浮层 —— 大面积用大会显得软塌。
    -->

    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusS">6</CornerRadius>
    <CornerRadius x:Key="RadiusM">10</CornerRadius>
    <CornerRadius x:Key="RadiusL">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <!--  标题栏导航项选中块：保留独立一支，避免"圆角统一"时把胶囊也抹平  -->
    <CornerRadius x:Key="RadiusHeaderNav">999</CornerRadius>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>

</ResourceDictionary>
