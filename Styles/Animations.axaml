<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="using:VibrantbitLauncher.Helpers">

    <!--
        ============================================================================
        动效层 · 明亮清爽
        ============================================================================

        一条原则：**动的是状态，不是物体**。

        上一版有卡片悬停抬升、按钮按压缩放、启动按钮光晕呼吸。
        这些在深色沉浸式界面里是"质感"，在明亮清爽的界面里是"晃动"——
        白底上任何位移和缩放都格外显眼，会让人觉得界面不稳。

        现在只保留三类：
          · 颜色过渡    —— 悬停 / 按下 / 选中，120~160ms
          · 入场位移     —— 页面切换时 8px 上浮淡入，250ms
          · 滚动 / 背景 —— 平滑滚动、壁纸缓慢呼吸（默认关闭）

        时长只允许 120 / 160 / 250 三档，落在 20ms 网格。
        进 CubicEaseOut、出 CubicEaseIn；linear 只给进度条。

        ⚠️ 性能模式（设置 → 个性化）会给 Application 打上 performanceMode 类，
        本文件末尾的 `.performanceMode` 系列把上面所有效果整体清零。
        加新动效时**必须**同步补一条 performanceMode 关闭规则。

        ⚠️ xmlns:helpers 不能删：RenderTransform 相关的补丁动画器靠它注册。
    -->

    <!--  ==================== 1. 按钮  ====================

        只过渡底色与描边。不做 RenderTransform ——
        按钮位移会让同一行内的相邻按钮看起来在"跳"。
    -->

    <Style Selector="Button">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="RepeatButton">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--  ==================== 2. 列表  ====================  -->

    <Style Selector="ListBoxItem">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!--  ==================== 3. 卡片  ====================

        悬停只加深描边，不抬阴影、不位移。
        白底上的投影一旦动起来，整块内容会跟着"呼吸"，读起来很累。
    -->

    <Style Selector="Border.card">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    </Style>

    <Style Selector="Border.hoverCard">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.hoverCard:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCanvasSubtleBrush}" />
    </Style>

    <!--  ==================== 4. 输入  ====================  -->

    <Style Selector="TextBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!--  ==================== 5. 滚动  ====================  -->

    <Style Selector="ScrollViewer.smoothScroll">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBox.smoothScroll /template/ ScrollViewer">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!--  ==================== 6. 入场  ====================

        页面切换时内容上浮 8px 淡入。
        位移 8px 是"刚好能感知到方向"的最小值；再大就变成幻灯片。
    -->

    <Style Selector="Control.rise1">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>

    <Style Selector="Control.rise2">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>

    <Style Selector="Control.rise3">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>

    <Style Selector="Control.rise4">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>

    <!--  光晕：新语言里已无呼吸动画，保留空壳让历史引用不报错  -->
    <Style Selector="Border.halo">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!--  ==================== 7. 性能模式  ====================

        低端机（核显 / Win7 老机）在设置里打开这个开关后，全部过渡立即归零。
        注意这里是**逐个覆盖**而不是给根节点设一个开关：
        Transitions 是控件级属性，父级的设置不会自动往下传。
    -->

    <Style Selector=".performanceMode Button, .performanceMode Button /template/ ContentPresenter#PART_ContentPresenter, .performanceMode RepeatButton">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <Style Selector=".performanceMode ListBoxItem, .performanceMode ListBox">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <Style Selector=".performanceMode Border.card, .performanceMode Border.hoverCard">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <Style Selector=".performanceMode TextBox">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <Style Selector=".performanceMode Control.rise1, .performanceMode Control.rise2, .performanceMode Control.rise3, .performanceMode Control.rise4">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <Style Selector=".performanceMode ScrollViewer.smoothScroll, .performanceMode ListBox.smoothScroll /template/ ScrollViewer">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <Style Selector=".performanceMode Image.bgAnimated">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <!--  ==================== 8. 减少动态效果  ====================

        系统开了"减少动态效果"时，位移全部取消，只留极短的颜色过渡 ——
        保留颜色反馈是因为它不含运动，对前庭敏感人群无害。
    -->

    <Style Selector=".motionReduced Control.rise1, .motionReduced Control.rise2, .motionReduced Control.rise3, .motionReduced Control.rise4">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!--  ==================== 9. 动态背景  ====================

        壁纸缓慢呼吸缩放（24 秒一个来回）。默认关闭，只在用户开了「背景动画」时生效。
        只动 Transform（合成层内完成，不触发重排）。
    -->

    <Style Selector="Image.bgAnimated">
        <Style.Animations>
            <Animation Duration="0:0:24"
                       Easing="SineEaseInOut"
                       FillMode="Forward"
                       IterationCount="Infinite"
                       PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="scale(1.04)" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="scale(1.14)" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
