<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================================
        材质层（Fluent 2 · Layered Material）
        ============================================================================

        整个启动器的视觉语言只有一条线：**层**。
        底层是极光（Aurora），中层是玻璃（Acrylic），上层是卡片（Solid），
        最上层是强调（Accent）。四层之间靠「透明度 + 1px 细线 + 阴影」区分，
        不靠颜色堆叠。

        本文件只放"随明暗主题变化"的材质键。
        字号 / 圆角 / 间距等与主题无关的数值仍在 AppTheme.axaml 里。

        ⚠️ 这里全部用 DynamicResource 引用：
        ThemeDictionaries 里的键无法被 StaticResource 在解析期找到，
        写成 StaticResource 会直接抛 XamlLoadException。
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!--  ==================== 亮色  ====================  -->
        <ResourceDictionary x:Key="Light">

            <!--  画布：极光的底，比纯白低 2% 亮度，眼睛不累  -->
            <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FFF7F8FA" />

            <!--  玻璃面板：带一点透明，让极光在边缘透出来  -->
            <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="SurfaceGlassStrongBrush" Color="#F2FFFFFF" />

            <!--  卡片：实心，压在玻璃之上才有"层"的先后  -->
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardSoftBrush" Color="#F7FFFFFF" />

            <!--  下沉区（输入框底 / 列表底 / 代码块）  -->
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0D000000" />

            <!--  细线：1px 只用来"分", 不用来"框"  -->
            <SolidColorBrush x:Key="HairlineBrush" Color="#17000000" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#2B000000" />

            <!--  卡片内高光：模拟玻璃上沿的一道反光  -->
            <SolidColorBrush x:Key="CardTopSheenBrush" Color="#33FFFFFF" />

            <!--  极光三色（低饱和，面积大但透明度低）  -->
            <SolidColorBrush x:Key="AuroraOneBrush" Color="#330078D4" />
            <SolidColorBrush x:Key="AuroraTwoBrush" Color="#22B146C2" />
            <SolidColorBrush x:Key="AuroraThreeBrush" Color="#2200B7C3" />

            <!--  遮罩 / 浮层底  -->
            <SolidColorBrush x:Key="ScrimBrush" Color="#66101618" />

            <!--
                极光光斑：三个巨大的径向渐变，叠在画布最底层。
                中心不透明、边缘全透明，所以看不到"圆的边界"，只看到一片光。
                刻意不做动画：三块大渐变每帧重绘在低端核显上代价太高，
                真正动的应该是"用户操作的那一下"，不是背景。
            -->
            <RadialGradientBrush x:Key="AuroraColdBlobBrush" Center="50%,50%" GradientOrigin="50%,50%">
                <GradientStop Offset="0" Color="#3D3B82F6" />
                <GradientStop Offset="1" Color="#003B82F6" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="AuroraWarmBlobBrush" Center="50%,50%" GradientOrigin="50%,50%">
                <GradientStop Offset="0" Color="#2EB146C2" />
                <GradientStop Offset="1" Color="#00B146C2" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="AuroraCoolBlobBrush" Center="50%,50%" GradientOrigin="50%,50%">
                <GradientStop Offset="0" Color="#2E22D3EE" />
                <GradientStop Offset="1" Color="#0022D3EE" />
            </RadialGradientBrush>
        </ResourceDictionary>

        <!--  ==================== 暗色  ====================  -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FF15171B" />
            <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#CC1E2026" />
            <SolidColorBrush x:Key="SurfaceGlassStrongBrush" Color="#F21F2228" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FF212429" />
            <SolidColorBrush x:Key="SurfaceCardSoftBrush" Color="#F2212429" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#38000000" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="CardTopSheenBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AuroraOneBrush" Color="#4A2B8BD4" />
            <SolidColorBrush x:Key="AuroraTwoBrush" Color="#33A146C2" />
            <SolidColorBrush x:Key="AuroraThreeBrush" Color="#3320C4D6" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000" />

            <RadialGradientBrush x:Key="AuroraColdBlobBrush" Center="50%,50%" GradientOrigin="50%,50%">
                <GradientStop Offset="0" Color="#4A2B6FD4" />
                <GradientStop Offset="1" Color="#002B6FD4" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="AuroraWarmBlobBrush" Center="50%,50%" GradientOrigin="50%,50%">
                <GradientStop Offset="0" Color="#3DA146C2" />
                <GradientStop Offset="1" Color="#00A146C2" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="AuroraCoolBlobBrush" Center="50%,50%" GradientOrigin="50%,50%">
                <GradientStop Offset="0" Color="#3D16B8C8" />
                <GradientStop Offset="1" Color="#0016B8C8" />
            </RadialGradientBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
