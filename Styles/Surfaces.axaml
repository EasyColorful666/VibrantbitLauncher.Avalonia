<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================================
        材质层 · 明亮清爽
        ============================================================================

        和上一版（极光 + 玻璃 + 卡片三层叠加）彻底断开了。
        现在只有两种面，界线极弱：

          画布  Canvas      —— 整窗底。亮色是纯白，暗色是近黑。
          卡片  Card        —— 白底 + 1px 浅描边。不做玻璃、不做投影。

        为什么要砍掉玻璃和极光：这两样都是「装饰性」的，
        它们在深色沉浸式界面里负责氛围，在明亮清爽的界面里只负责显脏 ——
        半透明层叠白底的结果是灰，不是通透。

        ⚠️ 全部用 DynamicResource 引用：ThemeDictionaries 里的键
        无法被 StaticResource 在解析期找到，写成 StaticResource 直接抛 XamlLoadException。
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!--  ==================== 亮色  ====================  -->
        <ResourceDictionary x:Key="Light">

            <!--  画布：纯白。眼睛长时间对着它也不累，因为内容区有足够的灰阶层次  -->
            <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FFFFFFFF" />

            <!--
                区块底：比画布低一档的浅灰。
                用来区分「这块是一组」—— 设置页的分组、侧栏、表格抬头。
                不用分割线，用底色差。这是 Notion 的做法。
            -->
            <SolidColorBrush x:Key="SurfaceCanvasSubtleBrush" Color="#FFF7F8FA" />

            <!--  卡片：纯白 + 描边。描边是它和画布唯一的区分手段  -->
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardSoftBrush" Color="#FFFCFCFD" />

            <!--  浮层 / 弹卡：唯一比卡片更亮的存在（靠投影而非底色）  -->
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFFFF" />

            <!--  历史键：glass 类仍被页面引用，改成实心白，不再做半透明  -->
            <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceGlassStrongBrush" Color="#FFFFFFFF" />

            <!--  下沉区（输入框底 / 列表底 / 代码块）  -->
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FFF3F4F7" />

            <!--  细线：#EAECF0 是白底上"刚好看得见"的最低对比  -->
            <SolidColorBrush x:Key="HairlineBrush" Color="#FFEAECF0" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#FFD6DAE1" />

            <!--  卡片内高光：新语言无高光，保留键名给历史页面，值为全透明  -->
            <SolidColorBrush x:Key="CardTopSheenBrush" Color="#00FFFFFF" />

            <!--
                标题栏：与画布同色，不加分隔线。
                顶栏和内容连成一片，靠留白而不是色块区分 —— Linear / Notion 都是这样。
            -->
            <SolidColorBrush x:Key="AppHeaderBarBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppHeaderBarForegroundBrush" Color="#FF14171C" />
            <SolidColorBrush x:Key="AppHeaderBarHoverBrush" Color="#FFF2F3F6" />
            <SolidColorBrush x:Key="AppHeaderBarPressedBrush" Color="#FFE8EAEE" />
            <SolidColorBrush x:Key="AppHeaderNavSelectedBrush" Color="#FFF2F3F6" />
            <SolidColorBrush x:Key="AppHeaderNavSelectedForegroundBrush" Color="#FF14171C" />

            <!--  遮罩 / 浮层底  -->
            <SolidColorBrush x:Key="ScrimBrush" Color="#4D0B0E14" />
        </ResourceDictionary>

        <!--  ==================== 暗色  ====================  -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FF0E1014" />
            <SolidColorBrush x:Key="SurfaceCanvasSubtleBrush" Color="#FF14171C" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FF171A20" />
            <SolidColorBrush x:Key="SurfaceCardSoftBrush" Color="#FF14171C" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FF1C2027" />
            <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#FF171A20" />
            <SolidColorBrush x:Key="SurfaceGlassStrongBrush" Color="#FF1C2027" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FF1D2128" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#FF262A32" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#FF363B45" />
            <SolidColorBrush x:Key="CardTopSheenBrush" Color="#00000000" />

            <SolidColorBrush x:Key="AppHeaderBarBrush" Color="#FF0E1014" />
            <SolidColorBrush x:Key="AppHeaderBarForegroundBrush" Color="#FFF2F4F7" />
            <SolidColorBrush x:Key="AppHeaderBarHoverBrush" Color="#FF1A1E25" />
            <SolidColorBrush x:Key="AppHeaderBarPressedBrush" Color="#FF232830" />
            <SolidColorBrush x:Key="AppHeaderNavSelectedBrush" Color="#FF1A1E25" />
            <SolidColorBrush x:Key="AppHeaderNavSelectedForegroundBrush" Color="#FFF2F4F7" />

            <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
