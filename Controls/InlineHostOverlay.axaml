<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Controls.InlineHostOverlay"
             IsVisible="False">

    <!--
        内嵌子页的浮层宿主：一层遮罩 + 居中卡片。

        这份结构原来直接写死在主窗口里，现在抽成独立控件、挂在主窗口的最外层：
        位置要在首次使用向导的覆盖层之上（向导里的账户按钮同样要弹这些子页）。

        动画作用对象是 Card（缩放 + 位移 + 淡入淡出），Scrim 同步淡入淡出。
    -->
    <Panel x:Name="Layer">

        <!--
            遮罩：Fluent 的 Smoke 层（深色压暗），而不是"白色蒙一层"。
            浅色主题下用白罩会把下面的界面洗成一片灰白，弹窗的层级反而更弱。
        -->
        <Border x:Name="Scrim" Background="{DynamicResource ScrimBrush}" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16">
            <!--
                卡片的 MaxWidth / MaxHeight 由 ShowAsync 按宿主实际尺寸设置，
                小屏或窗口被压缩后不会顶出可视区域。
            -->
            <Border x:Name="Card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="50%,50%"
                    Background="{DynamicResource SurfaceGlassStrongBrush}"
                    BorderBrush="{DynamicResource HairlineStrongBrush}"
                    BorderThickness="1"
                    BoxShadow="0 24 64 0 #40000000"
                    ClipToBounds="True"
                    CornerRadius="{DynamicResource RadiusL}">
                <ContentControl x:Name="ContentHost" />
            </Border>
        </ScrollViewer>
    </Panel>
</UserControl>
