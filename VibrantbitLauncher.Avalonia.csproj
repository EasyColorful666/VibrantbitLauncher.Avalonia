<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <EnableDefaultAvaloniaItems>true</EnableDefaultAvaloniaItems>
    <!-- 版本号唯一来源：启动日志横幅、设置页「关于」均从此读取 -->
    <Version>1.0.5.20</Version>
    <AssemblyName>VibrantbitLauncher.Avalonia</AssemblyName>
    <RootNamespace>VibrantbitLauncher</RootNamespace>
    <!--
      目标平台：**默认** win-x64，但允许命令行覆盖。

      为什么要带 Condition：`dotnet publish -r linux-x64` 传进来的是 MSBuild
      全局属性，优先级高于本文件——所以无条件赋值其实也不会拦住它。
      加 Condition 是为了让语义显式：只有「没人指定 RID」时才回落到 win-x64，
      VS 里 F5（不传 -r）依旧落在 win-x64。

      两条红线，千万别改：
      1. **不要删掉这一行**。删了之后本地不带 -r 构建时输出目录会悄悄变成
         bin/<cfg>/net10.0/（少了 win-x64 一层），结果是「编译成功但跑到的是旧 exe」
         这种极难排查的假象。
      2. **不要写成无条件赋值以外的怪写法**（比如放 PropertyGroup 外面），
         否则 IDE 的发布配置文件（Properties/PublishProfiles/*.pubxml）会失效。

      多平台一键发布见根目录 publish-all.ps1 / publish-all.sh。
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- 不包含运行时：产物里没有 coreclr/hostfxr/System.Private.CoreLib，
         用户机器须自备 .NET 10 Desktop Runtime（见 CHANGELOG 说明）。 -->

    <!-- 显式关掉 R2R。它会把 IL 预编译成本地代码塞进单文件，冷启动略快但体积暴涨
         （历史实测 73.6MB vs 42.6MB），本项目更在意分发体积。
         写在这里是为了让命令行发布与 IDE 的 pubxml 行为一致 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!--
      不开剪裁（PublishTrimmed=false）：本项目绑定走反射
      （AvaloniaUseCompiledBindingsByDefault=false），剪裁会摘掉运行期才用到的属性元数据，
      症状是页面绑不上而不是编译报错，代价远大于省下的几 MB。
      体积改由「单文件压缩 + 剥离符号 + 去掉未用依赖」来控制。
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--  ==================== 体积控制  ====================  -->

    <!-- 只保留英文卫星资源：其余 12 套 *.resources.dll 不再落地。
         界面文案本来就硬编码在 XAML 里，不依赖这些本地化资源 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 不把依赖包自带的 .pdb / .xml 文档当成「引用附属文件」复制（走的是 RAR 任务） -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!-- 不需要 XML 文档产物 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Release 不带符号：embedded 会把 PDB 塞回 exe，单文件里白白多出几 MB -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      单文件压缩（EnableCompressionInSingleFile）只在「独立部署」下可用，
      框架依赖发布时会被 SDK 拦下来（NETSDK1176）。
      实测框架依赖的单文件是 ~41MB，改成独立部署再压缩反而更大，
      所以这里保持框架依赖，不启用压缩。
    -->
  </PropertyGroup>

  <!--
    清掉发布目录里不该出现的东西。两类：

    1) 上游包误带的测试框架
       MinecraftLaunch.Base 的 nuspec 把 xunit / Microsoft.NET.Test.Sdk /
       Microsoft.CodeCoverage 写成了运行时依赖，于是 xunit.v3.*、
       Microsoft.TestPlatform.*、Microsoft.VisualStudio.TestPlatform.*、testhost.dll
       都会被复制进发布目录（约 2.1MB），对本应用毫无用处。

    2) 原生库的符号文件
       libSkiaSharp.pdb(80MB) + libHarfBuzzSharp.pdb(20MB) 是通过
       runtimes/*/native 下的运行时资产带进来的，AllowedReferenceRelatedFileExtensions
       管不到它们（那只作用于 RAR 任务）。

    按文件名 / 扩展名匹配，不锁版本号，上游升级也不会失效。
  -->
  <Target Name="TrimPublishPayload" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
          Remove="@(ResolvedFileToPublish)"
          Condition="
            '%(Extension)' == '.pdb' or
            $([System.String]::Copy('%(Filename)').StartsWith('xunit.')) or
            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.TestPlatform')) or
            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualStudio.TestPlatform')) or
            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualStudio.CodeCoverage')) or
            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.CodeCoverage')) or
            '%(Filename)' == 'testhost'" />
    </ItemGroup>
  </Target>

  <!--
    按 RID 剥掉「本平台永远不会加载」的其它平台后端与设计器程序集。

    Avalonia.Desktop 会把**所有**平台后端一起带进发布目录，而运行时
    UsePlatformDetect() 只会挑本平台那一套，其余的纯属白占地方：

      Avalonia.Win32
      Avalonia.Win32.Automation                    Windows 后端 / UIA
      Avalonia.X11
      Avalonia.FreeDesktop
      Avalonia.FreeDesktop.AtSpi
      Tmds.DBus.Protocol                           Linux X11 / 桌面集成 / DBus 无障碍 / DBus 协议栈
      Avalonia.Native
      Avalonia.Metal                               macOS 后端 / Metal 渲染
      Avalonia.DesignerSupport
      Avalonia.Remote.Protocol                     设计器专用，运行时零引用
      System.Diagnostics.EventLog.Messages         事件日志资源（只有 win 载荷里有）

    每个平台实测能省 1.6 ~ 2.8 MB。

    ⚠️ 注意这段是「删掉别的平台、留下本平台」，删错会直接导致目标平台起不来。
    逃生阀：`-p:SkipPlatformTrim=true` 整体关闭（出问题就用它，别在这上面猜）。
  -->
  <Target Name="TrimPlatformPayload"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(SkipPlatformTrim)' != 'true'">

    <!-- ① 全平台都不需要：设计器相关 -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'Avalonia.DesignerSupport' or
                                        '%(Filename)' == 'Avalonia.Remote.Protocol'" />
    </ItemGroup>

    <!-- ② Windows（win-x64 / win-x86 / win-arm64）：不需要 Linux / macOS 后端 -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'Avalonia.X11' or
                                        '%(Filename)' == 'Avalonia.FreeDesktop' or
                                        '%(Filename)' == 'Avalonia.FreeDesktop.AtSpi' or
                                        '%(Filename)' == 'Tmds.DBus.Protocol' or
                                        '%(Filename)' == 'Avalonia.Native' or
                                        '%(Filename)' == 'Avalonia.Metal' or
                                        '%(Filename)' == 'System.Diagnostics.EventLog.Messages'" />
    </ItemGroup>

    <!-- ③ Linux：不需要 Windows / macOS 后端 -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux-'))">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'Avalonia.Win32' or
                                        '%(Filename)' == 'Avalonia.Win32.Automation' or
                                        '%(Filename)' == 'Avalonia.Native' or
                                        '%(Filename)' == 'Avalonia.Metal' or
                                        '%(Filename)' == 'System.Diagnostics.EventLog.Messages'" />
    </ItemGroup>

    <!-- ④ macOS：不需要 Windows / Linux 后端（Native + Metal 是 macOS 自己的，保留） -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx-'))">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'Avalonia.Win32' or
                                        '%(Filename)' == 'Avalonia.Win32.Automation' or
                                        '%(Filename)' == 'Avalonia.X11' or
                                        '%(Filename)' == 'Avalonia.FreeDesktop' or
                                        '%(Filename)' == 'Avalonia.FreeDesktop.AtSpi' or
                                        '%(Filename)' == 'Tmds.DBus.Protocol' or
                                        '%(Filename)' == 'System.Diagnostics.EventLog.Messages'" />
    </ItemGroup>

  </Target>

  <ItemGroup>
    <!-- Avalonia 核心 -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <!-- Avalonia.Fonts.Inter 已移除：界面字体是 Segoe UI Variable / 微软雅黑 /
         HarmonyOS Sans，内置的 Inter 字体（约 1.9MB）从未被任何 FontFamily 引用 -->

    <!-- FluentAvalonia：WinUI 风格控件库（官方团队维护） -->
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- Minecraft 启动内核（与原版保持同一版本） -->
    <PackageReference Include="MinecraftLaunch" Version="4.0.7" />
    <PackageReference Include="MinecraftLaunch.Base" Version="1.1.19" />
    <!-- MinecraftLaunch.Skin 已移除：它唯一被用到的是 CropSkinHeadBitmap()，
         而它的实现依赖 SixLabors.ImageSharp（见 Helpers/RgbaBitmap.cs 的说明）。
         现在头像裁剪由 SkinService.BuildHeadBitmap 用 SkiaSharp 自己实现，像素结果与原库逐字节一致。 -->

    <!-- 基础设施 -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- System.Management 已移除：全项目没有任何 ManagementObject / WMI 调用 -->

    <!-- SkiaSharp：Avalonia 的渲染后端本来就依赖它，这里是**显式**声明，
         供 Helpers/RgbaBitmap.cs 做皮肤 PNG 的解码 / 编码。
         版本与 Avalonia 12.1.0 解析出的版本一致，不改变发布载荷。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- SixLabors.ImageSharp 已移除（2 MB）：全项目仅皮肤裁剪用到，已由 SkiaSharp 顶替 -->
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
