<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <EnableDefaultAvaloniaItems>true</EnableDefaultAvaloniaItems>
    <!-- 版本号唯一来源：启动日志横幅、设置页「关于」均从此读取 -->
    <Version>1.0.26.1</Version>
    <AssemblyName>VibrantbitLauncher.Avalonia</AssemblyName>
    <RootNamespace>VibrantbitLauncher</RootNamespace>
    <!--
      开源协议：AGPL-3.0。三处声明必须一致，改协议时一起改：
        1. 这里（进程序集元数据，资源管理器「详细信息」与 NuGet 元数据都读它）
        2. 根目录 LICENSE.txt（协议全文，随源码分发）
        3. README.md「开源协议」一节 + 「设置 → 关于 → 开源与致谢」（玩家能看到的说法）
      写法用 SPDX 标识的 -only：本工程只接受第 3 版，没写「或更高版本」。
      如果以后想允许被更高版本的 AGPL 覆盖，把它、LICENSE.txt 与关于页说明一并改成 -or-later。
    -->
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 EasyColorful666</Copyright>
    <!--
      目标平台：**默认** win-x64，但允许命令行覆盖。

      为什么要带 Condition：`dotnet publish -r linux-x64` 传进来的是 MSBuild
      全局属性，优先级高于本文件——所以无条件赋值其实也不会拦住它。
      加 Condition 是为了让语义显式：只有「没人指定 RID」时才回落到 win-x64，
      VS 里 F5（不传 -r）依旧落在 win-x64。

      两条红线，千万别改：
      1. **不要删掉这一行**。删了之后本地不带 -r 构建时输出目录会悄悄变成
         bin/<cfg>/net10.0/（少了 win-x64 一层），结果是「编译成功但跑到的是旧 exe」
         这种极难排查的假象。
      2. **不要写成无条件赋值以外的怪写法**（比如放 PropertyGroup 外面），
         否则 IDE 的发布配置文件（Properties/PublishProfiles/*.pubxml）会失效。

      多平台一键发布见根目录 publish-all.ps1 / publish-all.sh。
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!--
      同样带 Condition：发布配置文件（Properties/PublishProfiles/*.pubxml）与命令行
      -p:PublishSingleFile=false 要能覆盖它。写成无条件赋值的话，便携目录那份
      配置会被这里悄悄改回单文件，产物看着「发布成功」却是错的。
    -->
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <!-- 不包含运行时：产物里没有 coreclr/hostfxr/System.Private.CoreLib，
         用户机器须自备 .NET 10 Desktop Runtime（见 CHANGELOG 说明）。 -->

    <!-- 显式关掉 R2R。它会把 IL 预编译成本地代码塞进单文件，冷启动略快但体积暴涨
         （历史实测 73.6MB vs 42.6MB），本项目更在意分发体积。
         写在这里是为了让命令行发布与 IDE 的 pubxml 行为一致 -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!--
      单文件压缩的开关在文件末尾（Release 段之后）。**不能放在这里**：
      MSBuild 的属性按书写顺序求值，此处 SelfContained 还是上面的 false，
      条件会当场定格成 false，后面再改 SelfContained 也不会重算。
    -->

    <!--
      不开剪裁（PublishTrimmed=false）：本项目绑定走反射
      （AvaloniaUseCompiledBindingsByDefault=false），剪裁会摘掉运行期才用到的属性元数据，
      症状是页面绑不上而不是编译报错，代价远大于省下的几 MB。
      体积改由「单文件压缩 + 剥离符号 + 去掉未用依赖」来控制。
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      ⚠️ 关掉 apphost 的 CET（Intel 控制流强制技术 / 影子栈）兼容标记。

      症状（2026-10-19，Win10 22H2 虚拟机实测）：
        双击无反应、没有任何日志，事件查看器里是 KERNELBASE.dll + 0x80131506；
        手动在终端里跑才看得到真正的原因：
          Fatal error.
          Your Windows doesn't fully support CET. Please install all available Windows updates.

      原理：.NET 8 起 apphost 默认给自己的 PE 打上「CET 兼容」标记。
      运行时启动时会据此检查操作系统是否完整支持 CET —— 而 Windows 10 的某些
      补丁级别（如 19041.2913）在支持 CET 的 CPU 上处于「半支持」状态：
      CPU 报告有 CET，系统却没打全相关补丁。运行时检测到这个矛盾会直接 FailFast
      （0x80131506 = COR_E_EXECUTIONENGINE），崩溃发生在任何托管代码之前 ——
      所以 StartupFailureReporter 也拦不到，磁盘上一个字都不会有。

      关掉这个标记后运行时不再做该检查，代价是放弃影子栈这一项硬件缓解措施。
      对本项目（离线启动器、无不受信输入）来说，能启动远比这项缓解重要。
      想让系统回到「全支持」状态的正道仍是装齐 Windows 更新，届时删掉这一行即可。
    -->
    <CetCompat>false</CetCompat>

    <!--  ==================== 体积控制  ====================  -->

    <!-- 只保留英文卫星资源：其余 12 套 *.resources.dll 不再落地。
         界面文案本来就硬编码在 XAML 里，不依赖这些本地化资源 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 不把依赖包自带的 .pdb / .xml 文档当成「引用附属文件」复制（走的是 RAR 任务） -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!-- 不需要 XML 文档产物 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--  ==================== 程序集剪裁（可选，默认关）  ====================  -->

  <!--
    ★ 开关：-p:EnableAppTrimming=true（publish-all.ps1 的 -Trimmed 走这里，
      WindowsTrimmed.pubxml 也走这里）。

    为什么单独做一个开关而不是直接开 PublishTrimmed：
      ① csproj 里的 PublishTrimmed=false 是**默认值**，需要一个显式信号才能翻过来；
      ② TrimmerRootAssembly 是 Item，命令行传多项要写 %3B 转义，极易踩坑 ——
         固化在 csproj 里，调用方只需一个布尔开关；
      ③ 发布配置（pubxml）与一键脚本共用同一份 root 列表，不会走偏。

    实测收益（win-x64 / win 单文件 / 1.0.10.2）：
      不剪裁  52.29 MB
      剪裁    29.04 MB   ← -44%（已启动验证到主界面）

    省下来的主要是自包含运行时里「整个包原样复制」的部分：
      System.Private.Xml 7.4MB · System.Linq.Expressions 3.5MB ·
      System.Data.Common 2.6MB · System.Private.DataContractSerialization 2.0MB ·
      System.Text.Json 1.8MB（按实际调用图只留被走到的代码）
  -->
  <PropertyGroup Condition="'$(EnableAppTrimming)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <!--
      partial 而不是 full：只裁「自己声明了 IsTrimmable」的程序集，
      对没有剪裁标注的第三方库保持原样。宁可少省几 MB，也不要在
      MinecraftLaunch / Flurl / Newtonsoft 这类反射密集的库上赌。
    -->
    <TrimMode>partial</TrimMode>
    <!-- 剪裁警告照常输出，不要用 SuppressTrimAnalysisWarnings 捂掉 -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>

    <!--
      ★ 必须显式把 System.Text.Json 的反射序列化打开（1.0.10.6 踩过的坑）

      PublishTrimmed=true 时，SDK 会把功能开关
      System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault 置为 false
      （目的是让 IL2026 警告不误报）。后果是**任何**没有 TypeInfoResolver 的
      JsonSerializer.Deserialize / Serialize 在**运行期**直接抛：

        InvalidOperationException: Reflection-based serialization has been
        disabled for this application. ...

      本项目所有 JSON 都走反射（SettingsService、SkinService、MojangNewsHelper、
      ModrinthSearchService……），于是剪裁版一开局域网请求就炸 ——
      模组下载页 100% 复现「无法访问 Modrinth」，而同一个 exe 的非剪裁版完全正常。

      打开不等于不剪裁：类型元数据能不能活下来仍然取决于 TrimmerRootAssembly，
      本项目自己那个程序集已整份 root 住，所以反射取属性是安全的。
      代价约 1MB（System.Text.Json 的反射路径保留）。
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!--
    ★ 剪裁时的保留根（TrimmerRootAssembly = 整程序集元数据全保留）。

    ⚠️⚠️ **这个 ItemGroup 刻意不写 Condition**（1.0.10.2 踩过的坑）
    ================================================================
    publish profile（pubxml）是在 csproj **全部求值之后**才 Import 的，
    所以写在 pubxml 里的 EnableAppTrimming，csproj 里的条件块永远看不到：

      dotnet publish -p:EnableAppTrimming=true   → 全局属性，求值前就有 → 生效
      dotnet publish -p:PublishProfile=WindowsTrimmed → 求值后才有 → 条件不成立 → 不生效

    后果实测：pubxml 路径下「只开了 PublishTrimmed 但 root 全丢」，
    ILLink 把 Avalonia 的 !AvaloniaResources 索引一起裁掉，
    产出 28.03MB 的 exe，一启动就是：

      XamlLoadException: No precompiled XAML found for VibrantbitLauncher.App

    去掉 Condition 后两条路径都正常，产物 29.04MB，启动到主界面（SHOWN）。

    不写 Condition 安全吗？安全。标准档（PublishTrimmed=false）时 ILLink 根本
    不运行，TrimmerRootAssembly 只是一个没人读的 Item，不进 ResolvedFileToPublish，
    对产物与体积零影响（实测标准档仍是 52.29MB）。

    为什么必须 root 这 8 个：本项目 AvaloniaUseCompiledBindingsByDefault=false，
    XAML 绑定走反射，剪裁器看不到 XAML 里写的字符串路径；
    而 JSON 序列化（SettingsService / SkinService / MojangNewsHelper）同样靠反射取属性。
    两处都需要「运行期才用到的元数据」，正好是剪裁器最爱删的东西。

      VibrantbitLauncher.Avalonia  全部 ViewModel / Model / JSON 契约类型
      Avalonia.Base                属性系统、绑定引擎、样式选择器
      Avalonia.Controls            控件属性与模板
      Avalonia.Markup.Xaml         XAML 加载器（反射构造控件）
      FluentAvalonia               FANavigationView / FAAppWindow 等模板
      MinecraftLaunch(Base)        版本 JSON / 库模型的反序列化
      CommunityToolkit.Mvvm        ObservableProperty 生成的成员

    加完这 8 个之后单文件仍为 29.04MB（裁掉的是 BCL 里确实没走到的部分）。

    ⚠️ 仍需人工验收（AI 无法替你跑 GUI）：冷启动、各页面绑定、设置读写后重启、
    账号登录、皮肤换肤、下载、新建 Forge 实例、**拖放文件 / 文件选择对话框**
    （后者走 COM，剪裁器对 BuiltInComInteropSupport 有 IL2026 警告，
    是本档最可能出问题的一处）。任何一项异常就回到不剪裁的档位。
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="VibrantbitLauncher.Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <!--
      运行时 XAML 加载器：主题包的 theme.axaml / styles.axaml 只有运行期才解析，
      剪裁器看不到任何静态引用，不 root 会在开剪裁的发布档里被整份摘掉，
      症状是「装好主题点了没反应」（加载返回 null，日志里一条 exception）。
    -->
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml.Loader" />
    <TrimmerRootAssembly Include="FluentAvalonia" />
    <TrimmerRootAssembly Include="MinecraftLaunch" />
    <TrimmerRootAssembly Include="MinecraftLaunch.Base" />
    <TrimmerRootAssembly Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Release 不带符号：embedded 会把 PDB 塞回 exe，单文件里白白多出几 MB -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      ★ 默认自包含（1.0.9.6 起固化）。

      原来的默认是「框架依赖 + 不压缩」（约 40MB），代价是目标机器必须先装
      .NET 10 Desktop Runtime —— 没装时双击**毫无反应**、零日志，宿主在托管代码
      之前就退出，用户只会说「打不开」。分发场景下这个默认值是要命的。

      现在不带任何参数执行 `dotnet publish` 就产出内含运行时的单文件 exe；
      命令行仍可用「关闭自包含」的开关（no-self-contained）或
      SelfContained=false 覆盖回框架依赖
      （publish-all.ps1 -FrameworkDependent 走的就是这条路）。
    -->
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!--
    单文件压缩：**只在自包含发布时开启**（1.0.9.3 起自动生效，不必再手动传参）。

    ⚠️ 必须写在 Release PropertyGroup **之后**：MSBuild 属性按顺序求值，
    放在前面会读到旧的 SelfContained=false，条件当场定格成 false。

    为什么带 Condition：框架依赖时 SDK 会直接拦下（NETSDK1176
    「Compression is only supported for self-contained」），所以不能无条件开。

    收益实测（win-x64，同一份代码）：
      自包含 + 不压缩 → 113 MB
      自包含 + 压缩   → 55 MB      ← 约 51%
    代价是首次启动要把内嵌的运行时解压到 %TEMP%\.net\，老机器上多 1~3 秒；
    之后就复用已解压的目录。相比「让用户去装 60MB 的 .NET 运行时」，
    多等几秒、多占几十 MB 明显更划算。
  -->
  <PropertyGroup>
    <!--
      条件里必须同时看 PublishSingleFile：关闭单文件（-p:PublishSingleFile=false，
      即「便携目录」形态）时还开着压缩，SDK 会报 NETSDK1169。
    -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true' and '$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' != 'true' or '$(PublishSingleFile)' != 'true'">false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    清掉发布目录里不该出现的东西。两类：

    1) 上游包误带的测试框架
       MinecraftLaunch.Base 的 nuspec 把 xunit / Microsoft.NET.Test.Sdk /
       Microsoft.CodeCoverage 写成了运行时依赖，于是 xunit.v3.*、
       Microsoft.TestPlatform.*、Microsoft.VisualStudio.TestPlatform.*、testhost.dll
       都会被复制进发布目录（约 2.1MB），对本应用毫无用处。

    2) 原生库的符号文件
       libSkiaSharp.pdb(80MB) + libHarfBuzzSharp.pdb(20MB) 是通过
       runtimes/*/native 下的运行时资产带进来的，AllowedReferenceRelatedFileExtensions
       管不到它们（那只作用于 RAR 任务）。

    按文件名 / 扩展名匹配，不锁版本号，上游升级也不会失效。

    3) 调试器 / 转储分析组件（1.0.10.2 新增，约 6.2MB 未压缩）
       mscordaccore.dll                 DAC，托管调试器读取进程状态用
       mscordaccore_amd64_*.dll         DAC 的架构专用副本（名字带运行时补丁号）
       mscordbi.dll                     ICorDebug 实现
       Microsoft.DiaSymReader.Native    PDB 读写（DAC 的依赖）

       这些只在「VS 附加到进程」「dotnet-dump / 蓝屏转储分析」时才被加载，
       应用自己运行一行都不碰。注意 `<DebuggerSupport>false</DebuggerSupport>`
       对自包含载荷**无效**（实测 1.0.10.1：同名 dll 一个不少，体积 0 变化），
       所以只能在这里删。

       ⚠️ 副作用：发布产出的 exe 无法再被 VS「附加到进程」调试，也无法生成
       托管转储分析。**开发调试请用 dotnet build 的产物**（不受此影响，bin/ 下
       mscordaccore 仍在）。如果哪天真要查发布版的崩溃转储，临时去掉这 4 条 Remove。
  -->
  <Target Name="TrimPublishPayload" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="&#xA;            '%(Extension)' == '.pdb' or&#xA;            $([System.String]::Copy('%(Filename)').StartsWith('xunit.')) or&#xA;            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.TestPlatform')) or&#xA;            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualStudio.TestPlatform')) or&#xA;            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualStudio.CodeCoverage')) or&#xA;            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.CodeCoverage')) or&#xA;            $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore')) or&#xA;            $([System.String]::Copy('%(Filename)').StartsWith('mscordbi')) or&#xA;            $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader')) or&#xA;            '%(Filename)' == 'testhost'" />
    </ItemGroup>
  </Target>

  <!--
    按 RID 剥掉「本平台永远不会加载」的其它平台后端与设计器程序集。

    Avalonia.Desktop 会把**所有**平台后端一起带进发布目录，而运行时
    UsePlatformDetect() 只会挑本平台那一套，其余的纯属白占地方：

      Avalonia.Win32
      Avalonia.Win32.Automation                    Windows 后端 / UIA
      Avalonia.X11
      Avalonia.FreeDesktop
      Avalonia.FreeDesktop.AtSpi
      Tmds.DBus.Protocol                           Linux X11 / 桌面集成 / DBus 无障碍 / DBus 协议栈
      Avalonia.Native
      Avalonia.Metal                               macOS 后端 / Metal 渲染
      Avalonia.DesignerSupport
      Avalonia.Remote.Protocol                     设计器专用，运行时零引用
      System.Diagnostics.EventLog.Messages         事件日志资源（只有 win 载荷里有）

    ⚠️⚠️ **`Avalonia.Metal` 在 Windows 上也是必需的，绝对不能在 win 分支里删！**（1.0.6.12 血案）
    它的名字看着像「macOS 的 Metal 图形 API」，但 Avalonia 12 的 **Win32 渲染管线实际会用到它**。
    实测（同一台机器、同一份 Release 产物，只差一个 dll）：

      Release build（不裁剪）        → 窗口内容正常
      Release publish（裁剪，删 Metal）→ 窗口建得出来但**内容一片空白、整窗透出桌面**
      删 Avalonia.Native / X11 / FreeDesktop / DBus / Designer 组 → 均正常（这几个确实可以不删也删对了）

    因为裁剪 Target 只在 **publish** 阶段生效，`dotnet build` 与 VS 调试跑不出来这个问题 ——
    「调试正常、单文件发布透明」就是这个原因，别再往资源字典 / 主题 / Mica 上找。

    每个平台实测能省 1.6 ~ 2.8 MB（**不含 Metal**）。

    ⚠️ 注意这段是「删掉别的平台、留下本平台」，删错会直接导致目标平台起不来。
    逃生阀：`-p:SkipPlatformTrim=true` 整体关闭（出问题就用它，别在这上面猜）。
  -->
  <Target Name="TrimPlatformPayload" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(SkipPlatformTrim)' != 'true'">

    <!-- ① 全平台都不需要：设计器相关 -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Avalonia.DesignerSupport' or&#xA;                                        '%(Filename)' == 'Avalonia.Remote.Protocol'" />
    </ItemGroup>

    <!-- ② Windows（win-x64 / win-x86 / win-arm64）：不需要 Linux / macOS 后端。
         ⚠️ 这里**不删** Avalonia.Metal：win 的渲染管线依赖它（见上面的血案说明）。 -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Avalonia.X11' or&#xA;                                        '%(Filename)' == 'Avalonia.FreeDesktop' or&#xA;                                        '%(Filename)' == 'Avalonia.FreeDesktop.AtSpi' or&#xA;                                        '%(Filename)' == 'Tmds.DBus.Protocol' or&#xA;                                        '%(Filename)' == 'Avalonia.Native' or&#xA;                                        '%(Filename)' == 'System.Diagnostics.EventLog.Messages'" />
    </ItemGroup>

    <!-- ③ Linux：不需要 Windows / macOS 后端。
         ⚠️ 同样保留 Avalonia.Metal（宁可多带 0.4MB，也不要赌）。 -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux-'))">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Avalonia.Win32' or&#xA;                                        '%(Filename)' == 'Avalonia.Win32.Automation' or&#xA;                                        '%(Filename)' == 'Avalonia.Native' or&#xA;                                        '%(Filename)' == 'System.Diagnostics.EventLog.Messages'" />
    </ItemGroup>

    <!-- ④ macOS：不需要 Windows / Linux 后端（Native + Metal 是 macOS 自己的，保留） -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx-'))">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Avalonia.Win32' or&#xA;                                        '%(Filename)' == 'Avalonia.Win32.Automation' or&#xA;                                        '%(Filename)' == 'Avalonia.X11' or&#xA;                                        '%(Filename)' == 'Avalonia.FreeDesktop' or&#xA;                                        '%(Filename)' == 'Avalonia.FreeDesktop.AtSpi' or&#xA;                                        '%(Filename)' == 'Tmds.DBus.Protocol' or&#xA;                                        '%(Filename)' == 'System.Diagnostics.EventLog.Messages'" />
    </ItemGroup>

  </Target>

  <ItemGroup>
    <!-- Avalonia 核心 -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!--
      运行时 XAML 加载器：主题包（用户自己写的 theme.axaml / styles.axaml）靠它加载。
      内置 XAML 有编译期产物，用户上传的没有，只能在运行期解析。
      版本必须与 Avalonia 主包一致，否则 XAML schema 对不上。
    -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" />
    <!-- 下载内核：分块多连接 + 断点续传 + 每块重试，1.0.7.15 起接管全部
         Minecraft 资源 / 模组 / 加载器下载（见 Services/Download/）。
         选它的理由：MIT、单 dll 约 1.3 MB、唯一依赖 Microsoft.Extensions.Logging.Abstractions，
         而且原生支持「一个文件多块并行」。 -->
    <PackageReference Include="Downloader" Version="5.10.1" />
    <!-- Avalonia.Fonts.Inter 已移除：界面字体是 Segoe UI Variable / 微软雅黑 /
         HarmonyOS Sans，内置的 Inter 字体（约 1.9MB）从未被任何 FontFamily 引用 -->

    <!-- FluentAvalonia：WinUI 风格控件库（官方团队维护） -->
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />

    <!-- Minecraft 启动内核（与原版保持同一版本） -->
    <PackageReference Include="MinecraftLaunch" Version="4.0.7" />
    <PackageReference Include="MinecraftLaunch.Base" Version="1.1.19" />
    <!-- MinecraftLaunch.Skin 已移除：它唯一被用到的是 CropSkinHeadBitmap()，
         而它的实现依赖 SixLabors.ImageSharp（见 Helpers/RgbaBitmap.cs 的说明）。
         现在头像裁剪由 SkinService.BuildHeadBitmap 用 SkiaSharp 自己实现，像素结果与原库逐字节一致。 -->

    <!-- 基础设施 -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- System.Management 已移除：全项目没有任何 ManagementObject / WMI 调用 -->

    <!-- SkiaSharp：Avalonia 的渲染后端本来就依赖它，这里是**显式**声明，
         供 Helpers/RgbaBitmap.cs 做皮肤 PNG 的解码 / 编码。
         版本与 Avalonia 12.1.0 解析出的版本一致，不改变发布载荷。 -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- SixLabors.ImageSharp 已移除（2 MB）：全项目仅皮肤裁剪用到，已由 SkiaSharp 顶替 -->
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!--
      主题包的 XAML 只当**普通资源**打包（原样保留文本）。

      它们必须能被运行期解析：内置主题与用户主题走同一条加载路径
      （读文本 → AvaloniaRuntimeXamlLoader），这样「内置的那三套」本身就是
      主题包格式的活样本，用户照着改就能做出自己的主题。
      如果让它们走编译期 XAML，内置那三套的写法就和用户的不一样了，
      文档说的和代码做的是两回事。

      注意 Remove 必须在 Include 之前求值才能生效 —— Avalonia 的默认项在
      Avalonia.props 里，早于本文件，所以这里 Remove 有效。

      ⚠️ 只 Remove 掉 AvaloniaXaml 是**不够**的（1.0.23.0 的坑）：
      文件还挂在 AvaloniaResource 里，Avalonia 的 XAML 构建任务照样会去处理它们，
      最后既没有编译产物、也没有可读的原始文本 —— 运行时 AssetLoader.Exists 直接返回 false，
      于是主题包里的配色/圆角/样式**一条都没生效**，只有 theme.json 的元信息在起作用。
      现在改成真正的普通资源（EmbeddedResource），运行时用 GetManifestResourceStream 读文本。
    -->
    <AvaloniaXaml Remove="Assets\Themes\**\*.axaml" />
    <AvaloniaResource Remove="Assets\Themes\**\*.axaml" />
    <EmbeddedResource Include="Assets\Themes\**\*.*" />
    <!--
      协议全文也打进程序集里（约 35 KB），供「设置 → 关于 → 查看协议」离线显示。

      为什么不在发布包里单独放一份 LICENSE.txt：本工程默认发布成**单文件 exe**，
      玩家那边往往只有一个 exe。放外部文件要么被漏拷、要么被解压工具丢在压缩包角落，
      而 AGPL 要求协议随程序一起提供给使用者。打进程序集里，exe 到哪协议就到哪。
      （源码仓库那边仍然保留 LICENSE.txt，两份内容必须一致。）
    -->
    <AvaloniaResource Include="LICENSE.txt" />
  </ItemGroup>

</Project>
