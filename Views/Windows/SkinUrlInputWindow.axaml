<UserControl
    x:Class="VibrantbitLauncher.Views.Windows.SkinUrlInputWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    mc:Ignorable="d"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Width="440"
    Height="290">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource ApplicationBackgroundBrush}">
        <ctrl:TitleBar
            Grid.Row="0"
            Height="36"
            Title="从网址加载皮肤"
            Icon="/Assets/icon.ico"
            IsInline="True" />

        <Grid
            Grid.Row="1"

            Margin="24,4,24,24"
            RowDefinitions="Auto,Auto,Auto">

            <TextBlock
                Grid.Row="0"
                Classes="title"
                Text="从网址加载皮肤" />

            <TextBlock
                Grid.Row="1"
                Margin="0,18,0,6"
                Classes="body"
                Text="皮肤文件直链（PNG）" />

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
                <TextBox
                    x:Name="textBox1"
                    Grid.Row="0"
                    PlaceholderText="https://example.com/skin.png"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Row="1"
                    MinWidth="120"
                    Margin="0,20,0,0"
                    Padding="24,10"
                    HorizontalAlignment="Right"
                    Classes="accent"
                    Click="OnConfirmClick"
                    Content="确定" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
