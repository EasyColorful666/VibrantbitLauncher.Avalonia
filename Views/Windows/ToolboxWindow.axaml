<Window
    x:Class="VibrantbitLauncher.Views.Windows.ToolboxWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Minecraft 工具箱"
    Width="452"
    Height="348"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    FontFamily="{StaticResource AppFont}"
    FontSize="{DynamicResource FontSizeBody}">

    <!--
        ==================== 半透明外壳 ====================
        窗口本身完全透明，可见的这块玻璃是下面这层 Border：
        底色用 SurfaceGlassBrush（深色 #CC1E2026 / 浅色 #D9FFFFFF），是「能看见后面游戏画面、
        但字还看得清」的那一档透明度。窗口不支持逐像素透明时会在代码后置里退回不透明底色。
    -->
    <Border
        x:Name="Shell"
        Background="{DynamicResource SurfaceGlassBrush}"
        BorderBrush="{DynamicResource HairlineStrongBrush}"
        BorderThickness="1"
        BoxShadow="0 16 40 0 #40000000"
        CornerRadius="{DynamicResource RadiusL}">

        <Grid RowDefinitions="Auto,*,Auto">

            <!--  ==================== 自绘标题栏（可拖动）  ====================  -->
            <Border
                x:Name="DragBar"
                Grid.Row="0"
                Padding="16,10,10,10"
                Background="Transparent"
                PointerPressed="DragBar_PointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TitleText"
                            Classes="subtitle"
                            Text="快速联机" />
                        <TextBlock
                            x:Name="InstanceText"
                            Classes="caption"
                            Text="未检测到正在运行的游戏"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        x:Name="CloseButton"
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Close_Click"
                        Content="✕"
                        ToolTip.Tip="关闭" />
                </Grid>
            </Border>

            <!--
                只有一页，所以不再套 TabControl：单页签的标签条除了多占一行高度，
                还会让人以为「下面还有别的东西」。
            -->
            <ScrollViewer
                Grid.Row="1"
                Margin="14,10,14,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">

                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <RadioButton
                            x:Name="HostRadio"
                            IsChecked="True"
                            IsCheckedChanged="Role_Changed"
                            Content="我是房主"
                            GroupName="ToolboxRole" />
                        <RadioButton
                            x:Name="GuestRadio"
                            IsCheckedChanged="Role_Changed"
                            Content="我是房客"
                            GroupName="ToolboxRole" />
                    </StackPanel>

                    <!--  房主：房间码  -->
                    <StackPanel x:Name="HostPanel" Spacing="8">
                        <Border
                            Padding="14,12"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            CornerRadius="{DynamicResource RadiusM}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption" Text="把这个码发给好友" />
                                <SelectableTextBlock
                                    x:Name="HostCodeText"
                                    FontSize="{DynamicResource FontSizeSubtitle}"
                                    Text="—" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="Regenerate_Click" Content="换一个码" />
                            <Button Click="CopyCode_Click" Content="复制联机码" />
                        </StackPanel>
                    </StackPanel>

                    <!--  房客：填码  -->
                    <StackPanel x:Name="GuestPanel" Spacing="8" IsVisible="False">
                        <TextBox
                            x:Name="GuestCodeBox"
                            PlaceholderText="粘贴房主给你的联机码，例如 U/ABCD-EFGH-JKLM-NPQR" />
                        <Button Click="Paste_Click" Content="从剪贴板粘贴" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="StartButton"
                            Classes="accent"
                            Click="Start_Click"
                            Content="开启联机" />
                        <Button
                            x:Name="StopButton"
                            Click="Stop_Click"
                            Content="断开"
                            IsEnabled="False" />
                    </StackPanel>

                    <TextBlock
                        x:Name="MultiplayerStatus"
                        Classes="caption"
                        Text="尚未开启虚拟网络。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="MultiplayerDetail"
                        Classes="caption"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!--  ==================== 底栏：快捷键提示  ====================  -->
            <Border
                Grid.Row="2"
                Padding="16,8,16,12"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Classes="caption"
                        Opacity="0.75"
                        Text="Esc 关闭" />
                    <TextBlock
                        x:Name="HotkeyHint"
                        Grid.Column="1"
                        Classes="caption"
                        Opacity="0.75"
                        Text="游戏中按 Alt+Shift+T 呼出" />
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
