<UserControl
    x:Class="VibrantbitLauncher.Views.Windows.CrashAnalysisWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    FontFamily="{DynamicResource AppFont}"
    FontSize="{DynamicResource FontSizeBody}"
    mc:Ignorable="d"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Width="686"
    Height="610">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource ApplicationBackgroundBrush}">
        <ctrl:TitleBar
            Grid.Row="0"
            Height="36"
            Title="崩溃分析"
            Icon="/Assets/icon.ico"
            IsInline="True" />

        <Grid
            Grid.Row="1"
            Margin="24,4,24,20"
            RowDefinitions="Auto,*,Auto">

            <StackPanel Grid.Row="0">
                <TextBlock Classes="title" Text="Minecraft 崩溃分析" />
                <TextBlock
                    x:Name="SubtitleText"
                    Margin="0,8,0,0"
                    Classes="caption"
                    Text="游戏进程异常退出。下面是自动分析出的原因与可以直接执行的修复动作。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,14,0,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <!--  崩溃原因  -->
                    <Border
                        Padding="14,12"
                        Background="{DynamicResource AppCriticalSurfaceBrush}"
                        BorderBrush="{DynamicResource AppCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusM}">
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AppCriticalBrush}"
                                Text="崩溃原因" />
                            <ItemsControl x:Name="ReasonsList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,2"
                                            Classes="body"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  可疑模组  -->
                    <Border
                        x:Name="SuspiciousPanel"
                        Padding="14,12"
                        Background="{DynamicResource AppCautionSurfaceBrush}"
                        BorderBrush="{DynamicResource AppCautionBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusM}">
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AppCautionBrush}"
                                Text="可疑模组" />
                            <ItemsControl x:Name="SuspiciousModsList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,2"
                                            Classes="body"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  一键修复  -->
                    <StackPanel x:Name="RepairSection" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="sectionTitle"
                                Text="一键修复"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="FixAllButton"
                                Grid.Column="1"
                                Classes="accent"
                                Click="FixAllButton_Click"
                                Content="全部修复" />
                        </Grid>

                        <TextBlock
                            x:Name="RepairEmptyText"
                            Classes="caption"
                            Text="没有检测到可以自动修复的问题。请参考上面的原因，或打开崩溃报告进一步排查。"
                            TextWrapping="Wrap" />

                        <ItemsControl x:Name="RepairList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="14,12"
                                        Classes="card">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    CornerRadius="{DynamicResource RadiusS}">
                                                    <TextBlock
                                                        Classes="caption"
                                                        Foreground="White"
                                                        Text="{Binding KindText}" />
                                                </Border>
                                                <TextBlock
                                                    Classes="subtitle"
                                                    Text="{Binding Title}"
                                                    TextWrapping="Wrap"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock
                                                Classes="caption"
                                                Text="{Binding Detail}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Classes="caption"
                                                Foreground="{DynamicResource AppSuccessBrush}"
                                                IsVisible="{Binding HasResult}"
                                                Text="{Binding ResultText}"
                                                TextWrapping="Wrap" />

                                            <Button
                                                HorizontalAlignment="Left"
                                                Click="RepairButton_Click"
                                                Content="{Binding ActionLabel}"
                                                IsEnabled="{Binding CanExecute}"
                                                IsVisible="{Binding ShowButton}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="OpenCrashFolderButton"
                    Padding="20,8"
                    Click="OpenCrashFolderButton_Click"
                    Content="打开崩溃报告目录" />
                <Button
                    x:Name="CloseButton"
                    Padding="20,8"
                    Classes="accent"
                    Click="CloseButton_Click"
                    Content="关闭" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
