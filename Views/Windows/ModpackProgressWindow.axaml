<UserControl
    x:Class="VibrantbitLauncher.Views.Windows.ModpackProgressWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    FontFamily="{StaticResource AppFont}"
    FontSize="{DynamicResource FontSizeBody}"
    mc:Ignorable="d"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Width="820"
    Height="620">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource ApplicationBackgroundBrush}">

        <!--  自绘标题栏  -->
        <ctrl:TitleBar
            Grid.Row="0"
            Height="36"
            Title="{Binding TitleText}"
            Icon="/Assets/icon.ico"
            IsInline="True" />

        <Grid Grid.Row="1" Margin="24,4,24,20" RowDefinitions="Auto,Auto,*,Auto">

            <!--  ============ 包信息 ============  -->
            <Border Grid.Row="0" Classes="card" Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="subtitle"
                                       VerticalAlignment="Center"
                                       Text="{Binding PackName}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Padding="6,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                    CornerRadius="{DynamicResource RadiusS}">
                                <TextBlock Classes="caption"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Text="{Binding FormatText}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon FontSize="{DynamicResource FontSizeCaption}" Symbol="Globe" />
                                <TextBlock Classes="caption" Text="{Binding GameVersionText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon FontSize="{DynamicResource FontSizeCaption}" Symbol="Code" />
                                <TextBlock Classes="caption" Text="{Binding LoaderText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon FontSize="{DynamicResource FontSizeCaption}" Symbol="Library" />
                                <TextBlock Classes="caption" Text="{Binding InstanceIdText}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Classes="caption"
                                   Opacity="0.7"
                                   Text="{Binding SourceLabel, StringFormat=来源：{0}}" />
                    </StackPanel>

                    <!--  右侧大百分比  -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Classes="display"
                                   HorizontalAlignment="Right"
                                   Text="{Binding Percent, StringFormat={}{0}%}" />
                        <TextBlock Classes="caption"
                                   HorizontalAlignment="Right"
                                   Text="{Binding Speed}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ============ 总进度 ============  -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="6">
                <ProgressBar Height="8"
                             Minimum="0" Maximum="100"
                             Value="{Binding Percent}" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="caption"
                               Text="{Binding StepText}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                        <TextBlock Classes="caption" Text="{Binding FilesText}" />
                        <TextBlock Classes="caption" Text="{Binding ElapsedText}" />
                        <TextBlock Classes="caption" Text="{Binding RemainingText}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--  ============ 主体：阶段条 + 文件清单 ============  -->
            <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="220,*">

                <!--  左：阶段条  -->
                <Border Grid.Column="0"
                        Classes="card"
                        Padding="14,12"
                        Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12" ColumnDefinitions="Auto,*">
                                        <!--  状态图标：四种状态各一个，靠 IsVisible 切换（避免写 converter）  -->
                                        <Panel Grid.Column="0" Width="20" VerticalAlignment="Top" Margin="0,1,8,0">
                                            <ui:FASymbolIcon FontSize="{StaticResource IconSizeCaption}"
                                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                             IsVisible="{Binding IsPending}"
                                                             Symbol="Clock" />
                                            <ui:FASymbolIcon FontSize="{StaticResource IconSizeCaption}"
                                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                             IsVisible="{Binding IsActive}"
                                                             Symbol="Download" />
                                            <ui:FASymbolIcon FontSize="{StaticResource IconSizeCaption}"
                                                             Foreground="{DynamicResource AppSuccessBrush}"
                                                             IsVisible="{Binding IsDone}"
                                                             Symbol="Accept" />
                                            <ui:FASymbolIcon FontSize="{StaticResource IconSizeCaption}"
                                                             Foreground="{DynamicResource AppCriticalBrush}"
                                                             IsVisible="{Binding IsFailed}"
                                                             Symbol="Alert" />
                                        </Panel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="body" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Classes="caption"
                                                       Opacity="0.7"
                                                       Text="{Binding Detail}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!--  右：文件清单  -->
                <Border Grid.Column="1" Classes="card" Padding="14,12">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0"
                                   Classes="sectionTitle"
                                   Margin="0,0,0,8"
                                   Text="文件清单" />

                        <!--  无待下载文件时的说明  -->
                        <TextBlock Grid.Row="1"
                                   Classes="caption"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !HasFiles}"
                                   Text="{Binding NoFilesText}" />

                        <ListBox Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsVisible="{Binding HasFiles}"
                                 ItemsSource="{Binding Files}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ContentPresenter
                                                Name="PART_ContentPresenter"
                                                Padding="{TemplateBinding Padding}"
                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ColumnDefinitions="Auto,*,Auto">
                                        <Panel Grid.Column="0" Width="20" Margin="0,0,8,0">
                                            <ui:FASymbolIcon FontSize="{DynamicResource FontSizeCaption}"
                                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                             IsVisible="{Binding IsPending}"
                                                             Symbol="Clock" />
                                            <ui:FASymbolIcon FontSize="{DynamicResource FontSizeCaption}"
                                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                             IsVisible="{Binding IsDownloading}"
                                                             Symbol="Download" />
                                            <ui:FASymbolIcon FontSize="{DynamicResource FontSizeCaption}"
                                                             Foreground="{DynamicResource AppSuccessBrush}"
                                                             IsVisible="{Binding IsCompleted}"
                                                             Symbol="Accept" />
                                            <ui:FASymbolIcon FontSize="{DynamicResource FontSizeCaption}"
                                                             Foreground="{DynamicResource AppCriticalBrush}"
                                                             IsVisible="{Binding IsFailed}"
                                                             Symbol="Alert" />
                                        </Panel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="caption"
                                                       Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="caption"
                                                       Opacity="0.6"
                                                       FontSize="{StaticResource IconSizeCaption}"
                                                       Text="{Binding Folder}" />
                                            <TextBlock Classes="caption"
                                                       FontSize="{StaticResource IconSizeCaption}"
                                                       Foreground="{DynamicResource AppCriticalBrush}"
                                                       IsVisible="{Binding IsFailed}"
                                                       Text="{Binding Detail}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Classes="caption"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.6"
                                                   Text="{Binding SizeText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!--  ============ 底部：结果 + 操作 ============  -->
            <Grid Grid.Row="3" Margin="0,16,0,0" ColumnDefinitions="*,Auto">

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Classes="caption"
                               IsVisible="{Binding !HasError}"
                               Text="{Binding ResultText}"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="caption"
                               Foreground="{DynamicResource AppCriticalBrush}"
                               IsVisible="{Binding HasError}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />

                    <!--  跳过/失败清单：装完了才显示，方便用户知道缺什么  -->
                    <ItemsControl ItemsSource="{Binding Skipped}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="caption"
                                           FontSize="{StaticResource IconSizeCaption}"
                                           Foreground="{DynamicResource AppCautionBrush}"
                                           Text="{Binding}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="openFolderButton"
                            Click="OnOpenFolderClick"
                            IsVisible="{Binding !HasError}"
                            ToolTip.Tip="在资源管理器中打开新实例目录">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:FASymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="打开实例目录" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="cancelButton"
                            Classes="danger"
                            Click="OnCancelClick"
                            IsVisible="{Binding CanCancel}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:FASymbolIcon Symbol="Cancel" />
                            <TextBlock Text="取消安装" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="closeButton"
                            Classes="accent"
                            Click="OnCloseClick"
                            IsVisible="{Binding IsFinished}"
                            Content="完成" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
