<Window
    x:Class="VibrantbitLauncher.Views.Windows.SkinManagerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="皮肤管理"
    Width="740"
    Height="580"
    CanResize="False"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource ApplicationBackgroundBrush}">
        <!--  自绘标题栏  -->
        <Border
            Grid.Row="0"
            Height="36"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="TitleBar">
            <TextBlock
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Classes="caption"
                Text="皮肤管理" />
        </Border>

        <Grid
            Grid.Row="1"
            Margin="24,4,24,24"
            ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,*,Auto">

            <!--  左：皮肤预览  -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="248"
                Margin="0,0,20,0"
                Padding="16"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="{StaticResource RadiusM}">
                <Grid RowDefinitions="*,Auto">
                    <Border
                        Grid.Row="0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusM}">
                        <Image
                            x:Name="previewImage"
                            Margin="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapInterpolationMode="None"
                            Stretch="Uniform" />
                    </Border>

                    <TextBlock
                        x:Name="previewHint"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Classes="caption"
                        Text="角色正面预览" />
                </Grid>
            </Border>

            <!--  右：账户信息  -->
            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock
                    x:Name="accountNameText"
                    Classes="title"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Spacing="10">
                    <Border
                        Padding="8,2"
                        Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="10">
                        <TextBlock
                            x:Name="accountTypeText"
                            FontSize="12"
                            Foreground="White" />
                    </Border>
                    <TextBlock
                        x:Name="skinStateText"
                        VerticalAlignment="Center"
                        Classes="caption" />
                </StackPanel>
            </StackPanel>

            <!--  右：操作区  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,18,0,0">
                <TextBlock
                    Margin="0,0,0,8"
                    Classes="body"
                    Text="手臂模型" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButton
                        x:Name="classicRadio"
                        Content="经典（粗手臂）"
                        GroupName="variant" />
                    <RadioButton
                        x:Name="slimRadio"
                        Content="纤细（细手臂）"
                        GroupName="variant" />
                </StackPanel>

                <TextBlock
                    Margin="0,20,0,8"
                    Classes="body"
                    Text="选择皮肤" />
                <TextBlock
                    Classes="caption"
                    Text="支持 64×64 或 64×32 的 PNG 文件"
                    TextWrapping="Wrap" />

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="chooseFileButton"
                        Padding="18,8"
                        Click="OnChooseFileClick"
                        Content="从文件选择" />
                    <Button
                        x:Name="chooseUrlButton"
                        Padding="18,8"
                        Click="OnChooseUrlClick"
                        Content="从网址加载" />
                </StackPanel>

                <Border
                    x:Name="statusBar"
                    Margin="0,14,0,0"
                    Padding="12,8"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    CornerRadius="{StaticResource RadiusM}"
                    IsVisible="False">
                    <TextBlock
                        x:Name="statusText"
                        Classes="caption"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!--  底部按钮  -->
            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="resetButton"
                    Padding="20,9"
                    Click="OnResetClick"
                    Content="重置为默认皮肤" />
                <Button
                    x:Name="applyButton"
                    Padding="26,9"
                    Classes="accent"
                    Click="OnApplyClick"
                    Content="保存" />
            </StackPanel>

            <fa:FAProgressRing
                x:Name="busyRing"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True"
                IsVisible="False" />
        </Grid>
    </Grid>
</Window>
