<UserControl
    x:Class="VibrantbitLauncher.Views.Windows.OfflineAuthenticatorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    FontFamily="{DynamicResource AppFont}"
    FontSize="{DynamicResource FontSizeBody}"
    mc:Ignorable="d"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Width="352"
    Height="305">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource ApplicationBackgroundBrush}">
        <ctrl:TitleBar
            Grid.Row="0"
            Height="36"
            Title="添加离线账户"
            Icon="/Assets/icon.ico"
            IsInline="True" />

        <Grid
            Grid.Row="1"

            Margin="24,4,24,24"
            RowDefinitions="Auto,Auto,Auto">

            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Center"
                Classes="title"
                Text="添加离线账户" />

            <TextBlock
                Grid.Row="1"
                Margin="0,24,0,6"
                Classes="body"
                Text="用户名" />

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
                <TextBox
                    x:Name="textBox1"
                    Grid.Row="0"
                    PlaceholderText="请输入游戏内用户名"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Row="1"
                    MinWidth="120"
                    Margin="0,20,0,0"
                    Padding="24,10"
                    HorizontalAlignment="Right"
                    Classes="accent"
                    Click="Button_Click"
                    Content="登录" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
