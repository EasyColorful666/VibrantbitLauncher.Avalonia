<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:ctrl="using:VibrantbitLauncher.Controls"
        xmlns:pages="using:VibrantbitLauncher.Views.Pages"
        xmlns:vm="using:VibrantbitLauncher.ViewModels.Windows"
        mc:Ignorable="d"
        x:Class="VibrantbitLauncher.Views.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="VibrantbitLauncher"
        Width="1180"
        Height="740"
        CanResize="False"

        MinWidth="1090"
        MinHeight="670"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="{DynamicResource FontSizeBody}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--
            导航内容区透出底层壁纸。
            这个键是 FANavigationView 的内容宿主底色，设成全透明后，
            页面与窗口之间只隔着一层（可选的）壁纸。
        -->
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

        <!--
            导航栏底板：**透明**，让侧栏直接落在画布上。
            侧栏与内容之间不靠色块区分，靠左边距和「选中项的浅灰块」——
            这是本语言处理"两个区域"的统一手法：不用分割线，用留白。
            （键名沿用 WinUI 的官方资源名；FluentAvalonia 若没有这一版键，
            这两条就是无害的空定义。）
        -->
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
    </Window.Resources>

    <Grid>
        <!--
            ==================== 第 0 层：画布 ====================
            不透明底色。Mica 不可用时它就是整窗的底，Mica 可用时它被透明窗口盖住，
            两者都不出现"整窗穿透到桌面"。
        -->
        <Border Background="{DynamicResource SurfaceCanvasBrush}" />

        <!--
            ==================== 第 0.5 层：纯色背景 ====================
            「背景 → 纯色」选出来的底色。和壁纸互斥：两个 IsVisible 不会同时为真。
        -->
        <Border Background="{Binding BackgroundColorBrush}"
                IsHitTestVisible="False"
                IsVisible="{Binding HasBackgroundColor}">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.20" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!--
            ==================== 第 1 层：用户壁纸 ====================
            设置里选了壁纸才有内容；切换壁纸时用 300ms 透明度过渡淡入淡出。

            Effect 由「毛玻璃强度」驱动：为 null 时不做离屏渲染（0 模糊不花钱），
            开了才走一次模糊通道 —— 全窗口大图模糊在核显上不便宜，所以默认是关的。
        -->
        <Image x:Name="BackgroundImageLayer"
               Classes.bgAnimated="{Binding BackgroundAnimated}"
               Effect="{Binding BackgroundEffect}"
               IsHitTestVisible="False"
               Opacity="{Binding BackgroundImageOpacity}"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               RenderTransformOrigin="50%,50%"
               Source="{Binding BackgroundImage}"
               Stretch="UniformToFill">
            <Image.RenderTransform>
                <ScaleTransform />
            </Image.RenderTransform>
            <Image.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.30" Easing="CubicEaseOut" />
                </Transitions>
            </Image.Transitions>
        </Image>

        <!--  可读性遮罩：压在壁纸上，保证任何一张图上的文字都读得清  -->
        <Border Background="{DynamicResource AppBackgroundScrimBrush}"
                IsHitTestVisible="False"
                IsVisible="{Binding HasBackgroundImage}" />

        <!--
            ==================== 第 1.5 层：暗角 ====================
            中心全透明、四角压暗。把视线收拢到中间，同时解决
            "图片边缘直接顶到窗口边框"的观感问题。
        -->
        <Border IsHitTestVisible="False"
                IsVisible="{Binding HasBackgroundVignette}"
                Opacity="{Binding BackgroundVignetteOpacity}">
            <Border.Background>
                <RadialGradientBrush Center="50%,45%"
                                     GradientOrigin="50%,45%"
                                     RadiusX="75%"
                                     RadiusY="75%">
                    <GradientStop Offset="0.45" Color="#00000000" />
                    <GradientStop Offset="1" Color="#FF000000" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!--
            ==================== 第 2 层：应用本体  ====================

            和上一版相比删掉了「极光层」：
            三块巨大的径向光斑在深色界面里是氛围，在白底上只会把整窗染成脏灰。
            现在背景就是画布白（或用户自己挑的壁纸），层次由内容自己承担。
        -->
        <Grid x:Name="AppRoot" RowDefinitions="Auto,*" RenderTransformOrigin="50%,50%">
            <!--
                标题栏：与画布同色、无分隔线，和内容连成一整块白。
                它只承担两件事 —— 拖窗 / 系统按钮。标题本身压到次级灰。
            -->
            <ctrl:TitleBar x:Name="AppTitleBar"
                           Grid.Row="0"
                           Height="44"
                           Title="VibrantbitLauncher"
                           Icon="/Assets/icon.ico" />

            <!--
                导航容器：常驻左侧**文字**导航（PaneDisplayMode=Left）。

                ⚠️ 上一版为了做「导航并进标题栏」用过 Top + IsPaneVisible=False，
                结果顶部自适应测量反复重排、整个窗口卡死（1.0.24.0 实测）。
                现在固定 Left，不再动态切模式，那个坑也就不存在了。
            -->
            <ui:FANavigationView x:Name="RootNavigation"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 IsSettingsVisible="False"
                                 IsBackButtonVisible="False"
                                 OpenPaneLength="184"
                                 CompactPaneLength="48"
                                 PaneDisplayMode="{Binding NavigationMode}"
                                 IsPaneToggleButtonVisible="False">

                <ui:FANavigationView.MenuItems>
                    <ui:FANavigationViewItem Content="启动" Tag="LaunchPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Play" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                    <ui:FANavigationViewItem Content="账户" Tag="AccountPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Contact" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                    <ui:FANavigationViewItem Content="下载中心" Tag="DownloadHubPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Download" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                    <ui:FANavigationViewItem Content="下载任务" Tag="DownloadCenterPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Clock" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                    <ui:FANavigationViewItem Content="多人" Tag="MultiplayerPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="People" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                </ui:FANavigationView.MenuItems>

                <ui:FANavigationView.FooterMenuItems>
                    <ui:FANavigationViewItem Content="设置" Tag="SettingsPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Setting" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                </ui:FANavigationView.FooterMenuItems>
            </ui:FANavigationView>

            <!--
                轻提示宿主：右下角，位于导航内容之上。

                ⚠️ 必须是 StackPanel 而不是 Panel：Panel 会把所有子元素叠在**同一个位置**，
                两条通知同时存在时文字直接重影（1.0.10.6 用户实测截图）。
                StackPanel 才会真正纵向堆叠。
            -->
            <StackPanel x:Name="SnackbarHost"
                        Grid.Row="1"
                        Margin="0,0,24,24"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        ZIndex="100" />

            <!--
                内嵌子页宿主（1.0.8.2 起：窗口原样嵌进来，不做任何改装）。

                遮罩 + 卡片的结构抽进了 InlineHostOverlay：首次使用向导期间主窗口是隐藏的，
                向导里的账户按钮同样要弹这些子页，那边也挂同一个控件。
            -->
            <ctrl:InlineHostOverlay x:Name="InlineOverlay" Grid.Row="1" ZIndex="150" />

        </Grid>

        <!--  拖入整合包时的整窗提示层：平时完全隐藏且不挡鼠标  -->
        <Border x:Name="DropOverlay"
                Background="{DynamicResource AppDropOverlayBrush}"
                IsHitTestVisible="False"
                IsVisible="False"
                ZIndex="200">
            <Border Margin="28"
                    Padding="40"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource AppDropPanelBrush}"
                    BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource RadiusL}"
                    BoxShadow="0 24 60 0 #40000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <ui:FASymbolIcon HorizontalAlignment="Center"
                                     FontSize="{StaticResource IconSizeHero}"
                                     Symbol="Download" />
                    <TextBlock x:Name="DropOverlayTitle"
                               HorizontalAlignment="Center"
                               Classes="subtitle"
                               FontWeight="SemiBold"
                               Text="松开即可安装整合包" />
                    <TextBlock x:Name="DropOverlayHint"
                               HorizontalAlignment="Center"
                               Classes="caption"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="支持 Modrinth (.mrpack) 与 CurseForge (.zip) 整合包" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
