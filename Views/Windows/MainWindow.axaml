<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:ctrl="using:VibrantbitLauncher.Controls"
        xmlns:pages="using:VibrantbitLauncher.Views.Pages"
        xmlns:vm="using:VibrantbitLauncher.ViewModels.Windows"
        mc:Ignorable="d"
        x:Class="VibrantbitLauncher.Views.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="VibrantbitLauncher"
        Width="1180"
        Height="740"
        CanResize="False"

        MinWidth="1090"
        MinHeight="670"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="{DynamicResource FontSizeBody}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--
            导航内容区透出底层壁纸。
            这个键是 FANavigationView 的内容宿主底色，设成全透明后，
            页面与窗口之间只隔着一层（可选的）壁纸。
        -->
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

        <!--
            导航栏底板：**透明**，让侧栏直接落在画布上。
            侧栏与内容之间不靠色块区分，靠左边距和「选中项的浅灰块」——
            这是本语言处理"两个区域"的统一手法：不用分割线，用留白。
            （键名沿用 WinUI 的官方资源名；FluentAvalonia 若没有这一版键，
            这两条就是无害的空定义。）
        -->
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
    </Window.Resources>

    <Window.Styles>
        <!--
            侧栏抽屉按钮：只在标题栏左端出现，所以样式挂窗口级，不往全局按钮里加分支。

            尺寸 32 + 左边距 8 → 图标中心落在 x=24，正好是紧凑侧栏（48）的中线；
            展开成 184 时也贴着导航项图标那一列，来回切按钮本身不位移。
        -->
        <Style Selector="Button.navDrawer">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.navDrawer /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.navDrawer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCanvasSubtleBrush}" />
        </Style>

        <Style Selector="Button.navDrawer:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        </Style>

        <!-- 图标是描边路径，不跟 Foreground 走，得单独换色 -->
        <Style Selector="Button.navDrawer:pointerover Path.navDrawerGlyph">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- 图标钮太小，按下不缩放（同全局 .subtle 的处理） -->
        <Style Selector="Button.navDrawer:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
    </Window.Styles>

    <Grid>
        <!--
            ==================== 第 0 层：画布 ====================
            不透明底色。Mica 不可用时它就是整窗的底，Mica 可用时它被透明窗口盖住，
            两者都不出现"整窗穿透到桌面"。
        -->
        <Border Background="{DynamicResource SurfaceCanvasBrush}" />

        <!--
            ==================== 第 0.5 层：纯色背景 ====================
            「背景 → 纯色」选出来的底色。和壁纸互斥：两个 IsVisible 不会同时为真。
        -->
        <Border Background="{Binding BackgroundColorBrush}"
                IsHitTestVisible="False"
                IsVisible="{Binding HasBackgroundColor}">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.20" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!--
            ==================== 第 1 层：用户壁纸 ====================
            设置里选了壁纸才有内容；切换壁纸时用 300ms 透明度过渡淡入淡出。

            Effect 由「毛玻璃强度」驱动：为 null 时不做离屏渲染（0 模糊不花钱），
            开了才走一次模糊通道 —— 全窗口大图模糊在核显上不便宜，所以默认是关的。
        -->
        <Image x:Name="BackgroundImageLayer"
               Classes.bgAnimated="{Binding BackgroundAnimated}"
               Effect="{Binding BackgroundEffect}"
               IsHitTestVisible="False"
               Opacity="{Binding BackgroundImageOpacity}"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               RenderTransformOrigin="50%,50%"
               Source="{Binding BackgroundImage}"
               Stretch="UniformToFill">
            <Image.RenderTransform>
                <ScaleTransform />
            </Image.RenderTransform>
            <Image.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.30" Easing="CubicEaseOut" />
                </Transitions>
            </Image.Transitions>
        </Image>

        <!--  可读性遮罩：压在壁纸上，保证任何一张图上的文字都读得清  -->
        <Border Background="{DynamicResource AppBackgroundScrimBrush}"
                IsHitTestVisible="False"
                IsVisible="{Binding HasBackgroundImage}" />

        <!--
            ==================== 第 1.5 层：暗角 ====================
            中心全透明、四角压暗。把视线收拢到中间，同时解决
            "图片边缘直接顶到窗口边框"的观感问题。
        -->
        <Border IsHitTestVisible="False"
                IsVisible="{Binding HasBackgroundVignette}"
                Opacity="{Binding BackgroundVignetteOpacity}">
            <Border.Background>
                <RadialGradientBrush Center="50%,45%"
                                     GradientOrigin="50%,45%"
                                     RadiusX="75%"
                                     RadiusY="75%">
                    <GradientStop Offset="0.45" Color="#00000000" />
                    <GradientStop Offset="1" Color="#FF000000" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!--
            ==================== 第 2 层：应用本体  ====================

            和上一版相比删掉了「极光层」：
            三块巨大的径向光斑在深色界面里是氛围，在白底上只会把整窗染成脏灰。
            现在背景就是画布白（或用户自己挑的壁纸），层次由内容自己承担。
        -->
        <Grid x:Name="AppRoot" RowDefinitions="Auto,*" RenderTransformOrigin="50%,50%">
            <!--
                标题栏这一行分两段：左端是侧栏抽屉按钮，右边才是自定义标题栏本体。

                为什么按钮不放进导航视图的 PaneHeader：FluentAvalonia 的模板在
                `:listsizecompact`（紧凑导航）下把 `PaneHeaderContentBorder` 直接隐藏，
                放进去就变成「一收起侧栏，展开按钮也跟着消失」，人再也点不回来。
                放在标题栏行里，按钮的位置和尺寸完全不受导航模式影响。
            -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource AppHeaderBarBrush}"
                  ColumnDefinitions="Auto,*">

                <Button x:Name="NavDrawerButton"
                        Grid.Column="0"
                        Classes="navDrawer"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleNavigationCommand}"
                        ToolTip.Tip="收起侧栏">
                    <!-- 侧栏图标：外框 + 左侧分隔竖线 -->
                    <Path Classes="navDrawerGlyph"
                          Data="M 1.5,2.5 H 14.5 V 13.5 H 1.5 Z M 6.5,2.5 V 13.5"
                          Width="16"
                          Height="16"
                          Stretch="None"
                          Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                          StrokeThickness="1.2"
                          VerticalAlignment="Center" />
                </Button>

                <!--
                    标题栏：与画布同色、无分隔线，和内容连成一整块白。
                    它只承担两件事 —— 拖窗 / 系统按钮。标题本身压到次级灰。
                -->
                <ctrl:TitleBar x:Name="AppTitleBar"
                               Grid.Column="1"
                               Height="44"
                               Title="VibrantbitLauncher"
                               Icon="/Assets/icon.ico" />
            </Grid>

            <!--
                导航容器：默认常驻左侧**文字**导航（PaneDisplayMode=Left）。
                标题栏左上角的抽屉按钮可以把它切成 LeftCompact（只留 48px 图标条），
                两者都走 SplitView 的 inline 模式，宽度变化由控件自己处理。

                这里**不绑** NavigationMode：收放要在切模式前先跑一段宽度动画，
                而模式一换宽度就是瞬间跳过去的（控件自己不做过渡）。
                驱动逻辑在 MainWindow.axaml.cs 的 ToggleNavigationAsync。

                ⚠️ 别改成 Top + IsPaneVisible=False —— 上一版这么做时顶部自适应测量
                反复重排、整个窗口卡死（1.0.24.0 实测）。
            -->
            <ui:FANavigationView x:Name="RootNavigation"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 IsSettingsVisible="False"
                                 IsBackButtonVisible="False"
                                 OpenPaneLength="184"
                                 CompactPaneLength="48"
                                 PaneDisplayMode="Left"
                                 IsPaneToggleButtonVisible="False">

                <ui:FANavigationView.MenuItems>
                    <ui:FANavigationViewItem Content="启动" Tag="LaunchPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Play" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                    <ui:FANavigationViewItem Content="账户" Tag="AccountPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Contact" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                    <ui:FANavigationViewItem Content="下载中心" Tag="DownloadHubPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Download" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                    <ui:FANavigationViewItem Content="下载任务" Tag="DownloadCenterPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Clock" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                    <ui:FANavigationViewItem Content="多人" Tag="MultiplayerPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="People" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                </ui:FANavigationView.MenuItems>

                <ui:FANavigationView.FooterMenuItems>
                    <ui:FANavigationViewItem Content="设置" Tag="SettingsPage">
                        <ui:FANavigationViewItem.IconSource>
                            <ui:FASymbolIconSource Symbol="Setting" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                </ui:FANavigationView.FooterMenuItems>
            </ui:FANavigationView>

            <!--
                轻提示宿主：右下角，位于导航内容之上。

                ⚠️ 必须是 StackPanel 而不是 Panel：Panel 会把所有子元素叠在**同一个位置**，
                两条通知同时存在时文字直接重影（1.0.10.6 用户实测截图）。
                StackPanel 才会真正纵向堆叠。
            -->
            <StackPanel x:Name="SnackbarHost"
                        Grid.Row="1"
                        Margin="0,0,24,24"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        ZIndex="100" />

            <!--
                ==================== 首次使用向导层 ====================

                向导以前是一个独立的 890×556 窗口（主窗口 Hide 掉再弹出来）。现在改成
                主窗口内的一整层：盖住标题栏行与侧栏，**占据整个程序**，
                只保留自己的一条标题栏（拖窗 / 最小化 / 关闭仍在）。

                为什么是覆盖层而不是主界面的一个页面：
                ① 向导要抢占整屏，而 FANavigationView 的内容区永远在侧栏右边；
                ② 走完向导要「原地」变成启动页，覆盖层淡出比换窗口干净得多。

                层序：侧栏 / 内容(0) < 本层(90) < 轻提示(100) < 拖放遮罩(200) < 内嵌浮层(400)。
                轻提示留在上面是有意的 —— 向导里登录成功等提示要能被看到。
            -->
            <Grid x:Name="WelcomeLayer"
                  Grid.RowSpan="2"
                  ZIndex="90"
                  RowDefinitions="Auto,*"
                  IsVisible="False"
                  Opacity="1"
                  Background="{DynamicResource SurfaceCanvasBrush}">

                <Grid.Transitions>
                    <Transitions>
                        <!-- 走完向导时整层淡出（150ms Exit），露出下面已经就位的启动页 -->
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="{StaticResource EaseExit}" />
                    </Transitions>
                </Grid.Transitions>

                <ctrl:TitleBar Grid.Row="0"
                               Height="44"
                               Title="首次使用向导"
                               Icon="/Assets/icon.ico" />

                <ContentControl x:Name="WelcomePageHost" Grid.Row="1" />
            </Grid>

        </Grid>

        <!--
            拖入整合包时的整窗提示层：平时完全隐藏且不挡鼠标。

            出现 / 消失走 150ms 透明度过渡（1.0.29.0）：拖放状态是"连续"的，
            遮罩如果硬切会像闪屏；淡入淡出让"可以松手了"这个信号更清楚。
            IsVisible 仍由代码切换 —— 淡出播完才真正隐藏，否则动画会被直接掐断。
        -->
        <Border x:Name="DropOverlay"
                Background="{DynamicResource AppDropOverlayBrush}"
                IsHitTestVisible="False"
                IsVisible="False"
                Opacity="0"
                ZIndex="200">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="{StaticResource EaseEnter}" />
                </Transitions>
            </Border.Transitions>
            <Border Margin="28"
                    Padding="40"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource AppDropPanelBrush}"
                    BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource RadiusL}"
                    BoxShadow="0 24 60 0 #40000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <ui:FASymbolIcon HorizontalAlignment="Center"
                                     FontSize="{StaticResource IconSizeHero}"
                                     Symbol="Download" />
                    <TextBlock x:Name="DropOverlayTitle"
                               HorizontalAlignment="Center"
                               Classes="subtitle"
                               FontWeight="SemiBold"
                               Text="松开即可安装整合包" />
                    <TextBlock x:Name="DropOverlayHint"
                               HorizontalAlignment="Center"
                               Classes="caption"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="支持 Modrinth (.mrpack) 与 CurseForge (.zip) 整合包" />
                </StackPanel>
            </Border>
        </Border>
        <!--
            内嵌子页宿主（1.0.8.2 起：窗口原样嵌进来，不做任何改装）。

            遮罩 + 卡片的结构在 InlineHostOverlay 里，放在**整窗最上层**：
            首次使用向导占据整个窗口时，账户页弹出的「微软 / 外置 / 离线」子页
            也要压在向导之上；以前向导是独立窗口，各自挂一个浮层，
            现在同一个窗口里只留一个 —— 否则 InlineHost 会挑到被盖住的那个，
            表现为「点了没反应」。
        -->
        <ctrl:InlineHostOverlay x:Name="InlineOverlay" ZIndex="400" />
    </Grid>
</Window>
