<Window
    x:Class="VibrantbitLauncher.Views.Windows.WelcomeWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="Vibrantbit Launcher"
    Width="890"
    Height="556"
    CanResize="False"
    WindowStartupLocation="CenterScreen"
    FontFamily="{DynamicResource AppFont}"
    FontSize="{DynamicResource FontSizeBody}"
    mc:Ignorable="d"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <!--
        底色用本工程自己的 ApplicationBackgroundBrush（AppTheme.axaml 定义 + ApplyTheme 按主题覆写），
        窗口层与根 Grid 层都写一遍：窗口层负责窗口自身，根 Grid 层保证切主题后立刻重绘。
        注意别用 FluentAvalonia 的 SolidBackgroundFillColorBase —— 那是 Color 资源，
        赋给 IBrush 类型的 Background 会静默失效，等于没有背景。
    -->
    <Grid x:Name="RootGrid"
          RowDefinitions="Auto,*"
          RenderTransformOrigin="50%,50%"
          Background="{DynamicResource ApplicationBackgroundBrush}">

        <!--
            首次打开的第一眼：纯画布。
            与主窗口同一套材质 —— 用户点「完成」时看到的不是"换了个软件"，
            而是同一片底色上的下一页。
        -->
        <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceCanvasBrush}" />

        <ctrl:TitleBar Grid.Row="0"
                       Height="44"
                       Title="首次使用向导"
                       Icon="/Assets/icon.ico" />

        <ContentControl x:Name="PageHost" Grid.Row="1" />

        <!--
            向导里也要能弹出内嵌子页（微软 / 外置 / 离线账户）。
            此前这些子页只会画进主窗口内容区，而向导期间主窗口是隐藏的，
            于是三个账户按钮看起来「点了没反应」。与主窗口共用同一个浮层控件。
        -->
        <ctrl:InlineHostOverlay x:Name="InlineOverlay" Grid.Row="1" ZIndex="150" />
    </Grid>
</Window>
