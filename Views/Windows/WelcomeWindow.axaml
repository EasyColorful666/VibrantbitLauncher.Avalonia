<Window
    x:Class="VibrantbitLauncher.Views.Windows.WelcomeWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="Vibrantbit Launcher"
    Width="960"
    Height="600"
    CanResize="False"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    mc:Ignorable="d"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <!--
        底色用本工程自己的 ApplicationBackgroundBrush（AppTheme.axaml 定义 + ApplyTheme 按主题覆写），
        窗口层与根 Grid 层都写一遍：窗口层负责窗口自身，根 Grid 层保证切主题后立刻重绘。
        注意别用 FluentAvalonia 的 SolidBackgroundFillColorBase —— 那是 Color 资源，
        赋给 IBrush 类型的 Background 会静默失效，等于没有背景。
    -->
    <Grid x:Name="RootGrid"
          RowDefinitions="Auto,*"
          RenderTransformOrigin="50%,50%"
          Background="{DynamicResource ApplicationBackgroundBrush}">
        <ctrl:TitleBar Grid.Row="0"
                       Height="36"
                       Title="首次使用向导"
                       Icon="/Assets/icon.ico" />

        <ContentControl x:Name="PageHost" Grid.Row="1" />
    </Grid>
</Window>
