<UserControl
    x:Class="VibrantbitLauncher.Views.Windows.LicenseWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    FontFamily="{DynamicResource AppFont}"
    FontSize="{DynamicResource FontSizeBody}"
    mc:Ignorable="d"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Width="574"
    Height="500">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource ApplicationBackgroundBrush}">
        <ctrl:TitleBar
            Grid.Row="0"
            Height="36"
            Title="开源许可"
            Icon="/Assets/icon.ico"
            IsInline="True" />

        <StackPanel Grid.Row="1" Margin="24,6,24,0">
            <TextBlock Classes="title" Text="GNU Affero 通用公共许可证" />
            <TextBlock
                Margin="0,6,0,0"
                Classes="caption"
                TextWrapping="Wrap"
                Text="第 3 版，2007 年 11 月 19 日 · 本启动器以 AGPL-3.0 开源：可以自由使用、修改、分发，修改后的版本也必须以同样的协议开放源代码。" />
        </StackPanel>

        <!--  协议全文：只读、可选中复制  -->
        <Border Grid.Row="2"
                Margin="24,12,24,0"
                Padding="14,12"
                Classes="card">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock x:Name="licenseText"
                                     Classes="body"
                                     TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3"
              Margin="24,12,24,20"
              ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Click="OpenOnline_Click"
                    Content="在线查看" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Click="OpenSource_Click" Content="获取源代码" />
                <Button Classes="accent"
                        Click="Close_Click"
                        Content="关闭" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
