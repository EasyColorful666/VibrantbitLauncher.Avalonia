<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Views.Pages.DownloadPage"
             d:DesignWidth="800"
             d:DesignHeight="450">

    <Grid Margin="0,16,0,8" RowDefinitions="Auto,*">

        <!--  搜索框：与下载中心其它页面保持一致的现代化样式（图标 + 占位文案）  -->
        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
            <TextBox x:Name="textBox"
                     Grid.Column="0"
                     Height="36"
                     VerticalContentAlignment="Center"
                     PlaceholderText="搜索游戏版本"
                     TextChanged="TextBox_TextChanged" />

            <!--  右侧计数 / 提示  -->
            <TextBlock x:Name="countText"
                       Grid.Column="1"
                       Classes="caption"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="共 0 个版本" />
        </Grid>

        <Grid Grid.Row="1">
            <ListBox x:Name="listBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!--  整行可点击：点了直接进安装页（不再需要右侧「下载」按钮）  -->
                        <Border Classes="card" Padding="14,12" Cursor="Hand"
                                PointerReleased="OnVersionCardClick">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <!--  版本图标：圆角容器 + 马赛克块  -->
                                <Border Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource RadiusM}">
                                    <Image Width="36" Height="36"
                                           Source="avares://VibrantbitLauncher.Avalonia/Assets/Grass_Block.png" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="subtitle" Text="{Binding Version}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Classes="caption" Margin="0,3,0,0" Text="{Binding Date}" />
                                </StackPanel>

                                <!--  右侧仅作视觉提示：进入箭头  -->
                                <ui:FASymbolIcon Grid.Column="2" Margin="12,0,0,0"
                                                 VerticalAlignment="Center"
                                                 FontSize="16"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 Symbol="Forward" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  空状态：搜索无结果时显示  -->
            <TextBlock x:Name="emptyText"
                       Classes="secondary"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       IsVisible="False"
                       Text="没有匹配的版本，换个关键词试试" />
        </Grid>
    </Grid>
</UserControl>
