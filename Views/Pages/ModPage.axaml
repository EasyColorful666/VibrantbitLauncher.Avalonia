<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Views.Pages.ModPage"
             d:DesignWidth="800"
             d:DesignHeight="450">

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*">

        <!--
            标题行：左侧返回 + 右侧两行标题。
            本页是从「下载中心 → 资源分类」点进来的下钻页（见
            DownloadResourcesPage 里的 AppNavigation.Navigate(typeof(ModPage))），
            没有返回按钮就只能靠左侧导航跳走，等于丢掉来路。
        -->
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center"
                    Classes="subtle"
                    ToolTip.Tip="返回上一页"
                    Click="OnBack">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Back" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="headerTitle" Classes="display" Text="模组文件" />
                <TextBlock x:Name="headerSubtitle" Classes="caption" Margin="0,4,0,0"
                           Text="选择游戏版本与加载器，查看可下载的模组文件；只有加载器匹配的实例才能直接添加" />
            </StackPanel>
        </Grid>

        <!--  筛选栏  -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12" Spacing="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Classes="body" VerticalAlignment="Center" Text="游戏版本" />
                <ComboBox x:Name="comboBox" Width="160" Margin="8,0,24,0" VerticalAlignment="Center" />

                <TextBlock x:Name="loaderLabel" Classes="body" VerticalAlignment="Center" Text="模组加载器" />
                <ComboBox x:Name="comboBox1" Width="160" Margin="8,0,0,0" VerticalAlignment="Center"
                          SelectionChanged="comboBox1_SelectionChanged">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="Fabric" />
                    <ComboBoxItem Content="Forge" />
                    <ComboBoxItem Content="NeoForge" />
                    <ComboBoxItem Content="Quilt" />
                </ComboBox>
            </StackPanel>

            <!--
                目标实例：只有本地装了至少一个可添加的实例时才显示。
                一个实例都没有时整行隐藏，列表里也只剩「另存为」，不给出会落空的入口。
                右侧提示文案会随所选实例的加载器、以及「版本隔离」设置实时变化：
                例如「Fabric · 版本隔离：开 → .minecraft/versions/1.21.4_fabric_0.16.5/mods」。
            -->
            <StackPanel x:Name="instancePanel" Orientation="Horizontal" IsVisible="False">
                <TextBlock Classes="body" VerticalAlignment="Center" Text="目标实例" />
                <ComboBox x:Name="instanceComboBox" Width="220" Margin="8,0,16,0" VerticalAlignment="Center"
                          SelectionChanged="instanceComboBox_SelectionChanged" />
                <TextBlock x:Name="instanceHintText" Classes="caption" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <ListBox x:Name="listBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,6" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Classes="subtitle"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <!--  模组才显示：这个文件需要哪个加载器（没有加载器的实例装不上）  -->
                                    <TextBlock Classes="caption" Margin="0,3,0,0"
                                               IsVisible="{Binding ShowLoaderHint}"
                                               Text="{Binding LoaderHint}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <!--
                                        这个文件支持哪些游戏版本。
                                        版本多时只列前几个（否则卡片会被撑成两屏），完整清单在悬停提示里。
                                    -->
                                    <TextBlock Classes="caption" Margin="0,3,0,0"
                                               IsVisible="{Binding ShowVersionHint}"
                                               Text="{Binding VersionHint}"
                                               ToolTip.Tip="{Binding VersionTooltip}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <!--
                                        整合包专用：直接新建一个实例把包装进去（含基础版本 + 加载器 + 模组）。
                                        整合包不能「添加到实例」（那是往已有实例塞东西），所以这里走独立入口。
                                    -->
                                    <Button Click="OnInstallModpackClick"
                                            IsVisible="{Binding ShowInstallModpackButton}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:FASymbolIcon Symbol="Download" />
                                            <TextBlock Text="安装整合包" />
                                        </StackPanel>
                                    </Button>
                                    <!--
                                        选中的实例加载器匹配时才出现；没有实例、或实例加载器对不上
                                        （Forge 模组配 Fabric 实例、原版实例等）时只保留「另存为」
                                    -->
                                    <Button Click="OnAddToInstanceClick"
                                            IsVisible="{Binding ShowInstanceButton}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:FASymbolIcon Symbol="Add" />
                                            <TextBlock Text="添加到实例" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnSaveAsClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:FASymbolIcon Symbol="Save" />
                                            <TextBlock Text="另存为" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  加载中提示  -->
            <TextBlock x:Name="loadingText"
                       Classes="secondary"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="False"
                       Text="正在加载模组文件..." />
        </Grid>
    </Grid>
</UserControl>
