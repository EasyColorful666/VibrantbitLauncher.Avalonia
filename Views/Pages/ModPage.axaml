<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Views.Pages.ModPage"
             d:DesignWidth="800"
             d:DesignHeight="450">

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*">

        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Classes="display" Text="模组文件" />
            <TextBlock Classes="caption" Margin="0,6,0,0"
                       Text="选择游戏版本与加载器，查看可下载的模组文件" />
        </StackPanel>

        <!--  筛选栏  -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal">
            <TextBlock Classes="body" VerticalAlignment="Center" Text="游戏版本" />
            <ComboBox x:Name="comboBox" Width="160" Margin="8,0,24,0" VerticalAlignment="Center" />

            <TextBlock Classes="body" VerticalAlignment="Center" Text="模组加载器" />
            <ComboBox x:Name="comboBox1" Width="160" Margin="8,0,0,0" VerticalAlignment="Center"
                      SelectionChanged="comboBox1_SelectionChanged">
                <ComboBoxItem />
                <ComboBoxItem Content="Fabric" />
                <ComboBoxItem Content="Forge" />
                <ComboBoxItem Content="NeoForge" />
                <ComboBoxItem Content="Quilt" />
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="2">
            <ListBox x:Name="listBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,6" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="subtitle" Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Click="OnSaveAsClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:FASymbolIcon Symbol="Save" />
                                        <TextBlock Text="另存为" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  加载中提示  -->
            <TextBlock x:Name="loadingText"
                       Classes="secondary"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="False"
                       Text="正在加载模组文件..." />
        </Grid>
    </Grid>
</UserControl>
