<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:VibrantbitLauncher.Helpers"
             xmlns:vm="using:VibrantbitLauncher.ViewModels.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Views.Pages.WelcomeSetupPage"
             d:DesignWidth="960"
             d:DesignHeight="600">

    <UserControl.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </UserControl.Resources>

    <!--  开机向导第 2 步：确认游戏目录、Java 与主题  -->
    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Classes="display" Text="快速设置" />
            <TextBlock Classes="caption"
                       Margin="0,6,0,0"
                       Text="确认游戏目录和 Java 运行环境，之后随时能在「设置」里修改" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!--  游戏目录  -->
                <TextBlock Classes="sectionTitle" Text="游戏目录" />
                <TextBlock Classes="caption" Margin="0,6,0,0"
                           Text="版本、存档和模组都会放在这个目录下" />
                <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" IsReadOnly="True"
                             Text="{Binding MinecraftFolder, Mode=OneWay}"
                             ToolTip.Tip="{Binding MinecraftFolder}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="16,0"
                            Click="OnSelectFolder" Content="选择" />
                </Grid>

                <!--  Java  -->
                <TextBlock Classes="sectionTitle" Margin="0,24,0,0" Text="Java 运行环境" />
                <TextBlock Classes="caption" Margin="0,6,0,0"
                           Text="没有自动检测到 Java 时，可以手动指定 java.exe" />
                <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding JavaEntries}"
                              SelectedItem="{Binding SelectedJava, Mode=TwoWay}"
                              ToolTip.Tip="{Binding SelectedJava.JavaPath}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding JavaVersion}" VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0" Text="-" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding JavaPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="16,0"
                            Click="OnBrowseJava" Content="浏览" />
                </Grid>

                <!--  主题  -->
                <TextBlock Classes="sectionTitle" Margin="0,24,0,0" Text="主题" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="16">
                    <RadioButton GroupName="wizardTheme"
                                 Content="亮色"
                                 Command="{Binding ChangeThemeCommand}"
                                 CommandParameter="theme_light"
                                 IsChecked="{Binding CurrentTheme,
                                                     Converter={StaticResource EnumToBooleanConverter},
                                                     ConverterParameter=Light,
                                                     Mode=OneWay}" />
                    <RadioButton GroupName="wizardTheme"
                                 Content="暗色"
                                 Command="{Binding ChangeThemeCommand}"
                                 CommandParameter="theme_dark"
                                 IsChecked="{Binding CurrentTheme,
                                                     Converter={StaticResource EnumToBooleanConverter},
                                                     ConverterParameter=Dark,
                                                     Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,20,0,0"
                    HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Padding="24,10" Click="OnBack" Content="上一步" />
            <Button Padding="24,10" Classes="accent" Click="OnNext">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="下一步" />
                    <ui:FASymbolIcon Symbol="Forward" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
