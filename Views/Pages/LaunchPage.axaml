<UserControl
    x:Class="VibrantbitLauncher.Views.Pages.LaunchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource PagePadding}" ColumnDefinitions="*,340">

        <!--  ==================== 左：选版本 + 启动  ====================  -->
        <Grid
            Grid.Column="0"
            Margin="0,0,24,0"
            RowDefinitions="Auto,*,Auto">

            <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
                <TextBlock Classes="display" Text="启动" />
                <Border Margin="0,10,0,0" Classes="accentRule" />
                <TextBlock
                    Margin="0,6,0,0"
                    Classes="caption"
                    Text="选中一个版本后点击启动；版本列表来自游戏目录" />
            </StackPanel>

            <Grid Grid.Row="1">
                <!--  版本列表  -->
                <ListBox
                    x:Name="listBox"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding MinecraftVersions}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,10" Classes="card">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Image
                                        Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        Margin="0,0,14,0"
                                        Source="avares://VibrantbitLauncher.Avalonia/Assets/Grass_Block.png" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Classes="subtitle"
                                        Text="{Binding Version}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Command="{Binding SettingsCommand}"
                                        CommandParameter="{Binding Version}"
                                        Content="设置" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  空状态：游戏目录里还没有版本  -->
                <StackPanel
                    x:Name="versionEmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource AppDisplayFont}"
                        FontSize="44"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="&#xE7B8;" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Classes="subtitle"
                        Text="还没有可用的游戏版本" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Classes="caption"
                        Text="到「下载中心」安装一个版本后就能启动了" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Margin="0,16,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Padding="32,12"
                    Classes="accent"
                    Click="OnLaunchClick"
                    Content="启动游戏" />
                <Button
                    Padding="20,12"
                    Click="OnVersionSettingsClick"
                    Content="版本设置" />
                <Button
                    Padding="20,12"
                    Command="{Binding RefreshCommand}"
                    Content="刷新" />
            </StackPanel>
        </Grid>

        <!--  ==================== 右：官方新闻  ====================  -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,12"
                Classes="sectionTitle"
                Text="官方新闻" />

            <ScrollViewer
                Grid.Row="1"
                Padding="0,0,8,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!--  数据上下文由 code-behind 挂成 DashboardPageViewModel（新闻源）  -->
                <!--  ItemsSource 由 code-behind 直接赋（新闻源 VM 与页面 VM 不是同一个），
                      写成 {Binding News} 的话 InitializeComponent 时会先按「启动」VM 求值一次并报绑定告警  -->
                <ItemsControl x:Name="NewsHost">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  图片铺满卡片，底部渐变承托白色标题；悬停弹性放大  -->
                            <Border
                                Height="168"
                                Margin="0,0,0,10"
                                Cursor="Hand"
                                Classes="hoverCard"
                                ClipToBounds="True"
                                PointerReleased="OnNewsItemPointerReleased">
                                <Grid>
                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />

                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,32%" EndPoint="0%,100%">
                                                <GradientStop Offset="0" Color="#00000000" />
                                                <GradientStop Offset="1" Color="#E6000000" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel Margin="14,0,14,12" VerticalAlignment="Bottom">
                                        <TextBlock
                                            MaxHeight="46"
                                            FontFamily="{StaticResource AppFont}"
                                            FontSize="{StaticResource FontSizeBodyLarge}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AppOnImageTextBrush}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Classes="caption"
                                            Foreground="{StaticResource AppOnImageTextBrush}"
                                            Opacity="0.75"
                                            Text="{Binding Date}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
