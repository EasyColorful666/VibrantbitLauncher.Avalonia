<UserControl
    x:Class="VibrantbitLauncher.Views.Pages.LaunchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!--
            快捷设置里的「分段胶囊」。
            用 RadioButton 而不是两个 Button：语义上它本来就是二选一，
            键盘方向键 / 屏幕阅读器都能正确识别，视觉上则被模板去掉圆点改成胶囊。

            选中态用主色填充，整个页面里主色只在这一处出现 ——
            主色面积控制在 3% 以内，启动按钮才是真正的强调色主角。
        -->
        <Style Selector="RadioButton.segment">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="SegmentRoot"
                        Padding="14,4"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="{StaticResource RadiusPill}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.segment:pointerover /template/ Border#SegmentRoot">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
        </Style>

        <!--
            胶囊底色 / 描边的过渡：150ms 在 50ms 时长网格上，属「反馈」档，
            比页面的 250ms 转场快一档 —— 手指在按钮上，反馈必须先到。
        -->
        <Style Selector="RadioButton.segment /template/ Border#SegmentRoot">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition
                        Property="Background"
                        Duration="0:0:0.15"
                        Easing="CubicEaseOut" />
                    <BrushTransition
                        Property="BorderBrush"
                        Duration="0:0:0.15"
                        Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector=".performanceMode RadioButton.segment /template/ Border#SegmentRoot">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>

        <Style Selector="RadioButton.segment:pressed /template/ Border#SegmentRoot">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="RadioButton.segment:checked /template/ Border#SegmentRoot">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="RadioButton.segment:checked:pressed /template/ Border#SegmentRoot">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="RadioButton.segment:focus-visible /template/ Border#SegmentRoot">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="RadioButton.segment:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!--
            版本行：默认无底色，悬停浮起一层细边。
            ListBoxItem 的选中底色由数据模板里的卡片承担，
            所以这里把 ListBoxItem 自身的内边距清零，避免"两层框"。
        -->
        <Style Selector="ListBox#versionList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid Classes="page" ColumnDefinitions="*,356">

        <!--  ==================== 左：选版本 + 启动  ====================  -->
        <Grid
            Grid.Column="0"
            Margin="0,0,32,0"
            RowDefinitions="Auto,Auto,*,Auto">

            <ctrl:PageHeader
                Grid.Row="0"
                Eyebrow="LIBRARY"
                Subtitle="选中一个版本后点右侧的主按钮；版本列表来自游戏目录"
                Title="启动" />

            <TextBlock
                Grid.Row="1"
                Margin="4,0,0,14"
                Classes="subtitle"
                IsVisible="{Binding ShowGreeting}"
                Text="{Binding GreetingText}" />

            <Grid Grid.Row="2" IsVisible="{Binding ShowLaunchCard}">
                <!--  版本列表  -->
                <ListBox
                    x:Name="listBox"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding MinecraftVersions}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12" Classes="card">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">

                                    <!--
                                        图标块：主色 12% 底 + 方块图标。
                                        这里用"底 + 图"而不是直接放图，是为了让每行左侧
                                        有一条对齐的视觉轴 —— 列表读起来才有节奏。
                                    -->
                                    <Border
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,14,0"
                                        Background="{DynamicResource AppAccentSurfaceBrush}"
                                        CornerRadius="{StaticResource RadiusM}">
                                        <Image
                                            Width="24"
                                            Height="24"
                                            RenderOptions.BitmapInterpolationMode="HighQuality"
                                            Source="avares://VibrantbitLauncher.Avalonia/Assets/Grass_Block.png" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="subtitle" Text="{Binding Version}" />
                                        <TextBlock Classes="caption" Text="Minecraft · 点击右侧按钮管理这个实例" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        Command="{Binding ToolsCommand}"
                                        CommandParameter="{Binding Version}"
                                        Content="工具箱" />

                                    <Button
                                        Grid.Column="3"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        Command="{Binding SettingsCommand}"
                                        CommandParameter="{Binding Version}"
                                        Content="设置" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  空状态：游戏目录里还没有版本（有版本时由 code-behind 整体隐藏）  -->
                <StackPanel
                    x:Name="versionEmptyState"
                    MaxWidth="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <Border
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        Background="{DynamicResource AppAccentSurfaceBrush}"
                        CornerRadius="{StaticResource RadiusL}">
                        <ui:FASymbolIcon
                            x:Name="emptyIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource IconSizeDisplay}"
                            Foreground="{DynamicResource AppAccentBrush}"
                            Symbol="Folder" />
                    </Border>
                    <TextBlock
                        x:Name="emptyTitle"
                        HorizontalAlignment="Center"
                        Classes="subtitle"
                        FontWeight="SemiBold"
                        Text="还没有可用的游戏版本" />
                    <TextBlock
                        x:Name="emptyHint"
                        HorizontalAlignment="Center"
                        Classes="caption"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Text="到「下载中心」安装一个版本，或用配装码一键添加" />
                    <Button
                        x:Name="emptyLoadoutButton"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Classes="accent"
                        Click="OnLoadoutCodeClick"
                        Content="用配装码添加游戏" />
                </StackPanel>
            </Grid>

            <!--  ==================== 底部：全页唯一的主角  ====================
                 启动按钮是这一屏唯一的"重"元素：圆角方形（12px，和卡片同族）、
                 抬高一档的高度、背后一圈会呼吸的光晕。其他所有按钮都退成文字按钮。

                 光晕用 Border + 径向渐变而不是 BoxShadow：
                 阴影只有一种颜色和一个模糊半径，做不出"从中心亮到边缘消失"的感觉。
            -->
            <Grid
                Grid.Row="3"
                Margin="0,20,0,0"
                ColumnDefinitions="Auto,*,Auto"
                IsVisible="{Binding ShowLaunchCard}">

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Border
                        Margin="-30,-24"
                        Background="{DynamicResource AppAccentHaloBrush}"
                        Classes="halo"
                        CornerRadius="{StaticResource RadiusPill}"
                        IsHitTestVisible="False" />

                    <Button
                        Height="52"
                        Padding="34,0"
                        Classes="accent"
                        CornerRadius="{StaticResource RadiusL}"
                        Click="OnLaunchClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ui:FASymbolIcon
                                FontSize="{StaticResource IconSizeBody}"
                                Symbol="Play" />
                            <TextBlock
                                FontSize="{DynamicResource FontSizeSubtitle}"
                                FontWeight="SemiBold"
                                Text="启动游戏" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button Classes="subtle" Click="OnVersionSettingsClick" Content="版本设置" />
                    <Button Classes="subtle" Click="OnLoadoutCodeClick" Content="配装码" />
                    <Button Classes="subtle" Command="{Binding RefreshCommand}" Content="刷新" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  ==================== 右：快捷设置  ====================
            一整块玻璃面板 + 两条 1px 分割线，而不是"三张等宽卡片"——
            三块等大的框会把视线摊平，也让右侧抢走左侧主角的位置。
        -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <TextBlock
                Grid.Row="0"
                Margin="2,0,0,12"
                Classes="sectionTitle"
                Text="快捷设置" />

            <ScrollViewer
                Grid.Row="1"
                Padding="0,0,4,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!--  ── 最近游玩 ──  -->
                    <Border Classes="card" Margin="0,0,0,12" Padding="16,14" IsVisible="{Binding ShowRecent}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="最近游玩" />
                            <ItemsControl ItemsSource="{Binding RecentInstances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="subtle"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding Command}"
                                                CommandParameter="{Binding Id}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Id}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Classes="caption"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding TimeText}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="caption"
                                       Opacity="0.7"
                                       Text="按版本目录的修改时间排序"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  ── 实例概览 ──  -->
                    <Border Classes="card" Margin="0,0,0,12" Padding="16,14" IsVisible="{Binding ShowInstanceOverview}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="sectionTitle" Text="实例概览" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Classes="number" FontSize="{DynamicResource FontSizeTitle}" Text="{Binding InstanceCountText}" />
                                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding InstanceSizeText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ── 快捷入口 ──  -->
                    <Border Classes="card" Margin="0,0,0,12" Padding="16,14" IsVisible="{Binding ShowShortcuts}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="快捷入口" />
                            <Button Classes="accent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding OpenModDownloadCommand}"
                                    Content="装模组" />
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding OpenModpackDownloadCommand}"
                                    Content="装整合包" />
                        </StackPanel>
                    </Border>

                <Border Classes="glass" ClipToBounds="True">
                    <StackPanel>

                        <!--  ── 显示游戏卡片 ──  -->
                        <Grid Margin="16,15" ColumnDefinitions="Auto,*,Auto">
                            <ui:FASymbolIcon
                                Grid.Column="0"
                                Margin="0,2,12,0"
                                VerticalAlignment="Top"
                                FontSize="{StaticResource IconSizeBody}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Play" />

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="body" Text="显示游戏卡片" />
                                <TextBlock Classes="caption" Text="关掉后只留右侧的模块" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowLaunchCard, Mode=TwoWay}" />
                        </Grid>

                        <!--  ── Minecraft 文件夹 ──  -->
                        <Grid Margin="16,15" ColumnDefinitions="Auto,*,Auto">
                            <ui:FASymbolIcon
                                Grid.Column="0"
                                Margin="0,2,12,0"
                                VerticalAlignment="Top"
                                FontSize="{StaticResource IconSizeBody}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Folder" />

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="body" Text="Minecraft 文件夹" />
                                <TextBlock
                                    x:Name="quickMcFolderText"
                                    Classes="caption"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Classes="subtle"
                                Click="OnQuickMcFolderClick"
                                Content="更改" />
                        </Grid>

                        <Border
                            Height="1"
                            Margin="40,0,16,0"
                            Background="{DynamicResource HairlineBrush}" />

                        <!--  ── Java 运行环境 ──  -->
                        <StackPanel Margin="16,15" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <ui:FASymbolIcon
                                    Grid.Column="0"
                                    Margin="0,2,12,0"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource IconSizeBody}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Symbol="Code" />

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="body" Text="Java 运行环境" />
                                    <TextBlock
                                        x:Name="quickJavaText"
                                        Classes="caption"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="28,0,0,0" ColumnDefinitions="*,Auto">
                                <ComboBox
                                    x:Name="quickJavaCombo"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="未检测到 Java"
                                    SelectionChanged="OnQuickJavaSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding JavaVersion}" />
                                                <TextBlock
                                                    Classes="caption"
                                                    Text="{Binding JavaPath}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="subtle"
                                    Click="OnQuickJavaBrowseClick"
                                    Content="浏览" />
                            </Grid>
                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="40,0,16,0"
                            Background="{DynamicResource HairlineBrush}" />

                        <!--  ── 外观：分段胶囊 ──  -->
                        <Grid Margin="16,15" ColumnDefinitions="Auto,*,Auto">
                            <ui:FASymbolIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource IconSizeBody}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Setting" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Classes="body"
                                Text="外观" />

                            <Border
                                Grid.Column="2"
                                Padding="2"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource RadiusPill}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        x:Name="quickThemeLight"
                                        Classes="segment"
                                        Content="亮色"
                                        GroupName="QuickTheme" />
                                    <RadioButton
                                        x:Name="quickThemeDark"
                                        Classes="segment"
                                        Content="暗色"
                                        GroupName="QuickTheme" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
