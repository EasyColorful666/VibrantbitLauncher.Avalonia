<UserControl
    x:Class="VibrantbitLauncher.Views.Pages.LaunchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:ctrl="using:VibrantbitLauncher.Controls"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!--
            「分段胶囊」：外观二选一。

            用 RadioButton 而不是两个 Button：语义上它本来就是二选一，
            键盘方向键 / 屏幕阅读器都能正确识别，视觉上被模板去掉圆点改成胶囊。
        -->
        <Style Selector="RadioButton.segment">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="SegmentRoot"
                        Padding="12,4"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusPill}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.segment:pointerover /template/ Border#SegmentRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        </Style>

        <!--  选中态：白底 + 细边，不用强调色 —— 外观切换是"位置"不是"操作"  -->
        <Style Selector="RadioButton.segment:checked /template/ Border#SegmentRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
        </Style>

        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="RadioButton.segment:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!--
            版本行：不再是"每行一张卡"，而是同一张卡里的一行。
            每行都描边会让十个版本变成十个框，屏幕上全是线 ——
            新语言里列表靠 hover 底色和行距区分，不靠框。
        -->
        <Style Selector="ListBox#versionList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid Classes="page" ColumnDefinitions="*,308">

        <!--  ==================== 左：选版本 + 启动  ====================  -->
        <Grid
            Grid.Column="0"
            Margin="0,0,28,0"
            RowDefinitions="Auto,Auto,*,Auto">

            <ctrl:PageHeader
                Grid.Row="0"
                Subtitle="选中一个版本后点右下角的主按钮；版本列表来自游戏目录"
                Title="启动">
                <ctrl:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="subtle" Command="{Binding RefreshCommand}" Content="刷新" />
                    </StackPanel>
                </ctrl:PageHeader.Actions>
            </ctrl:PageHeader>

            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,14"
                Classes="body"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                IsVisible="{Binding ShowGreeting}"
                Text="{Binding GreetingText}" />

            <Grid Grid.Row="2" IsVisible="{Binding ShowLaunchCard}">
                <!--  版本列表：一整张卡片，行与行之间只有留白  -->
                <Border Padding="6" Classes="card" VerticalAlignment="Top">
                    <ListBox
                        x:Name="listBox"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding MinecraftVersions}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1" ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Border
                                        Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        Margin="10,0,12,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AppAccentSurfaceBrush}"
                                        CornerRadius="{DynamicResource RadiusS}">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            RenderOptions.BitmapInterpolationMode="HighQuality"
                                            Source="avares://VibrantbitLauncher.Avalonia/Assets/Grass_Block.png" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="0,10"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Version}" />
                                        <TextBlock Classes="caption" Text="Minecraft · 点击右侧按钮管理这个实例" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        Command="{Binding ToolsCommand}"
                                        CommandParameter="{Binding Version}"
                                        Content="工具箱" />

                                    <Button
                                        Grid.Column="3"
                                        Margin="2,0,4,0"
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        Command="{Binding SettingsCommand}"
                                        CommandParameter="{Binding Version}"
                                        Content="设置" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!--  空状态：游戏目录里还没有版本（有版本时由 code-behind 整体隐藏）  -->
                <StackPanel
                    x:Name="versionEmptyState"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <Border
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,6"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="{DynamicResource RadiusL}">
                        <ui:FASymbolIcon
                            x:Name="emptyIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource IconSizeLarge}"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="Folder" />
                    </Border>
                    <TextBlock
                        x:Name="emptyTitle"
                        HorizontalAlignment="Center"
                        Classes="subtitle"
                        FontWeight="SemiBold"
                        Text="还没有可用的游戏版本" />
                    <TextBlock
                        x:Name="emptyHint"
                        HorizontalAlignment="Center"
                        Classes="caption"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Text="到「下载中心」安装一个版本，或用配装码一键添加" />
                    <Button
                        x:Name="emptyLoadoutButton"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Classes="accent"
                        Click="OnLoadoutCodeClick"
                        Content="用配装码添加游戏" />
                </StackPanel>
            </Grid>

            <!--  ==================== 底部：主操作  ====================
                 启动按钮是全页唯一的实心色块。没有光晕、没有渐变 ——
                 明亮清爽里的"主角"靠对比度（实心蓝 vs 一片白）而不是靠装饰。

                 布局：主按钮贴左，次要操作贴右。中间的大段留白本身就是分隔，
                 不需要再加竖线或分组框。
            -->
            <Grid
                Grid.Row="3"
                Margin="0,20,0,0"
                ColumnDefinitions="Auto,*,Auto"
                IsVisible="{Binding ShowLaunchCard}">

                <Button
                    Grid.Column="0"
                    Height="46"
                    Padding="30,0"
                    Classes="accent"
                    CornerRadius="{DynamicResource RadiusM}"
                    Click="OnLaunchClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <ui:FASymbolIcon FontSize="{StaticResource IconSizeBody}" Symbol="Play" />
                        <TextBlock
                            FontSize="{DynamicResource FontSizeSubtitle}"
                            FontWeight="SemiBold"
                            Text="启动游戏" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button Classes="subtle" Click="OnVersionSettingsClick" Content="版本设置" />
                    <Button Classes="subtle" Click="OnLoadoutCodeClick" Content="配装码" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  ==================== 右：快捷设置  ====================
            一整张卡片，内部用 1px 分割线分组。
            以前是"三张等宽卡片 + 一块玻璃面板"，四五个框并排会把视线摊平；
            现在收成一张，视线只走一条竖线。
        -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,12"
                Classes="sectionTitle"
                Text="快捷设置" />

            <ScrollViewer
                Grid.Row="1"
                Padding="0,0,4,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!--  ── 显示游戏卡片 ──  -->
                    <Border Padding="16,14" Classes="card">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="body" Text="显示游戏卡片" />
                                <TextBlock Classes="caption" Text="关掉后只留右侧的模块" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowLaunchCard, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!--  ── 最近游玩 ──  -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="16,14"
                        Classes="card"
                        IsVisible="{Binding ShowRecent}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="sectionTitle" Text="最近游玩" />
                            <ItemsControl ItemsSource="{Binding RecentInstances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Padding="8,6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Classes="subtle"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding Id}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Id}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Classes="caption"
                                                    Text="{Binding TimeText}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  ── Minecraft 文件夹 / Java / 外观 ──  -->
                    <Border Margin="0,10,0,0" Classes="card">
                        <StackPanel>

                            <!--  Minecraft 文件夹  -->
                            <Grid Margin="16,14" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Classes="body" Text="Minecraft 文件夹" />
                                    <TextBlock
                                        x:Name="quickMcFolderText"
                                        Classes="caption"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="subtle"
                                    Click="OnQuickMcFolderClick"
                                    Content="更改" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource HairlineBrush}" />

                            <!--  Java 运行环境  -->
                            <StackPanel Margin="16,14" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Classes="body" Text="Java 运行环境" />
                                        <TextBlock
                                            x:Name="quickJavaText"
                                            Classes="caption"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox
                                        x:Name="quickJavaCombo"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="未检测到 Java"
                                        SelectionChanged="OnQuickJavaSelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding JavaVersion}" />
                                                    <TextBlock
                                                        Classes="caption"
                                                        Text="{Binding JavaPath}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        Click="OnQuickJavaBrowseClick"
                                        Content="浏览" />
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource HairlineBrush}" />

                            <!--  外观：分段胶囊  -->
                            <Grid Margin="16,14" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Classes="body"
                                    Text="外观" />

                                <Border
                                    Grid.Column="1"
                                    Padding="2"
                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                    CornerRadius="{DynamicResource RadiusPill}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            x:Name="quickThemeLight"
                                            Classes="segment"
                                            Content="亮色"
                                            GroupName="QuickTheme" />
                                        <RadioButton
                                            x:Name="quickThemeDark"
                                            Classes="segment"
                                            Content="暗色"
                                            GroupName="QuickTheme" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!--  ── 实例概览 ──  -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="16,14"
                        Classes="card"
                        IsVisible="{Binding ShowInstanceOverview}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionTitle" Text="实例概览" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    Classes="number"
                                    FontSize="{DynamicResource FontSizeTitle}"
                                    Text="{Binding InstanceCountText}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="caption"
                                    Text="{Binding InstanceSizeText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ── 快捷入口 ──  -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="16,14"
                        Classes="card"
                        IsVisible="{Binding ShowShortcuts}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="快捷入口" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding OpenModDownloadCommand}"
                                    Content="装模组" />
                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding OpenModpackDownloadCommand}"
                                    Content="装整合包" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
