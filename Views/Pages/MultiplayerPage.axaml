<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"

             xmlns:ctrl="using:VibrantbitLauncher.Controls"
             xmlns:vm="using:VibrantbitLauncher.ViewModels.Pages"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Views.Pages.MultiplayerPage"
             x:DataType="vm:MultiplayerPageViewModel"
             d:DesignWidth="900"
             d:DesignHeight="640">

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">

        <!--  ===== 页头 =====  -->
        <ctrl:PageHeader Grid.Row="0" Title="多人联机" Subtitle="由 EasyTier 组一张虚拟局域网：房主在游戏里「对局域网开放」，房客用虚拟 IP 直连。联机码与陶瓦联机是同一套算法，勾上兼容模式后两边还能进同一个房间。" />

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <!--
                限宽 880 是为了长文案的阅读宽度，但**必须 Left**：
                MaxWidth + Stretch 会让 Avalonia 把它在更宽的内容区里居中，
                正文就会比上面的页头整体右移一截。
            -->
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                <!--  ===== ① 联机服务 =====  -->
                <Border Padding="18" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="联机服务" />
                        <TextBlock Margin="0,6,0,0"
                                   Classes="caption"
                                   Text="不勾兼容模式时走本项目自己的直连服务器，房主与房客填同一个地址才碰得到一起；主节点不可达时会自动改用同批公共节点。填 https:// 开头的接口地址时，启动前会先访问它换取当前真正的服务器地址。"
                                   TextWrapping="Wrap" />

                        <!--  缺少核心时的引导  -->
                        <Border Margin="0,14,0,0" Padding="12,10"
                                IsVisible="{Binding IsCoreMissing}"
                                Background="{DynamicResource AppCautionSurfaceBrush}"
                                CornerRadius="{DynamicResource RadiusM}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:FASymbolIcon VerticalAlignment="Center"
                                                     FontSize="{StaticResource IconSizeBody}"
                                                     Foreground="{DynamicResource AppCautionBrush}"
                                                     Symbol="Alert" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Classes="body"
                                               Text="没有找到 EasyTier 核心程序，需要先下载一次（约 10 MB）。"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="accent"
                                        Command="{Binding DownloadCoreCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:FASymbolIcon Symbol="Download" />
                                        <TextBlock Text="下载核心" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!--  缺少管理员权限时的提示  -->
                        <Border Margin="0,14,0,0" Padding="12,10"
                                IsVisible="{Binding NeedsElevation}"
                                Background="{DynamicResource AppCautionSurfaceBrush}"
                                CornerRadius="{DynamicResource RadiusM}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:FASymbolIcon VerticalAlignment="Center"
                                                     FontSize="{StaticResource IconSizeBody}"
                                                     Foreground="{DynamicResource AppCautionBrush}"
                                                     Symbol="ContactInfo" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Classes="body"
                                               Text="当前未以管理员身份运行。EasyTier 需要管理员权限创建虚拟网卡，否则无法拿到虚拟 IP。"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="accent"
                                        Command="{Binding RestartElevatedCommand}"
                                        Content="以管理员身份重启" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Classes="body"
                                       Text="中继服务器" />
                            <TextBox Grid.Column="1" VerticalAlignment="Center"
                                     IsEnabled="{Binding CanEditRelay}"
                                     PlaceholderText="tcp://easytier.weiai.org.cn:11010"
                                     Text="{Binding RelayServer, Mode=TwoWay}"
                                     ToolTip.Tip="可以直接填 tcp:// 开头的服务器地址；填 https:// 开头的接口地址时，启动前会先访问它换取当前真正的服务器地址" />
                            <Button Grid.Column="2" MinWidth="112" Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="accent"
                                    Command="{Binding StartServiceCommand}"
                                    IsEnabled="{Binding CanStartService}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:FASymbolIcon Symbol="Play" />
                                    <TextBlock Text="启动服务" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" MinWidth="112" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding StopServiceCommand}"
                                    IsEnabled="{Binding CanStopService}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:FASymbolIcon Symbol="Stop" />
                                    <TextBlock Text="停止服务" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--
                            陶瓦联机兼容模式：勾上就换用陶瓦的节点池。
                            联机码本来就是同一套算法，节点对上之后用陶瓦客户端的玩家才进得来；
                            不勾则走本项目自己的节点，两边都是本启动器时更快，也不受第三方接口影响。
                        -->
                        <CheckBox Margin="0,12,0,0"
                                  IsChecked="{Binding IsTerracottaCompat, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditKey}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="陶瓦联机兼容模式" />
                                <TextBlock Classes="caption"
                                           Text="勾选后改用陶瓦联机的服务器，可以和用陶瓦客户端的玩家进同一张网；不勾则用本项目自己的服务器。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <!--  接口解析出来的真实服务器地址（连不上时先看这一行）  -->
                        <TextBlock Margin="0,8,0,0"
                                   Classes="caption"
                                   IsVisible="{Binding HasRelayEndpointText}"
                                   Text="{Binding RelayEndpointText}"
                                   TextWrapping="Wrap" />

                        <!--  状态行  -->
                        <Grid Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto">
                            <Ellipse x:Name="statusDot" Grid.Column="0"
                                     Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource SystemFillColorCriticalBrush}" />

                            <TextBlock Grid.Column="1" Margin="10,0,12,0"
                                       VerticalAlignment="Center"
                                       Classes="body"
                                       Text="{Binding StatusText}"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        IsVisible="{Binding HasLocalIp}">
                                <TextBlock VerticalAlignment="Center"
                                           Classes="body"
                                           Text="{Binding LocalVirtualIp, StringFormat='我的虚拟 IP：{0}'}" />
                                <Button Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CopyTextCommand}"
                                        CommandParameter="{Binding LocalVirtualIp}"
                                        ToolTip.Tip="复制我的虚拟 IP">
                                    <ui:FASymbolIcon Symbol="Copy" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  退出后是否保留联机内核  -->
                        <ToggleSwitch Margin="0,16,0,0"
                                      IsChecked="{Binding KeepAliveOnExit, Mode=TwoWay}"
                                      OnContent="退出启动器后联机继续运行"
                                      OffContent="退出启动器时断开联机"
                                      ToolTip.Tip="开启后可以直接关掉启动器（或收进系统托盘），虚拟网络会保留，房客不会掉线；下次打开启动器会自动接管这个会话。" />
                    </StackPanel>
                </Border>

                <!--  ===== ② 身份与联机码 =====  -->
                <Border Margin="0,12,0,0" Padding="18" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="选择身份" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <RadioButton Content="我要当房主"
                                         GroupName="MultiplayerMode"
                                         IsChecked="{Binding IsHostMode, Mode=TwoWay}"
                                         IsEnabled="{Binding CanSwitchRole}"
                                         ToolTip.Tip="联机服务运行期间不能切换身份，先点「停止服务」" />
                            <RadioButton Margin="24,0,0,0"
                                         Content="我要当房客"
                                         GroupName="MultiplayerMode"
                                         IsChecked="{Binding IsGuestMode, Mode=TwoWay}"
                                         IsEnabled="{Binding CanSwitchRole}"
                                         ToolTip.Tip="联机服务运行期间不能切换身份，先点「停止服务」" />
                        </StackPanel>

                        <!--  房主  -->
                        <StackPanel IsVisible="{Binding IsHostMode}">
                            <TextBlock Margin="0,16,0,0"
                                       Classes="caption"
                                       Text="联机码里存着这个房间的虚拟网络名和密码。把「联机码 + 你的虚拟 IP」一起发给好友，他们填进来就能进同一个网络。这串码与陶瓦联机的码通用，两边互相都认。"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Classes="body"
                                           Text="联机码" />
                                <TextBox Grid.Column="1" VerticalAlignment="Center"
                                         IsEnabled="{Binding CanEditKey}"
                                         PlaceholderText="自动生成，比如 U/ABCD-EFGH-JKLM-NPQR"
                                         Text="{Binding HostKey, Mode=TwoWay}" />
                                <Button Grid.Column="2" Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding RegenerateKeyCommand}"
                                        IsEnabled="{Binding CanRegenerateKey}"
                                        Content="重新生成" />
                                <Button Grid.Column="3" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="accent"
                                        Command="{Binding CopyTextCommand}"
                                        CommandParameter="{Binding HostKey}"
                                        Content="复制联机码" />
                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       Classes="secondary"
                                       Text="启动服务后，进游戏按 Esc → 对局域网开放，好友就能通过虚拟 IP 连进你的世界。"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  房客  -->
                        <StackPanel IsVisible="{Binding !IsHostMode}">
                            <TextBlock Margin="0,16,0,0"
                                       Classes="caption"
                                       Text="把房主给你的联机码填进来（整句粘过来也行，会自动认出 U/ 开头的那一段），启动服务后你们就处在同一个虚拟局域网里。"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Classes="body"
                                           Text="联机码" />
                                <TextBox Grid.Column="1" VerticalAlignment="Center"
                                         IsEnabled="{Binding CanEditKey}"
                                         PlaceholderText="粘贴房主给你的联机码"
                                         Text="{Binding GuestKey, Mode=TwoWay}" />
                                <Button Grid.Column="2" Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding PasteGuestKeyCommand}"
                                        IsEnabled="{Binding CanEditKey}"
                                        Content="粘贴" />
                            </Grid>

                            <!--  房主已出现时，直接把连接地址摆出来  -->
                            <Border Margin="0,14,0,0" Padding="12,10"
                                    IsVisible="{Binding HasRemotePeer}"
                                    Background="{DynamicResource AppSuccessSurfaceBrush}"
                                    CornerRadius="{DynamicResource RadiusM}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="body"
                                                   Text="{Binding RemotePeerIp, StringFormat='房主的虚拟 IP：{0}'}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Classes="caption"
                                                   Text="在游戏里进入「多人游戏 → 直接连接」，把这个地址粘进去即可。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Classes="accent"
                                            Command="{Binding CopyTextCommand}"
                                            CommandParameter="{Binding RemotePeerIp}"
                                            Content="复制地址" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,14,0,0"
                                       Classes="secondary"
                                       Text="如果列表里还没看到房主，多等十几秒；组网完成后「网络成员」里就会出现对方的虚拟 IP。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ===== ③ 局域网联机模组 =====  -->
                <Border Margin="0,12,0,0" Padding="18" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="局域网联机模组" />
                        <TextBlock Margin="0,6,0,0"
                                   Classes="caption"
                                   Text="原版「对局域网开放」会强制正版验证，离线账户会被直接踢掉 —— 这也是组网成功后仍然连不进来的原因。这里装的是 LAN World Plug-n-Play（mcwifipnp）：它给开房界面加上「正版验证」三档开关、端口修改和 UPnP 映射，Fabric / Quilt / Forge / NeoForge 都支持。"
                                   TextWrapping="Wrap" />

                        <!--  一个实例都没有时的引导  -->
                        <Border Margin="0,14,0,0" Padding="12,10"
                                IsVisible="{Binding HasNoInstances}"
                                Background="{DynamicResource AppCautionSurfaceBrush}"
                                CornerRadius="{DynamicResource RadiusM}">
                            <TextBlock Classes="body"
                                       Text="还没有安装任何 Minecraft 实例，请先在「下载」页装一个带加载器的版本（Fabric / Forge / NeoForge）。"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!--  实例选择 + 一键安装  -->
                        <Grid Margin="0,14,0,0"
                              ColumnDefinitions="Auto,*,Auto"
                              IsVisible="{Binding HasInstances}">
                            <TextBlock Grid.Column="0" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Classes="body"
                                       Text="目标实例" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding Instances}"
                                      SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" MinWidth="118" Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="accent"
                                    Command="{Binding InstallLanModCommand}"
                                    IsEnabled="{Binding CanInstallLanMod}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:FASymbolIcon Symbol="Download" />
                                    <TextBlock Text="{Binding LanModButtonText}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--  状态行  -->
                        <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*">
                            <Ellipse x:Name="lanModDot" Grid.Column="0"
                                     Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Classes="body"
                                       Text="{Binding LanModStatusText}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Margin="0,8,0,0"
                                   Classes="caption"
                                   Text="{Binding LanModDetailText}"
                                   TextWrapping="Wrap" />

                        <!--  装完之后的用法说明（这个模组改的是开房界面，必须讲清怎么点）  -->
                        <Border Margin="0,12,0,0" Padding="12,10"
                                IsVisible="{Binding HasLanModGuide}"
                                Background="{DynamicResource AppSuccessSurfaceBrush}"
                                CornerRadius="{DynamicResource RadiusM}">
                            <StackPanel>
                                <TextBlock Classes="body"
                                           Text="怎么用"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Classes="body"
                                           Text="{Binding LanModGuide}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ===== ④ 网络成员 =====  -->
                <Border Margin="0,12,0,0" Padding="18" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="网络成员" />
                        <TextBlock Margin="0,6,0,0"
                                   Classes="caption"
                                   Text="同一个联机码下的所有设备。每三秒自动刷新一次。"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,12,0,0"
                                   Classes="secondary"
                                   IsVisible="{Binding HasNoPeers}"
                                   Text="还没读到的成员信息。启动服务并完成组网后，这里会列出本机和好友的虚拟 IP。"
                                   TextWrapping="Wrap" />

                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Peers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="12,8"
                                            Background="{DynamicResource SurfaceCanvasSubtleBrush}"
                                            CornerRadius="{DynamicResource RadiusM}">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       Classes="body"
                                                       Text="{Binding NameText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" MinWidth="120" Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       Classes="body"
                                                       Text="{Binding IpText}" />
                                            <TextBlock Grid.Column="2" MinWidth="80" Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       Classes="caption"
                                                       Text="{Binding LinkText}" />
                                            <TextBlock Grid.Column="3" MinWidth="64" Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       Classes="caption"
                                                       Text="{Binding LatencyText}" />
                                            <Button Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].DataContext.CopyTextCommand}"
                                                    CommandParameter="{Binding Ipv4}"
                                                    Content="复制 IP" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,14,0,8"
                           Classes="caption"
                           Text="提示：房主和房客都点「启动服务」后，双方各拿到一个 10 开头的虚拟 IP；房主在游戏里开放局域网，房客用房主的虚拟 IP 直连即可。若连不上，先确认防火墙没有拦截 EasyTier。"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
