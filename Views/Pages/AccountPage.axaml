<UserControl
    x:Class="VibrantbitLauncher.Views.Pages.AccountPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DesignHeight="620"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!--
        账户页 · design intent
        ─────────────────────────────────────────────────────────────
        row[ content(1fr) | gap 24 | aside(288) ]
        content = grid[ hero(Auto) | section(Auto) | list(*) ]

        ① 焦点  当前身份卡（唯一 26 号字 + 唯一渐变环）；其余全部降一档成行式
        ② 层级  34 页标题 / 26 身份名 / 17 区块 / 14 行标题 / 12 辅助
        ③ 对齐  图标块 34 ↔ 按钮 padding 12；头像与名字首行对基线
        ④ 间距  组内 8 / 组间 24 / 卡片 20 / 行 10；无 3·5·7·14 随手值
        ⑤ 中性  走 FluentAvalonia 语义键（明暗自动），不写裸色值
        ⑥ 深度  L0 页面 / L1 面板与行（1px 内描边）/ 仅悬停时一层浅影
        ⑦ 内容  真实账户名 / 类型 / 使用状态；空状态给下一步
        ⑧ 强调  实心主色 0 处；彩色只剩渐变环 + 12% 浅底，面积 < 3%
        ⑨ 交互  hover 120ms 抬 1px、press 90ms 压 0.99、入场 200ms stagger 40
    -->

    <UserControl.Styles>

        <!--  ==================== Hero：当前身份  ====================  -->

        <Style Selector="Border.heroCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
        </Style>

        <!--  渐变洗底：7% 的主色斜向铺在卡片上，是「贵」的来源，不是装饰  -->
        <Style Selector="Border.heroWash">
            <Setter Property="Background" Value="{DynamicResource AppAccentGradientBrush}" />
            <Setter Property="Opacity" Value="0.07" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.heroName">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!--  类型胶囊：中性底 + 次色字，绝不用主色（主色预算留给渐变环）  -->
        <Style Selector="Border.typeChip">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.typeChip TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!--  幽灵按钮：换肤这类次级动作，描边 + 主色字，悬停只加深一点点  -->
        <Style Selector="Button.ghost">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="Button.ghost:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
        </Style>

        <!--  未选身份时的引导态：同样的尺寸、更轻的语气，不抢焦点  -->
        <Style Selector="Border.heroEmpty">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
        </Style>

        <!--  ==================== 账户列表  ====================  -->

        <!--  一组行装在同一张卡里：这是「列表组」，不是一排等宽卡片  -->
        <Style Selector="Border.groupCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
        </Style>

        <Style Selector="Border.accountRow">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.accountRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>

        <!--  使用中：浅底 + 边框，比「实心主色」克制一档  -->
        <Style Selector="Border.accountRow.selected">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>

        <Style Selector="TextBlock.rowName">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  选中环：只有使用中的账户头像带渐变描边，一眼区分  -->
        <Style Selector="Ellipse.rowRing">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Stroke" Value="{DynamicResource AppAccentGradientBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.accountRow.selected Ellipse.rowRing">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!--  「使用中」小圆点  -->
        <Style Selector="Ellipse.inUseDot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!--  行操作：文字型 / 图标型 / 切换，三种重量递进  -->
        <Style Selector="Button.rowGhost">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="Button.rowGhost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="Button.rowIcon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
        </Style>

        <Style Selector="Button.rowIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCriticalSurfaceBrush}" />
        </Style>

        <Style Selector="Button.rowIcon ui|FASymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="Button.rowIcon:pointerover ui|FASymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
        </Style>

        <Style Selector="Button.rowSwitch">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.rowSwitch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style Selector="Button.rowSwitch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceStrongBrush}" />
        </Style>

        <Style Selector="Button.rowSwitch:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
        </Style>

        <Style Selector="Button.rowGhost:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
        </Style>

        <Style Selector="Button.rowIcon:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
        </Style>

        <!--  ListBox 只借它的「容器」能力跑入场动画，选中态完全由 VM 的 IsSelected 表达，
              所以这里把内置的 hover / selected 底色全部抹掉。  -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
        </Style>

        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  键盘走到这一行时，用行边框亮起主色，替代 Fluent 默认的整块高亮  -->
        <Style Selector="ListBoxItem:focus-visible Border.accountRow">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <!--  ==================== 右栏：添加身份  ====================  -->

        <Style Selector="Border.actionsPanel">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
        </Style>

        <Style Selector="Button.addIdentity">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!--  键盘焦点：1px 主色环 + 12% 浅底，不改 BorderThickness，避免文字跳动  -->
        <Style Selector="Button.addIdentity:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style Selector="Button.addIdentity:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="Button.addIdentity:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <!--  图标块：中性浅底 + 次色图标；悬停才借一点点主色，不常驻彩色  -->
        <Style Selector="Border.identityTile">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.identityTile ui|FASymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="Button.addIdentity:pointerover Border.identityTile">
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentSurfaceStrongBrush}" />
        </Style>

        <Style Selector="Button.addIdentity:pointerover Border.identityTile ui|FASymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style Selector="TextBlock.identityTitle">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="Border.chevron">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.addIdentity:pointerover Border.chevron">
            <Setter Property="RenderTransform" Value="translateX(2px)" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!--  ==================== 空状态  ====================  -->

        <Style Selector="Border.emptyHalo">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="80" />
            <Setter Property="CornerRadius" Value="40" />
            <Setter Property="Background" Value="{DynamicResource AppAccentGradientBrush}" />
            <Setter Property="Opacity" Value="0.12" />
        </Style>

        <!--  ==================== 性能模式：全部动效关掉  ====================  -->

        <Style Selector=".performanceMode Border.chevron">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>

        <Style Selector=".performanceMode Button.addIdentity:pointerover Border.chevron">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
        </Style>

        <Style Selector=".performanceMode Border.accountRow">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>

        <Style Selector=".performanceMode Ellipse.rowRing">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>

    </UserControl.Styles>

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">

        <!--  ==================== 页头  ====================  -->
        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Classes="display" Text="账户" />
            <Border Margin="0,10,0,0" Classes="accentRule" />
            <TextBlock
                Margin="0,8,0,0"
                Classes="caption"
                Text="管理启动游戏时使用的身份：微软正版、外置验证服务器，或一个离线名字" />
        </StackPanel>

        <!--  ==================== 主体  ====================  -->
        <Grid Grid.Row="1" ColumnDefinitions="*,24,288">

            <!--  左：当前身份 + 账户列表  -->
            <Grid Grid.Column="0">

                <!--  空状态：一个账户都没有时，整块换成引导  -->
                <StackPanel
                    x:Name="emptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !HasUsers}">
                    <Panel HorizontalAlignment="Center">
                        <Border Classes="emptyHalo" />
                        <ui:FASymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="32"
                            Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                            Symbol="Contact" />
                    </Panel>
                    <TextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Classes="subtitle"
                        FontWeight="SemiBold"
                        Text="还没有添加账户" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Classes="caption"
                        Text="从右侧选一种登录方式，添加后即可启动游戏" />
                </StackPanel>

                <!--  有账户时的正常内容  -->
                <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasUsers}">

                    <!--  Hero：当前身份  -->
                    <Grid Grid.Row="0" x:Name="heroBlock">

                        <Border Classes="heroCard" IsVisible="{Binding HasCurrentUser}">
                            <Panel>
                                <Border Classes="heroWash" />

                                <Grid
                                    Margin="20"
                                    ColumnDefinitions="Auto,*,Auto">

                                    <!--  头像 + 渐变环  -->
                                    <Panel
                                        Grid.Column="0"
                                        Width="92"
                                        Height="92"
                                        VerticalAlignment="Center">
                                        <Ellipse
                                            Width="88"
                                            Height="88"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stroke="{DynamicResource AppAccentGradientBrush}"
                                            StrokeThickness="2" />
                                        <Image
                                            Width="80"
                                            Height="80"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{Binding CurrentUser.ImagePath, Converter={StaticResource SkinPathToImage}}"
                                            Stretch="Uniform">
                                            <Image.Clip>
                                                <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40" />
                                            </Image.Clip>
                                        </Image>
                                    </Panel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="18,0,16,0"
                                        VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Classes="eyebrow" Text="当前身份" />
                                        </StackPanel>

                                        <TextBlock
                                            Classes="heroName"
                                            Text="{Binding CurrentUser.Name}"
                                            ToolTip.Tip="{Binding CurrentUser.Name}" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="typeChip">
                                                <TextBlock Text="{Binding CurrentUser.TypeDisplay}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="caption"
                                                Text="启动游戏时使用这个身份" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        Classes="ghost"
                                        Command="{Binding CurrentUser.SkinCommand}"
                                        CommandParameter="{Binding CurrentUser.Account}"
                                        Content="更换皮肤" />
                                </Grid>
                            </Panel>
                        </Border>

                        <!--  有账户但还没选身份  -->
                        <Border Classes="heroEmpty" Padding="20" IsVisible="{Binding !HasCurrentUser}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Panel
                                    Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        Width="48"
                                        Height="48"
                                        Fill="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        Stroke="{DynamicResource CardStrokeColorDefaultBrush}"
                                        StrokeThickness="1" />
                                    <ui:FASymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Symbol="Contact" />
                                </Panel>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Classes="subtitle" FontWeight="SemiBold" Text="尚未选择启动身份" />
                                    <TextBlock Classes="caption" Text="在下方账户里点「切换」，右侧还可以再添加一个" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  区块标题：与列表同组，所以只留 8 的间隙  -->
                    <Grid
                        Grid.Row="1"
                        Margin="0,24,0,8"
                        ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="sectionTitle" Text="全部账户" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="caption"
                            Text="{Binding AccountCountText}" />
                    </Grid>

                    <!--  账户列表：一整组行，不是一排卡片  -->
                    <Border Grid.Row="2" Classes="groupCard" Padding="6">
                        <ListBox
                            x:Name="listbox1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Users}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="accountRow" Classes.selected="{Binding IsSelected}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">

                                            <Panel
                                                Grid.Column="0"
                                                Width="44"
                                                Height="44"
                                                VerticalAlignment="Center">
                                                <Ellipse Classes="rowRing" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image
                                                    Width="40"
                                                    Height="40"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{Binding ImagePath, Converter={StaticResource SkinPathToImage}}"
                                                    Stretch="Uniform">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                                    </Image.Clip>
                                                </Image>
                                            </Panel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,12,0"
                                                VerticalAlignment="Center" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="0">
                                                    <Ellipse Classes="inUseDot" IsVisible="{Binding IsSelected}" />
                                                    <TextBlock Classes="rowName" Text="{Binding Name}" />
                                                </StackPanel>
                                                <TextBlock Classes="caption" Text="{Binding TypeDisplay}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">

                                                <Button
                                                    Classes="rowGhost"
                                                    Command="{Binding SkinCommand}"
                                                    CommandParameter="{Binding Account}"
                                                    Content="换肤" />
                                                <Button
                                                    Classes="rowIcon"
                                                    Command="{Binding DeleteCommand}"
                                                    CommandParameter="{Binding Account}"
                                                    ToolTip.Tip="从列表中移除这个账户">
                                                    <ui:FASymbolIcon FontSize="13" Symbol="Delete" />
                                                </Button>

                                                <Button
                                                    Classes="rowSwitch"
                                                    Command="{Binding SelectedCommand}"
                                                    CommandParameter="{Binding Account}"
                                                    Content="切换"
                                                    IsVisible="{Binding !IsSelected}" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="caption"
                                                    Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                    IsVisible="{Binding IsSelected}"
                                                    Text="使用中" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <!--  右：添加身份  -->
            <Border
                x:Name="asidePanel"
                Grid.Column="2"
                VerticalAlignment="Top"
                Classes="actionsPanel">
                <StackPanel>

                    <TextBlock Classes="sectionTitle" Text="添加身份" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Classes="caption"
                        Text="选择一种登录方式"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,16,0,0" Spacing="4">

                        <Button
                            Classes="addIdentity"
                            Command="{Binding AuthenticateMicrosoftCommand}"
                            ToolTip.Tip="使用微软账号正版登录">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="identityTile">
                                    <ui:FASymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Symbol="Cloud" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Classes="identityTitle" Text="微软账户" />
                                    <TextBlock Classes="caption" Text="正版登录 · 需联网" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="chevron" VerticalAlignment="Center">
                                    <ui:FASymbolIcon FontSize="11" Symbol="ChevronRight" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button
                            Classes="addIdentity"
                            Command="{Binding AuthenticateYggdrasilCommand}"
                            ToolTip.Tip="连接第三方 Yggdrasil 验证服务器">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="identityTile">
                                    <ui:FASymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Symbol="Globe" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Classes="identityTitle" Text="外置账户" />
                                    <TextBlock Classes="caption" Text="第三方验证服务器" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="chevron" VerticalAlignment="Center">
                                    <ui:FASymbolIcon FontSize="11" Symbol="ChevronRight" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button
                            Classes="addIdentity"
                            Command="{Binding AuthenticateOfflineCommand}"
                            ToolTip.Tip="不联网，只在本机用一个名字">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="identityTile">
                                    <ui:FASymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Symbol="Contact" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Classes="identityTitle" Text="离线账户" />
                                    <TextBlock Classes="caption" Text="无需联网" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="chevron" VerticalAlignment="Center">
                                    <ui:FASymbolIcon FontSize="11" Symbol="ChevronRight" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,16,0,12"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <TextBlock
                        Classes="caption"
                        Text="账户凭据只保存在本机；正版登录由微软官方服务完成，启动器不接触密码。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
