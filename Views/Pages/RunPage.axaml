<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Views.Pages.RunPage"
             d:DesignWidth="800"
             d:DesignHeight="450">

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">

        <!--  页面标题区：标题 + 右侧操作  -->
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="display" Text="运行" />
                <TextBlock Classes="caption" Margin="0,6,0,0"
                           Text="选择已安装的版本直接启动游戏" />
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:FASymbolIcon Symbol="Refresh" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <ListBox x:Name="listBox"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding MinecraftVersions}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Image Grid.Column="0" Width="48" Height="48" Margin="0,0,12,0"
                               Source="avares://VibrantbitLauncher.Avalonia/Assets/Grass_Block.png" />

                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Classes="subtitle"
                                   Text="{Binding Version}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

                        <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RunCommand}"
                                CommandParameter="{Binding Version}"
                                Content="运行" />
                        <!--
                            工具箱：依赖体检（查缺依赖 / 重复模组）与配装分享码（导出 / 导入）。
                            放在每个版本一行，因为这两件事都以「某个实例」为主语。
                        -->
                        <Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ToolsCommand}"
                                CommandParameter="{Binding Version}"
                                Content="工具箱" />
                        <Button Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding SettingsCommand}"
                                CommandParameter="{Binding Version}"
                                Content="设置" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
