<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ctrl="using:VibrantbitLauncher.Controls"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Views.Pages.RunPage"
             d:DesignWidth="800"
             d:DesignHeight="450">

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">

        <!--  页面标题区：标题 + 右侧操作  -->
        <ctrl:PageHeader Grid.Row="0" Subtitle="选择已安装的版本直接启动游戏" Title="运行">
            <ctrl:PageHeader.Actions>
                <Button Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ui:FASymbolIcon Symbol="Refresh" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </ctrl:PageHeader.Actions>
        </ctrl:PageHeader>

        <!--  版本列表：一整张卡片，行与行之间只有留白（与启动页同一套列表语言）  -->
        <Border Grid.Row="1" Padding="6" Classes="card" VerticalAlignment="Top">
        <ListBox x:Name="listBox"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding MinecraftVersions}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Border
                            Grid.Column="0"
                            Width="34"
                            Height="34"
                            Margin="10,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppAccentSurfaceBrush}"
                            CornerRadius="{DynamicResource RadiusS}">
                            <Image
                                Width="20"
                                Height="20"
                                RenderOptions.BitmapInterpolationMode="HighQuality"
                                Source="avares://VibrantbitLauncher.Avalonia/Assets/Grass_Block.png" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,10"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Version}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="Minecraft · 点击「运行」直接启动" />
                        </StackPanel>

                        <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                Classes="accent"
                                Command="{Binding RunCommand}"
                                CommandParameter="{Binding Version}"
                                Content="运行" />
                        <!--
                            工具箱：依赖体检（查缺依赖 / 重复模组）与配装分享码（导出 / 导入）。
                            放在每个版本一行，因为这两件事都以「某个实例」为主语。
                        -->
                        <Button Grid.Column="3" Margin="4,0,0,0" VerticalAlignment="Center"
                                Classes="subtle"
                                Command="{Binding ToolsCommand}"
                                CommandParameter="{Binding Version}"
                                Content="工具箱" />
                        <Button Grid.Column="4" Margin="2,0,4,0" VerticalAlignment="Center"
                                Classes="subtle"
                                Command="{Binding SettingsCommand}"
                                CommandParameter="{Binding Version}"
                                Content="设置" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Border>
    </Grid>
</UserControl>
