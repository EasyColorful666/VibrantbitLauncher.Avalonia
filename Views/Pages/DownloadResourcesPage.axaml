<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             x:Class="VibrantbitLauncher.Views.Pages.DownloadResourcesPage"
             d:DesignWidth="820"
             d:DesignHeight="700">

    <Grid Margin="0,0,0,8" RowDefinitions="Auto,Auto,*">

        <!--  顶部：大搜索框 + 搜索按钮  -->
        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="36"
                     VerticalContentAlignment="Center"
                     PlaceholderText="搜索模组"
                     Text="{Binding SearchText, Mode=TwoWay}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>

            <Button Grid.Column="1" Width="72" Height="36" Margin="8,0,0,0"
                    Command="{Binding SearchCommand}"
                    Content="搜索" />
        </Grid>

        <!--  筛选区：两行，外面套一张卡片  -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,12" Padding="16,12">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

                <!--  第一行  -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="body"
                           Margin="0,0,8,0" VerticalAlignment="Center" Text="来源" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="128" Margin="0,0,20,0"
                          ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}" />

                <TextBlock Grid.Row="0" Grid.Column="2" Classes="body"
                           Margin="0,0,8,0" VerticalAlignment="Center" Text="标签" />
                <ComboBox Grid.Row="0" Grid.Column="3" Width="128" Margin="0,0,20,0"
                          ItemsSource="{Binding Tags}"
                          SelectedItem="{Binding SelectedTag, Mode=TwoWay}" />

                <TextBlock Grid.Row="0" Grid.Column="4" Classes="body"
                           Margin="0,0,8,0" VerticalAlignment="Center" Text="排序方式" />
                <ComboBox Grid.Row="0" Grid.Column="5" Width="128" Margin="0,0,20,0"
                          ItemsSource="{Binding Sorts}"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />

                <Button Grid.Row="0" Grid.Column="6" Width="34" Height="34"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="刷新">
                    <ui:FASymbolIcon Symbol="Refresh" />
                </Button>

                <!--  第二行  -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="body"
                           Margin="0,12,8,0" VerticalAlignment="Center" Text="版本" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="128" Margin="0,12,20,0"
                          ItemsSource="{Binding MinecraftVersions}"
                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Grid.Column="2" Classes="body"
                           Margin="0,12,8,0" VerticalAlignment="Center" Text="加载器" />
                <ComboBox Grid.Row="1" Grid.Column="3" Width="128" Margin="0,12,20,0"
                          ItemsSource="{Binding Loaders}"
                          SelectedItem="{Binding SelectedLoader, Mode=TwoWay}" />

                <!--  「已加载 N / 共 M 条」  -->
                <TextBlock Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="4"
                           Classes="caption" Margin="0,12,0,0" VerticalAlignment="Center"
                           Text="{Binding CountText}" />
            </Grid>
        </Border>

        <!--  资源列表  -->
        <Grid Grid.Row="2">
            <ListBox x:Name="listBox"
                     Classes="smoothScroll"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding ModrinthMods}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Padding="14,12" Cursor="Hand"
                                DoubleTapped="OnCardDoubleTapped">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <!--  项目图标  -->
                                <Border Grid.Column="0" Width="56" Height="56" Margin="0,0,14,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource RadiusM}">
                                    <Image Width="48" Height="48" Source="{Binding Icon}" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <!--  名称 + 作者  -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="subtitle" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Classes="caption" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding Author}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!--  描述  -->
                                    <TextBlock Classes="secondary" MaxHeight="36" Margin="0,4,0,0"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />

                                    <!--  标签行 + 下载量 + 时间  -->
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Border Padding="8,2" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusS}">
                                            <TextBlock Classes="caption" Text="{Binding Tags}" />
                                        </Border>

                                        <ui:FASymbolIcon Margin="12,0,0,0" VerticalAlignment="Center"
                                                         FontSize="14" Symbol="Download" />
                                        <TextBlock Classes="caption" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding Downloads}" />
                                        <TextBlock Classes="caption" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding UpdatedText}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  来源  -->
                                <TextBlock Grid.Column="2" Classes="caption" Margin="12,2,0,0"
                                           VerticalAlignment="Top" Text="{Binding Source}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  加载中  -->
            <TextBlock x:Name="loadingText"
                       Classes="secondary"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       IsVisible="False"
                       Text="正在加载..." />

            <!--  列表底部：滚动到这里会自动追加下一页  -->
            <StackPanel x:Name="loadMorePanel"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,10"
                        IsHitTestVisible="False"
                        IsVisible="False"
                        Orientation="Horizontal">
                <ui:FASymbolIcon VerticalAlignment="Center" FontSize="16" Symbol="Refresh" />
                <TextBlock Classes="caption" Margin="8,0,0,0" Text="正在加载更多…" />
            </StackPanel>

            <!--  空状态  -->
            <TextBlock x:Name="emptyText"
                       Classes="secondary"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       IsVisible="False"
                       Text="没有匹配的资源，换个关键词或筛选条件试试" />
        </Grid>
    </Grid>
</UserControl>
